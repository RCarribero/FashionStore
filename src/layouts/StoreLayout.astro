---
/**
 * Store Layout - Nike/JD/Adidas Inspired Design
 * Modern sportswear aesthetic with animated promo banner
 */
import BaseLayout from "../../../shared/layouts/BaseLayout.astro";
import CartSlideOver, { CartTrigger } from "../components/CartSlideOver";
import UserButton from "../components/UserButton";
import NewsletterForm from "../components/NewsletterForm";
import { ROUTES, STORE_NAV } from "../../../config";

interface Props {
    title: string;
    description?: string;
}

const { title, description } = Astro.props;
const currentPath = Astro.url.pathname;
---

<BaseLayout title={title} description={description}>
    <div class="min-h-screen flex flex-col bg-black">
        <!-- Promo Banner - Animated Ticker -->
        <div class="bg-black text-white py-2 overflow-hidden">
            <div class="animate-marquee whitespace-nowrap flex">
                <span class="mx-8 text-sm font-medium tracking-wide"
                    >ENVIO GRATIS EN PEDIDOS +100</span
                >
                <span class="mx-8 text-sm text-accent font-bold"
                    >NUEVA COLECCION 2026</span
                >
                <span class="mx-8 text-sm font-medium tracking-wide"
                    >DEVOLUCIONES GRATUITAS 30 DIAS</span
                >
                <span class="mx-8 text-sm text-accent font-bold"
                    >-20% EN TU PRIMERA COMPRA</span
                >
                <span class="mx-8 text-sm font-medium tracking-wide"
                    >ENVIO GRATIS EN PEDIDOS +100</span
                >
                <span class="mx-8 text-sm text-accent font-bold"
                    >NUEVA COLECCION 2026</span
                >
                <span class="mx-8 text-sm font-medium tracking-wide"
                    >DEVOLUCIONES GRATUITAS 30 DIAS</span
                >
                <span class="mx-8 text-sm text-accent font-bold"
                    >-20% EN TU PRIMERA COMPRA</span
                >
            </div>
        </div>

        <!-- Header -->
        <header
            class="sticky top-0 z-50 bg-black border-b border-slate-800 transition-all duration-300"
        >
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex items-center justify-between h-16 lg:h-20">
                    <!-- Logo -->
                    <a
                        href={ROUTES.HOME}
                        class="font-display text-2xl lg:text-3xl font-black text-white tracking-tight hover:text-accent transition-colors duration-200"
                    >
                        FASHION<span class="text-accent">MARKET</span>
                    </a>

                    <!-- Nav - Desktop -->
                    <nav class="hidden lg:flex items-center gap-8">
                        <!-- Inicio -->
                        <a
                            href={ROUTES.HOME}
                            class:list={[
                                "relative text-sm font-semibold uppercase tracking-wider transition-colors duration-200 py-2",
                                currentPath === ROUTES.HOME
                                    ? "text-white after:absolute after:bottom-0 after:left-0 after:w-full after:h-0.5 after:bg-accent"
                                    : "text-slate-400 hover:text-white",
                            ]}
                        >
                            Inicio
                        </a>

                        <!-- Todo -->
                        <a
                            href={ROUTES.PRODUCTS}
                            class:list={[
                                "relative text-sm font-semibold uppercase tracking-wider transition-colors duration-200 py-2",
                                currentPath === ROUTES.PRODUCTS
                                    ? "text-white after:absolute after:bottom-0 after:left-0 after:w-full after:h-0.5 after:bg-accent"
                                    : "text-slate-400 hover:text-white",
                            ]}
                        >
                            Productos
                        </a>

                        <!-- Categorías Dropdown -->
                        <div class="relative group">
                            <button
                                type="button"
                                aria-label="Abrir menú de categorías"
                                class="flex items-center gap-1 text-sm font-semibold uppercase tracking-wider text-slate-400 hover:text-white transition-colors duration-200 py-2"
                            >
                                Categorías
                                <svg
                                    class="w-4 h-4 transition-transform group-hover:rotate-180"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    stroke-width="2"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M19 9l-7 7-7-7"></path>
                                </svg>
                            </button>

                            <!-- Dropdown Menu -->
                            <div
                                class="absolute left-0 top-full mt-2 w-56 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50"
                            >
                                <div
                                    class="bg-slate-900 border border-slate-700 shadow-xl py-2"
                                >
                                    <a
                                        href={ROUTES.SALE}
                                        class:list={[
                                            "block px-4 py-2.5 text-sm font-medium uppercase tracking-wide transition-colors",
                                            currentPath === ROUTES.SALE
                                                ? "text-accent bg-slate-800"
                                                : "text-slate-300 hover:text-white hover:bg-slate-800",
                                        ]}
                                    >
                                        Ofertas
                                    </a>
                                    <a
                                        href={ROUTES.OUTLET}
                                        class:list={[
                                            "block px-4 py-2.5 text-sm font-medium uppercase tracking-wide transition-colors",
                                            currentPath === ROUTES.OUTLET
                                                ? "text-accent bg-slate-800"
                                                : "text-slate-300 hover:text-white hover:bg-slate-800",
                                        ]}
                                    >
                                        Outlet
                                    </a>
                                    <div class="border-t border-slate-700 my-1">
                                    </div>
                                    <a
                                        href={ROUTES.CATEGORY("zapatillas")}
                                        class:list={[
                                            "block px-4 py-2.5 text-sm font-medium uppercase tracking-wide transition-colors",
                                            currentPath ===
                                            ROUTES.CATEGORY("zapatillas")
                                                ? "text-accent bg-slate-800"
                                                : "text-slate-300 hover:text-white hover:bg-slate-800",
                                        ]}
                                    >
                                        Zapatillas
                                    </a>
                                    <a
                                        href={ROUTES.CATEGORY("camisetas")}
                                        class:list={[
                                            "block px-4 py-2.5 text-sm font-medium uppercase tracking-wide transition-colors",
                                            currentPath ===
                                            ROUTES.CATEGORY("camisetas")
                                                ? "text-accent bg-slate-800"
                                                : "text-slate-300 hover:text-white hover:bg-slate-800",
                                        ]}
                                    >
                                        Camisetas
                                    </a>
                                    <a
                                        href={ROUTES.CATEGORY("pantalones")}
                                        class:list={[
                                            "block px-4 py-2.5 text-sm font-medium uppercase tracking-wide transition-colors",
                                            currentPath ===
                                            ROUTES.CATEGORY("pantalones")
                                                ? "text-accent bg-slate-800"
                                                : "text-slate-300 hover:text-white hover:bg-slate-800",
                                        ]}
                                    >
                                        Pantalones
                                    </a>
                                    <a
                                        href={ROUTES.CATEGORY("sudaderas")}
                                        class:list={[
                                            "block px-4 py-2.5 text-sm font-medium uppercase tracking-wide transition-colors",
                                            currentPath ===
                                            ROUTES.CATEGORY("sudaderas")
                                                ? "text-accent bg-slate-800"
                                                : "text-slate-300 hover:text-white hover:bg-slate-800",
                                        ]}
                                    >
                                        Sudaderas
                                    </a>
                                </div>
                            </div>
                        </div>
                    </nav>

                    <!-- Actions -->
                    <div class="flex items-center gap-2 lg:gap-4">
                        <!-- Search Form -->
                        <div
                            id="searchContainer"
                            class="hidden absolute top-full right-0 left-0 mt-2 px-4 sm:px-6 lg:px-8"
                        >
                            <form
                                id="searchForm"
                                class="max-w-md ml-auto bg-slate-900 border border-slate-700 p-4 shadow-xl"
                            >
                                <div class="flex gap-2">
                                    <input
                                        type="text"
                                        id="searchInput"
                                        placeholder="Buscar productos..."
                                        class="flex-1 px-4 py-2 bg-slate-800 border border-slate-700 text-white placeholder:text-slate-500 focus:outline-none focus:border-accent"
                                    />
                                    <button
                                        type="submit"
                                        class="px-6 py-2 bg-accent hover:bg-red-700 text-white font-bold uppercase text-sm transition-colors"
                                    >
                                        Buscar
                                    </button>
                                    <button
                                        type="button"
                                        id="closeSearch"
                                        class="px-3 py-2 text-slate-400 hover:text-white transition-colors"
                                    >
                                        ✕
                                    </button>
                                </div>
                            </form>
                        </div>
                        <!-- Search Icon -->
                        <button
                            type="button"
                            id="searchButton"
                            aria-label="Buscar productos"
                            class="p-2 lg:p-3 text-slate-400 hover:text-white hover:bg-slate-800 rounded-full transition-all duration-200"
                        >
                            <svg
                                class="h-5 w-5 lg:h-6 lg:w-6"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                stroke-width="2"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"
                                ></path>
                            </svg>
                        </button>
                        <!-- User -->
                        <UserButton client:load />
                        <!-- Cart -->
                        <CartTrigger client:load />
                        <!-- Mobile Menu -->
                        <button
                            type="button"
                            class="lg:hidden p-2 text-slate-400 hover:text-white"
                            id="mobile-menu-btn"
                            aria-label="Abrir menú principal"
                        >
                            <svg
                                class="h-6 w-6"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                stroke-width="2"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"
                                ></path>
                            </svg>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Mobile Nav -->
            <div class="hidden lg:hidden" id="mobile-menu">
                <nav
                    class="px-4 py-4 space-y-2 bg-slate-900 border-t border-slate-800"
                >
                    <!-- Main Links -->
                    <a
                        href={ROUTES.HOME}
                        class:list={[
                            "block py-3 px-4 text-base font-semibold uppercase tracking-wide",
                            currentPath === ROUTES.HOME
                                ? "text-accent bg-slate-800"
                                : "text-slate-300 hover:text-white hover:bg-slate-800",
                        ]}
                    >
                        Inicio
                    </a>
                    <a
                        href={ROUTES.PRODUCTS}
                        class:list={[
                            "block py-3 px-4 text-base font-semibold uppercase tracking-wide",
                            currentPath === ROUTES.PRODUCTS
                                ? "text-accent bg-slate-800"
                                : "text-slate-300 hover:text-white hover:bg-slate-800",
                        ]}
                    >
                        Productos
                    </a>

                    <!-- Categories Section -->
                    <div class="pt-2 pb-1 px-4">
                        <span
                            class="text-xs font-bold uppercase tracking-wider text-slate-500"
                            >Categorías</span
                        >
                    </div>
                    <a
                        href={ROUTES.SALE}
                        class:list={[
                            "block py-2.5 px-4 text-sm font-medium uppercase tracking-wide",
                            currentPath === ROUTES.SALE
                                ? "text-accent bg-slate-800"
                                : "text-slate-400 hover:text-white hover:bg-slate-800",
                        ]}
                    >
                        Ofertas
                    </a>
                    <a
                        href={ROUTES.OUTLET}
                        class:list={[
                            "block py-2.5 px-4 text-sm font-medium uppercase tracking-wide",
                            currentPath === ROUTES.OUTLET
                                ? "text-accent bg-slate-800"
                                : "text-slate-400 hover:text-white hover:bg-slate-800",
                        ]}
                    >
                        Outlet
                    </a>
                    <a
                        href={ROUTES.CATEGORY("zapatillas")}
                        class:list={[
                            "block py-2.5 px-4 text-sm font-medium uppercase tracking-wide",
                            currentPath === ROUTES.CATEGORY("zapatillas")
                                ? "text-accent bg-slate-800"
                                : "text-slate-400 hover:text-white hover:bg-slate-800",
                        ]}
                    >
                        Zapatillas
                    </a>
                    <a
                        href={ROUTES.CATEGORY("camisetas")}
                        class:list={[
                            "block py-2.5 px-4 text-sm font-medium uppercase tracking-wide",
                            currentPath === ROUTES.CATEGORY("camisetas")
                                ? "text-accent bg-slate-800"
                                : "text-slate-400 hover:text-white hover:bg-slate-800",
                        ]}
                    >
                        Camisetas
                    </a>
                    <a
                        href={ROUTES.CATEGORY("pantalones")}
                        class:list={[
                            "block py-2.5 px-4 text-sm font-medium uppercase tracking-wide",
                            currentPath === ROUTES.CATEGORY("pantalones")
                                ? "text-accent bg-slate-800"
                                : "text-slate-400 hover:text-white hover:bg-slate-800",
                        ]}
                    >
                        Pantalones
                    </a>
                    <a
                        href={ROUTES.CATEGORY("sudaderas")}
                        class:list={[
                            "block py-2.5 px-4 text-sm font-medium uppercase tracking-wide",
                            currentPath === ROUTES.CATEGORY("sudaderas")
                                ? "text-accent bg-slate-800"
                                : "text-slate-400 hover:text-white hover:bg-slate-800",
                        ]}
                    >
                        Sudaderas
                    </a>
                </nav>
            </div>
        </header>

        <!-- Main -->
        <main class="flex-1">
            <slot />
        </main>

        <!-- Footer -->
        <footer class="bg-black text-white">
            <!-- Newsletter -->
            <div class="border-b border-slate-800">
                <div
                    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-10"
                >
                    <div class="lg:flex lg:items-center lg:justify-between">
                        <div class="mb-6 lg:mb-0">
                            <h3
                                class="font-display text-xl lg:text-2xl font-bold"
                            >
                                UNETE AL CLUB
                            </h3>
                            <p class="mt-2 text-slate-400 text-sm">
                                Recibe ofertas exclusivas y novedades
                                directamente en tu email.
                            </p>
                        </div>
                        <NewsletterForm client:visible />
                    </div>
                </div>
            </div>

            <!-- Links -->
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-10">
                <div class="grid grid-cols-2 md:grid-cols-4 gap-8 lg:gap-12">
                    <!-- Brand -->
                    <div class="col-span-2 md:col-span-1">
                        <span class="font-display text-2xl font-black">
                            FASHION<span class="text-accent">MARKET</span>
                        </span>
                        <p class="mt-4 text-slate-400 text-sm leading-relaxed">
                            Moda premium para el hombre moderno. Estilo, calidad
                            y actitud.
                        </p>
                    </div>

                    <!-- Links -->
                    <div>
                        <h4
                            class="font-bold text-sm uppercase tracking-wider mb-4"
                        >
                            Tienda
                        </h4>
                        <ul class="space-y-3 text-sm text-slate-400">
                            {
                                STORE_NAV.slice(1).map((item) => (
                                    <li>
                                        <a
                                            href={item.href}
                                            class="hover:text-white transition-colors"
                                        >
                                            {item.name}
                                        </a>
                                    </li>
                                ))
                            }
                        </ul>
                    </div>

                    <div>
                        <h4
                            class="font-bold text-sm uppercase tracking-wider mb-4"
                        >
                            Ayuda
                        </h4>
                        <ul class="space-y-3 text-sm text-slate-400">
                            <li>
                                <a
                                    href="/envio"
                                    class="hover:text-white transition-colors"
                                    >Envio</a
                                >
                            </li>
                            <li>
                                <a
                                    href="/devoluciones"
                                    class="hover:text-white transition-colors"
                                    >Devoluciones</a
                                >
                            </li>
                            <li>
                                <a
                                    href="/productos"
                                    class="hover:text-white transition-colors"
                                    >Tallas</a
                                >
                            </li>
                            <li>
                                <a
                                    href="/contacto"
                                    class="hover:text-white transition-colors"
                                    >Contacto</a
                                >
                            </li>
                        </ul>
                    </div>

                    <div>
                        <h4
                            class="font-bold text-sm uppercase tracking-wider mb-4"
                        >
                            Legal
                        </h4>
                        <ul class="space-y-3 text-sm text-slate-400">
                            <li>
                                <a
                                    href="/privacidad"
                                    class="hover:text-white transition-colors"
                                    >Privacidad</a
                                >
                            </li>
                            <li>
                                <a
                                    href="/terminos"
                                    class="hover:text-white transition-colors"
                                    >Terminos</a
                                >
                            </li>
                            <li>
                                <a
                                    href="/cookies"
                                    class="hover:text-white transition-colors"
                                    >Cookies</a
                                >
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Bottom -->
            <div class="border-t border-slate-800">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
                    <div
                        class="flex flex-col md:flex-row md:items-center md:justify-between gap-4"
                    >
                        <p class="text-sm text-slate-500">
                            &copy; {new Date().getFullYear()} FashionMarket. Todos
                            los derechos reservados.
                        </p>
                        <div class="flex items-center gap-4">
                            <img
                                src="https://upload.wikimedia.org/wikipedia/commons/thumb/b/ba/Stripe_Logo%2C_revised_2016.svg/120px-Stripe_Logo%2C_revised_2016.svg.png"
                                alt="Stripe"
                                width="100"
                                height="42"
                                class="h-6 opacity-50"
                                loading="lazy"
                                decoding="async"
                            />
                        </div>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <!-- Scripts -->
    <script>
        // Search functionality
        const searchButton = document.getElementById("searchButton");
        const searchContainer = document.getElementById("searchContainer");
        const searchForm = document.getElementById("searchForm");
        const searchInput = document.getElementById("searchInput");
        const closeSearch = document.getElementById("closeSearch");

        searchButton?.addEventListener("click", () => {
            searchContainer?.classList.toggle("hidden");
            searchInput?.focus();
        });

        closeSearch?.addEventListener("click", () => {
            searchContainer?.classList.add("hidden");
            if (searchInput) searchInput.value = "";
        });

        searchForm?.addEventListener("submit", (e) => {
            e.preventDefault();
            const query = searchInput?.value.trim();
            if (query) {
                window.location.href = `/buscar?q=${encodeURIComponent(query)}`;
            }
        });

        // Mobile Menu
        const menuBtn = document.getElementById("mobile-menu-btn");
        const mobileMenu = document.getElementById("mobile-menu");
        menuBtn?.addEventListener("click", () => {
            mobileMenu?.classList.toggle("hidden");
        });
    </script>
</BaseLayout>
