---
/**
 * Admin Layout - Base layout for admin pages
 */
import BaseLayout from "./BaseLayout.astro";
import { ADMIN_NAV } from "@/lib/config/routes";

interface Props {
    title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;

const getIcon = (name: string) => {
    const icons: Record<string, string> = {
        home: '<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>',
        box: '<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>',
        folder: '<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path></svg>',
        "shopping-bag":
            '<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>',
        return:
            '<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"></path></svg>',
        users: '<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>',
        ticket: '<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"></path></svg>',
        tag: '<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path></svg>',
        layout: '<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"></path></svg>',
        default:
            '<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>',
    };
    return icons[name] || icons.default;
};
---

<BaseLayout title={`${title} | Admin - FashionMarket`}>
    <div class="min-h-screen bg-slate-950 flex">
        <!-- Sidebar -->
        <aside class="w-64 bg-slate-900 border-r border-slate-800 fixed h-full flex flex-col">
            <div class="p-6 border-b border-slate-800 flex-shrink-0">
                <a
                    href="/gestion-fm"
                    class="font-display text-xl font-black text-white"
                >
                    FASHION<span class="text-accent">MARKET</span>
                    <span class="block text-xs text-slate-500 font-normal mt-1"
                        >Panel de Administracion</span
                    >
                </a>
            </div>

            <nav class="p-4 flex-1 overflow-y-auto">
                <ul class="space-y-1">
                    {
                        ADMIN_NAV.map((item) => (
                            <li>
                                <a
                                    href={item.href}
                                    class:list={[
                                        "flex items-center gap-3 px-4 py-3 transition-colors rounded",
                                        currentPath === item.href ||
                                        currentPath.startsWith(`${item.href}/`)
                                            ? "bg-accent text-white font-medium"
                                            : "text-slate-300 hover:bg-slate-800 hover:text-white",
                                    ]}
                                >
                                    <Fragment set:html={getIcon(item.icon)} />
                                    {item.name}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </nav>

            <div
                class="p-4 border-t border-slate-800 flex-shrink-0"
            >
                <a
                    href="/"
                    class="flex items-center gap-3 px-4 py-3 text-slate-400 hover:bg-slate-800 hover:text-white transition-colors rounded"
                >
                    <svg
                        class="w-5 h-5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M11 17l-5-5m0 0l5-5m-5 5h12"></path>
                    </svg>
                    Volver a la Tienda
                </a>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="flex-1 ml-64">
            <header class="bg-slate-900 border-b border-slate-800 px-8 py-4">
                <h1 class="text-xl font-bold text-white">{title}</h1>
            </header>
            <div class="p-8">
                <slot />
            </div>
        </main>
    </div>

    <script>
        // Check admin access on load
        import { getCurrentUser } from "@/lib/services/auth-client.service";
        import { createClient } from "@supabase/supabase-js";

        const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
        const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

        async function checkAdminAccess() {
            const user = await getCurrentUser();

            if (!user) {
                window.location.href = "/auth/login?redirect=/gestion-fm";
                return;
            }

            const supabase = createClient(supabaseUrl, supabaseKey);
            const { data: profile } = await supabase
                .from("user_profiles")
                .select("is_admin")
                .eq("id", user.id)
                .single();

            if (!profile?.is_admin) {
                window.location.href = "/?error=no_admin_access";
            }
        }

        checkAdminAccess();
    </script>
</BaseLayout>
