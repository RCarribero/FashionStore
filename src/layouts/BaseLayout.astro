---
import "../styles/global.css";

interface Props {
    title: string;
    description?: string;
    image?: string;
}

const {
    title,
    description = "FashionMarket - Moda masculina premium con estilo sofisticado",
    image = "/og-image.jpg",
} = Astro.props;

const canonicalURL = Astro.site
    ? new URL(Astro.url.pathname, Astro.site)
    : Astro.url;
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/png" href="/logo.png" />
        <link rel="canonical" href={canonicalURL} />

        <!-- Primary Meta Tags -->
        <title>{title} | FashionMarket</title>
        <meta name="title" content={`${title} | FashionMarket`} />
        <meta name="description" content={description} />

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={`${title} | FashionMarket`} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={image} />

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={canonicalURL} />
        <meta property="twitter:title" content={`${title} | FashionMarket`} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={image} />

        <!-- Fonts preload -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

        <meta name="generator" content={Astro.generator} />
    </head>
    <body class="min-h-screen flex flex-col">
        <slot />
    </body>
</html>
