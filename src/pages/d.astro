---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Feliz San Valentín">
    <section class="min-h-screen bg-slate-950 flex items-center justify-center px-4">
        <div class="text-center">
            <svg
                class="mx-auto h-32 w-32 text-red-500 drop-shadow-[0_0_20px_rgba(239,68,68,0.6)]"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
            >
                <path
                    d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09A6.004 6.004 0 0 1 16.5 3C19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
                ></path>
            </svg>
            <h1 class="mt-8 text-4xl sm:text-6xl font-black uppercase tracking-wider text-white">
                Feliz <span class="text-red-500">San Valentín</span>
            </h1>
        </div>
    </section>
</BaseLayout>
