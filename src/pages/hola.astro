---
import BaseLayout from "../shared/layouts/BaseLayout.astro";
---

<BaseLayout title="Hola Mundo">
    <section class="relative min-h-screen overflow-hidden bg-gradient-to-br from-slate-950 via-slate-900 to-black px-6 py-16 text-white">
        <div
            class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(255,255,255,0.08),transparent_35%),radial-gradient(circle_at_80%_10%,rgba(236,72,153,0.12),transparent_30%),radial-gradient(circle_at_30%_80%,rgba(56,189,248,0.12),transparent_30%)]"
        ></div>

        <div class="relative mx-auto flex max-w-5xl flex-col items-center text-center">
            <div class="mb-6 inline-flex items-center gap-3 rounded-full border border-white/10 bg-white/5 px-4 py-2 backdrop-blur">
                <span class="h-2 w-2 animate-ping rounded-full bg-accent"></span>
                <span class="text-sm font-semibold tracking-wide text-slate-200">
                    Nueva ruta /hola lista para ti
                </span>
            </div>

            <h1 class="font-display text-4xl font-black leading-tight sm:text-5xl lg:text-6xl">
                Hola, <span class="text-accent">Mundo</span>
            </h1>

            <p class="mt-6 max-w-2xl text-lg text-slate-300 sm:text-xl">
                Bienvenido a un saludo lleno de estilo. Esta página demuestra lo rápido que
                podemos crear experiencias elegantes con FashionMarket.
            </p>

            <div class="mt-10 grid w-full gap-6 rounded-3xl border border-white/10 bg-white/5 p-8 shadow-[0_20px_80px_-40px_rgba(0,0,0,0.8)] backdrop-blur-lg sm:grid-cols-2">
                <div class="flex items-start gap-4 text-left">
                    <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-accent/20 text-accent">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-6 w-6"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="1.6"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                            />
                        </svg>
                    </div>
                    <div>
                        <h3 class="text-lg font-semibold text-white">Mensaje luminoso</h3>
                        <p class="text-slate-300">
                            Un "hola mundo" moderno con degradados y detalles brillantes para
                            que se sienta especial.
                        </p>
                    </div>
                </div>

                <div class="flex items-start gap-4 text-left">
                    <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-cyan-400/15 text-cyan-300">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-6 w-6"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="1.6"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M12 4v16m8-8H4"
                            />
                        </svg>
                    </div>
                    <div>
                        <h3 class="text-lg font-semibold text-white">Listo para explorar</h3>
                        <p class="text-slate-300">
                            Usa el menú para volver a la tienda o sigue probando nuevas rutas
                            personalizadas.
                        </p>
                    </div>
                </div>
            </div>

            <div class="mt-12 flex flex-col gap-4 sm:flex-row">
                <a
                    href="/"
                    class="inline-flex items-center justify-center rounded-full bg-accent px-6 py-3 text-base font-semibold uppercase tracking-wide text-black transition hover:translate-y-[-2px] hover:shadow-[0_20px_50px_-24px_rgba(0,0,0,0.9)]"
                >
                    Volver al inicio
                </a>
                <a
                    href="/productos"
                    class="inline-flex items-center justify-center rounded-full border border-white/20 px-6 py-3 text-base font-semibold uppercase tracking-wide text-white transition hover:border-accent hover:text-accent"
                >
                    Ver catálogo
                </a>
            </div>
        </div>
    </section>
</BaseLayout>
