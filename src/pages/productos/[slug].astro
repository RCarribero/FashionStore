---
/**
 * Product Detail Page - Dynamic Route
 */
export const prerender = false;

import StoreLayout from "../../modules/store/layouts/StoreLayout.astro";
import ProductSelector from "../../modules/store/components/ProductSelector";
import SizeRecommender from "../../components/products/SizeRecommender";
import { supabase } from "../../modules/auth";
import { formatPrice } from "../../shared/utils";
import {
    getActivePromotions,
    calculateDiscountedPrice,
} from "../../shared/utils/promotions";
import { ROUTES } from "../../config";
import { STORE_CONFIG } from "../../modules/store/config";

const { slug } = Astro.params;

const { data: product } = await supabase
    .from("products")
    .select("*, category:categories(*)")
    .eq("slug", slug)
    .single();

if (!product) {
    return Astro.redirect("/productos");
}

// Get variants for this product
const { data: variants } = await supabase
    .from("product_variants")
    .select("*")
    .eq("product_id", product.id)
    .order("size");

// Calculate discounted price if promotion exists
const promotions = await getActivePromotions();
const discountInfo = calculateDiscountedPrice(
    product.id,
    product.price,
    promotions,
);
const discountedPrice = discountInfo?.discountedPrice ?? null;
const promotionTitle = discountInfo?.promotion.public_title ?? null;
---

<StoreLayout title={product.name} description={product.description}>
    <div class="min-h-screen bg-slate-950">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
            <nav class="mb-8">
                <ol class="flex items-center gap-2 text-sm text-slate-400">
                    <li>
                        <a
                            href={ROUTES.HOME}
                            class="hover:text-white transition-colors">Inicio</a
                        >
                    </li>
                    <li>/</li>
                    <li>
                        <a
                            href={ROUTES.PRODUCTS}
                            class="hover:text-white transition-colors"
                            >Productos</a
                        >
                    </li>
                    <li>/</li>
                    <li class="text-white font-medium">{product.name}</li>
                </ol>
            </nav>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
                <div
                    class="aspect-[3/4] bg-slate-900 border border-slate-800 overflow-hidden relative rounded-lg"
                >
                    {
                        product.images?.[0] ? (
                            <img
                                src={product.images[0]}
                                alt={product.name}
                                class="w-full h-full object-cover"
                            />
                        ) : (
                            <div class="w-full h-full flex items-center justify-center text-slate-700">
                                <svg
                                    class="h-24 w-24"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="1"
                                        d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                                    />
                                </svg>
                            </div>
                        )
                    }
                </div>

                <div class="flex flex-col">
                    {
                        product.category && (
                            <a
                                href={ROUTES.CATEGORY(product.category.slug)}
                                class="text-sm text-accent hover:text-red-400 transition-colors mb-2 uppercase tracking-wide font-medium"
                            >
                                {product.category.name}
                            </a>
                        )
                    }

                    <h1
                        class="font-display text-4xl lg:text-5xl text-white mb-4"
                    >
                        {product.name}
                    </h1>
                    <div class="mb-6">
                        {
                            discountedPrice ? (
                                <>
                                    <p class="text-slate-400 line-through text-xl">
                                        {formatPrice(product.price)}
                                    </p>
                                    <p class="text-accent font-bold text-3xl">
                                        {formatPrice(discountedPrice)}
                                    </p>
                                    <span class="inline-block mt-2 px-3 py-1 bg-accent/20 text-accent text-sm font-medium rounded">
                                        {promotionTitle}
                                    </span>
                                </>
                            ) : (
                                <p class="text-3xl font-bold text-white">
                                    {formatPrice(product.price)}
                                </p>
                            )
                        }
                    </div>
                    <div class="prose prose-invert max-w-none mb-8">
                        <p class="text-slate-300 leading-relaxed text-lg">
                            {product.description}
                        </p>
                    </div>

                    <div class="mt-auto">
                        <SizeRecommender client:visible />
                        <ProductSelector
                            client:load
                            product={product}
                            variants={variants || []}
                        />
                    </div>

                    <div class="mt-12 pt-8 border-t border-slate-800">
                        <h3 class="font-display text-lg text-white mb-4">
                            Detalles del Producto
                        </h3>
                        <dl class="space-y-4 text-sm">
                            <div
                                class="flex justify-between py-3 border-b border-slate-800/50"
                            >
                                <dt class="text-slate-400">Categoria</dt>
                                <dd class="text-white font-medium">
                                    {product.category?.name || "Sin categoria"}
                                </dd>
                            </div>
                            <div
                                class="flex justify-between py-3 border-b border-slate-800/50"
                            >
                                <dt class="text-slate-400">SKU</dt>
                                <dd
                                    class="text-white font-medium tracking-wider"
                                >
                                    {product.id.slice(0, 8).toUpperCase()}
                                </dd>
                            </div>
                        </dl>
                    </div>
                </div>
            </div>
        </div>
    </div>
</StoreLayout>
