---
/**
 * Payment Success Page
 */
export const prerender = false;

import StoreLayout from "../../modules/store/layouts/StoreLayout.astro";
import { ROUTES } from "../../config";
---

<StoreLayout title="Pago Completado">
    <div
        class="min-h-screen bg-slate-950 flex items-center justify-center px-4"
    >
        <div class="max-w-2xl w-full text-center">
            <!-- Success Icon -->
            <div class="mb-8">
                <div
                    class="inline-flex items-center justify-center w-24 h-24 bg-green-500/10 border-2 border-green-500 rounded-full mb-6"
                >
                    <svg
                        class="h-12 w-12 text-green-500"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M5 13l4 4L19 7"></path>
                    </svg>
                </div>
                <h1 class="font-display text-4xl text-white mb-4">
                    Pago Completado
                </h1>
                <p class="text-xl text-slate-400 mb-2">Gracias por tu compra</p>
                <p class="text-slate-500">
                    Recibirás un email de confirmación con los detalles de tu
                    pedido.
                </p>
            </div>

            <!-- Order Info -->
            <div
                class="bg-slate-900 border border-slate-800 p-6 mb-8 text-left"
            >
                <h2 class="font-display text-lg text-white mb-4">
                    Resumen del pedido
                </h2>
                <div class="space-y-3 text-sm">
                    <div class="flex justify-between">
                        <span class="text-slate-400">Estado:</span>
                        <span class="text-green-400 font-medium"
                            >Confirmado</span
                        >
                    </div>
                    <div class="flex justify-between">
                        <span class="text-slate-400">Método de pago:</span>
                        <span class="text-white">Tarjeta de crédito</span>
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a
                    href={ROUTES.PRODUCTS}
                    class="px-8 py-4 bg-accent hover:bg-red-700 text-white font-bold uppercase tracking-wider transition-colors"
                >
                    Seguir Comprando
                </a>
                <a
                    href={ROUTES.HOME}
                    class="px-8 py-4 border-2 border-white text-white hover:bg-white hover:text-black font-bold uppercase tracking-wider transition-all"
                >
                    Volver al Inicio
                </a>
            </div>
        </div>
    </div>
</StoreLayout>

<script>
    // Clear cart after successful payment
    localStorage.removeItem("fashionmarket-cart");

    // Sync order with backend (updates stock, creates order, marks first purchase)
    const urlParams = new URLSearchParams(window.location.search);
    const sessionId = urlParams.get("session_id");

    if (sessionId) {
        fetch("/api/orders/sync", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ sessionId }),
        })
            .then((res) => res.json())
            .then((data) => {
                console.log("Order synced:", data);
            })
            .catch((err) => {
                console.error("Failed to sync order:", err);
            });
    }
</script>
