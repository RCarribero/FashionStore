---
import "../../styles/global.css";
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Para ti</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400&display=swap"
            rel="stylesheet"
        />
    </head>
    <body
        class="bg-[#fdfbf7] text-[#5c5552] flex flex-col items-center justify-center min-h-screen overflow-hidden antialiased selection:bg-rose-100 selection:text-rose-900"
    >
        <main
            class="relative z-10 flex flex-col items-center w-full max-w-2xl p-8"
        >
            <!-- Lily Stage -->
            <div
                class="relative w-64 h-64 md:w-80 md:h-80 mb-24 transition-transform duration-700 ease-out cursor-pointer md:cursor-default"
            >
                <svg
                    id="lily-svg"
                    viewBox="0 0 200 200"
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-full h-full overflow-visible"
                >
                    <!-- Layer 1: Stems and Leaves (Background) -->
                    <g
                        id="stems-group"
                        class="origin-center opacity-0 scale-50"
                        style="transform-box: fill-box;"></g>

                    <!-- Layer 2: Flower Heads (Foreground) -->
                    <g
                        id="heads-group"
                        class="origin-center opacity-0 scale-50"
                        style="transform-box: fill-box;"></g>

                    <circle
                        cx="100"
                        cy="100"
                        r="3"
                        fill="#FFE4E1"
                        class="opacity-80"></circle>
                </svg>
            </div>

            <!-- Text Section -->
            <div
                class="w-full flex items-center justify-center py-4 min-h-[12rem]"
            >
                <div
                    id="typewriter-container"
                    class="font-serif text-xl md:text-2xl text-center leading-relaxed tracking-wide italic flex flex-col items-center justify-center px-4"
                >
                    <!-- Text injected via JS -->
                    <span
                        id="cursor"
                        class="inline-block w-0.5 h-6 bg-[#5c5552] ml-1 animate-pulse"
                    ></span>
                </div>
            </div>

            <!-- Counter Section -->
            <div
                id="counter-section"
                class="mt-4 text-center opacity-0 transition-opacity duration-1000 transform translate-y-4 pb-12"
            >
                <p class="font-serif text-lg text-[#8a817c] mb-3">
                    Mi amor por ti comenzó hace...
                </p>
                <div
                    id="counter"
                    class="font-serif text-xl md:text-2xl font-light tracking-widest text-[#5c5552] tabular-nums"
                >
                    <!-- Counter injected via JS -->
                </div>
            </div>
        </main>

        <style>
            /* Custom tweaks */
            body {
                font-family: "Cormorant Garamond", serif;
            }

            /* Smooth reveal animation class */
            .bloom-active {
                animation: bloom-spring 2.5s cubic-bezier(0.34, 1.56, 0.64, 1)
                    forwards;
            }

            @keyframes bloom-spring {
                0% {
                    opacity: 0;
                    transform: scale(0.3) rotate(-10deg);
                }
                100% {
                    opacity: 1;
                    transform: scale(1) rotate(0deg);
                }
            }

            /* Subtle floating animation for petals */
            @keyframes float-petal {
                0%,
                100% {
                    transform: translateY(0);
                }
                50% {
                    transform: translateY(-2px);
                }
            }

            @keyframes fadeIn {
                from {
                    opacity: 0;
                }
                to {
                    opacity: 1;
                }
            }

            @keyframes bloom-petal {
                0% {
                    opacity: 0;
                    transform: scale(0) rotate(0deg);
                }
                100% {
                    opacity: 1;
                    transform: scale(1.5) rotate(var(--angle, 0deg));
                }
            }

            @keyframes bloom-emoji {
                0% {
                    opacity: 0;
                    transform: scale(0) rotate(-15deg);
                }
                100% {
                    opacity: 1;
                    transform: scale(1) rotate(0deg);
                }
            }
        </style>

        <script>
            /**
             * BOUQUET CONFIGURATION & GENERATION
             */
            const SVG_NS = "http://www.w3.org/2000/svg";
            const STEM_COLOR = "#228B22";

            function createLeafPath() {
                return "M 0 0 Q 5 -5 10 0 Q 5 5 0 0";
            }

            function randomRange(min: number, max: number) {
                return Math.random() * (max - min) + min;
            }

            // Split creation into two parts to handle layers
            function createFlower(
                stemsGroup: HTMLElement,
                headsGroup: HTMLElement,
                x: number,
                y: number,
                scale: number,
                delayBase: number,
            ) {
                // --- LAYER 1: STEMS & LEAVES ---

                // 1. Draw Stem
                const stem = document.createElementNS(SVG_NS, "path");
                const startX = 100 + (x - 100) * 0.5; // Tighter bunch at bottom
                const startY = 190;
                const endY = y + 8; // Go slightly higher into the head area

                const cX = (startX + x) / 2 + randomRange(-5, 5);
                const cY = (startY + endY) / 2;

                stem.setAttribute(
                    "d",
                    `M ${startX} ${startY} Q ${cX} ${cY} ${x} ${endY}`,
                );
                stem.setAttribute("stroke", STEM_COLOR);
                stem.setAttribute("stroke-width", "2");
                stem.setAttribute("fill", "none");
                stem.style.opacity = "0";
                stem.style.animation = `fadeIn 1s ease-out ${delayBase}s forwards`;
                stemsGroup.appendChild(stem);

                // 2. Draw Leaves
                const numLeaves = Math.floor(randomRange(1, 3));
                for (let l = 0; l < numLeaves; l++) {
                    const t = randomRange(0.2, 0.7);
                    const lx = startX + (x - startX) * t;
                    const ly = startY + (endY - startY) * t;

                    const leaf = document.createElementNS(SVG_NS, "path");
                    leaf.setAttribute("d", createLeafPath());
                    leaf.setAttribute("fill", STEM_COLOR);
                    leaf.setAttribute(
                        "transform",
                        `translate(${lx}, ${ly}) scale(${randomRange(1, 2)}) rotate(${randomRange(-45, 45)})`,
                    );
                    leaf.style.opacity = "0";
                    leaf.style.animation = `fadeIn 1s ease-out ${delayBase + 0.3}s forwards`;
                    stemsGroup.appendChild(leaf);
                }

                // --- LAYER 2: FLOWER HEADS ---

                // 3. Draw Rose Emoji
                const rose = document.createElementNS(SVG_NS, "text");
                rose.textContent = "🌷";
                rose.setAttribute("x", x.toString());
                rose.setAttribute("y", (y + 5).toString());
                rose.setAttribute("text-anchor", "middle");
                rose.setAttribute("dominant-baseline", "central");
                rose.setAttribute("font-size", (28 * scale).toString()); // Slightly large

                rose.style.opacity = "0";
                rose.style.transformOrigin = `${x}px ${y}px`;
                rose.style.animation = `bloom-emoji 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275) ${delayBase + 0.5}s forwards`;

                headsGroup.appendChild(rose);
            }

            function generateBouquet() {
                const stemsGroup = document.getElementById("stems-group");
                const headsGroup = document.getElementById("heads-group");
                if (!stemsGroup || !headsGroup) return;

                stemsGroup.innerHTML = "";
                headsGroup.innerHTML = "";

                // Responsive configuration
                const isMobile = window.innerWidth < 768;

                // Heart shape parametric equations:
                // x = 16 sin^3 t
                // y = 13 cos t - 5 cos 2t - 2 cos 3t - cos 4t
                const scaleX = isMobile ? 2.5 : 3.5;
                const scaleY = isMobile ? 2.5 : 3.5;
                const offsetX = 100;
                // Move UP on mobile (80) to leave room for text below, DOWN on desktop (120) for visual balance
                const offsetY = isMobile ? 80 : 120;

                const positions = [];
                // Generate points along the heart curve
                for (let t = 0; t < Math.PI * 2; t += 0.35) {
                    const hx = 16 * Math.pow(Math.sin(t), 3);
                    const hy = -(
                        13 * Math.cos(t) -
                        5 * Math.cos(2 * t) -
                        2 * Math.cos(3 * t) -
                        Math.cos(4 * t)
                    );

                    positions.push({
                        x: offsetX + hx * scaleX,
                        y: offsetY + hy * scaleY - 15,
                        s: randomRange(0.8, 1.1),
                    });
                }

                positions.forEach((pos, idx) => {
                    const nx = pos.x + randomRange(-2, 2);
                    const ny = pos.y + randomRange(-2, 2);
                    createFlower(
                        stemsGroup,
                        headsGroup,
                        nx,
                        ny,
                        pos.s,
                        idx * 0.15,
                    );
                });
            }

            /**
             * INTERACTION LOGIC
             */
            const lilyStage = document.getElementById("lily-stage");
            // Select both groups for animation triggers
            const stemsGroup = document.getElementById("stems-group");
            const headsGroup = document.getElementById("heads-group");
            let isBloomed = false;

            function bloom() {
                if (isBloomed || !stemsGroup || !headsGroup) return;
                isBloomed = true;

                stemsGroup.classList.remove("opacity-0", "scale-50");
                stemsGroup.classList.add("bloom-active");

                headsGroup.classList.remove("opacity-0", "scale-50");
                headsGroup.classList.add("bloom-active");

                setTimeout(startTypewriter, 1500);
            }

            // Initialize
            generateBouquet();

            // Desktop: Mouse Interaction (Parallax)
            document.addEventListener("mousemove", (e) => {
                if (!isBloomed || window.innerWidth < 768) return;

                const x = (e.clientX - window.innerWidth / 2) / 50;
                const y = (e.clientY - window.innerHeight / 2) / 50;

                if (lilyStage) {
                    lilyStage.style.transform = `rotateX(${-y}deg) rotateY(${x}deg)`;
                }
            });

            // Mobile/Click: Trigger Bloom
            if (lilyStage) {
                lilyStage.addEventListener("click", bloom);
                lilyStage.addEventListener("touchstart", bloom, {
                    passive: true,
                });
            }

            // Auto start bloom on ALL devices after small delay
            setTimeout(bloom, 800);

            /**
             * TYPEWRITER LOGIC
             */
            const messages = [
                "Para el amor de mi vida:",
                "Cuanto más tiempo estoy contigo más te amo.",
                "Desde el dia que se cruzaron nuestras miradas.",
                "Me enamoré locamente de ti.",
                "- I Love You!",
                "-..",
            ];

            const typeContainer = document.getElementById(
                "typewriter-container",
            );
            const cursor = document.getElementById("cursor");
            let msgIndex = 0;

            async function typeText(text: string, element: HTMLElement) {
                for (let i = 0; i < text.length; i++) {
                    element.textContent += text.charAt(i);
                    await new Promise((r) =>
                        setTimeout(r, 50 + Math.random() * 50),
                    );
                }
            }

            async function startTypewriter() {
                if (!typeContainer || !cursor) return;

                // Create a dedicated text span before the cursor
                const textSpan = document.createElement("div");
                typeContainer.insertBefore(textSpan, cursor);

                for (let i = 0; i < messages.length; i++) {
                    const line = document.createElement("p");
                    if (i === messages.length - 1)
                        line.className = "mt-4 font-bold text-rose-800"; // Signature style
                    else line.className = "mb-3";

                    textSpan.appendChild(line);

                    await typeText(messages[i], line);
                    await new Promise((r) => setTimeout(r, 800)); // Pause between lines
                }

                // Remove cursor at end
                cursor.style.display = "none";

                // Show counter
                revealCounter();
            }

            /**
             * COUNTER LOGIC
             */
            const START_DATE = new Date("2025-08-20T23:53:00+01:00"); // Spain Time ISO

            function updateCounter() {
                const now = new Date();
                const diff = now.getTime() - START_DATE.getTime();

                if (diff < 0) return; // Future date safety

                const days = Math.floor(diff / (1000 * 60 * 60 * 24));
                const hours = Math.floor(
                    (diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60),
                );
                const minutes = Math.floor(
                    (diff % (1000 * 60 * 60)) / (1000 * 60),
                );
                const seconds = Math.floor((diff % (1000 * 60)) / 1000);

                const counterEl = document.getElementById("counter");
                if (counterEl) {
                    counterEl.innerHTML = `
            <span class="mx-1">${days} <span class="text-sm">días</span></span>
            <span class="mx-1">${hours} <span class="text-sm">hr</span></span>
            <span class="mx-1">${minutes} <span class="text-sm">min</span></span>
            <span class="mx-1">${seconds} <span class="text-sm">seg</span></span>
          `;
                }
            }

            function revealCounter() {
                const section = document.getElementById("counter-section");
                if (section) {
                    section.classList.remove("opacity-0", "translate-y-4");
                    setInterval(updateCounter, 1000);
                    updateCounter(); // Immediate run
                }
            }
        </script>
    </body>
</html>
