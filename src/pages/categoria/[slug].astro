---
/**
 * Category Page - Store Module
 * Shows products filtered by category
 */
import StoreLayout from "../../modules/store/layouts/StoreLayout.astro";
import { createAdminClient } from "../../modules/auth/services/auth.service";
import { formatPrice } from "../../shared/utils";

export const prerender = true;

import {
    enrichProductsWithDiscounts,
    type ProductWithDiscount,
} from "../../shared/utils/promotions";
import { ROUTES } from "../../config";
import type { Category } from "../../shared/types";

// Generate static paths for all categories
export async function getStaticPaths() {
    const supabase = createAdminClient();
    const { data: categories } = await supabase
        .from("categories")
        .select("slug")
        .order("name");

    return (
        categories?.map((category) => ({
            params: { slug: category.slug },
        })) || []
    );
}

const { slug } = Astro.params;

if (!slug) {
    return Astro.redirect(ROUTES.PRODUCTS);
}

const supabase = createAdminClient();

// Get category
const { data: category } = await supabase
    .from("categories")
    .select("*")
    .eq("slug", slug)
    .single();

if (!category) {
    return Astro.redirect(ROUTES.PRODUCTS);
}

// Get products in this category
const { data: rawProducts } = await supabase
    .from("products")
    .select("*")
    .eq("category_id", category.id)
    .order("created_at", { ascending: false });

// Enrich products with promotion discounts
const products = await enrichProductsWithDiscounts(rawProducts || []);

// Get all categories for filter
const { data: categories } = await supabase
    .from("categories")
    .select("*")
    .order("name");
---

<StoreLayout title={`${category.name} | FashionMarket`}>
    <div class="min-h-screen bg-slate-950">
        <!-- Breadcrumb -->
        <div class="bg-black border-b border-slate-800">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
                <nav class="flex items-center gap-2 text-sm">
                    <a
                        href={ROUTES.HOME}
                        class="text-slate-400 hover:text-white transition-colors"
                        >Inicio</a
                    >
                    <span class="text-slate-600">/</span>
                    <a
                        href={ROUTES.PRODUCTS}
                        class="text-slate-400 hover:text-white transition-colors"
                        >Productos</a
                    >
                    <span class="text-slate-600">/</span>
                    <span class="text-white font-medium">{category.name}</span>
                </nav>
            </div>
        </div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
            <div class="flex flex-col lg:flex-row gap-8">
                <!-- Sidebar -->
                <aside class="lg:w-64 flex-shrink-0">
                    <div class="bg-slate-900 p-6 border border-slate-800">
                        <h3 class="font-display text-lg text-white mb-4">
                            Categorias
                        </h3>
                        <ul class="space-y-2">
                            <li>
                                <a
                                    href={ROUTES.PRODUCTS}
                                    class="block py-2 text-slate-400 hover:text-white transition-colors"
                                >
                                    Todas las categorias
                                </a>
                            </li>
                            {
                                categories?.map((cat: Category) => (
                                    <li>
                                        <a
                                            href={ROUTES.CATEGORY(cat.slug)}
                                            class={`block py-2 ${cat.id === category.id ? "text-white font-medium pl-2 border-l-2 border-accent" : "text-slate-400 hover:text-white transition-colors"}`}
                                        >
                                            {cat.name}
                                        </a>
                                    </li>
                                ))
                            }
                        </ul>
                    </div>
                </aside>

                <!-- Products Grid -->
                <div class="flex-1">
                    <div class="flex items-center justify-between mb-8">
                        <h1 class="font-display text-3xl text-white">
                            {category.name}
                        </h1>
                        <p class="text-slate-400">
                            {products?.length || 0} productos
                        </p>
                    </div>

                    {
                        products && products.length > 0 ? (
                            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                                {products.map(
                                    (product: ProductWithDiscount) => (
                                        <a
                                            href={ROUTES.PRODUCT_DETAIL(
                                                product.slug,
                                            )}
                                            class="group bg-slate-900 border border-slate-800 hover:border-accent transition-all duration-300"
                                        >
                                            <div class="aspect-[3/4] bg-slate-800 overflow-hidden relative">
                                                {product.images?.[0] ? (
                                                    <img
                                                        src={product.images[0]}
                                                        alt={product.name}
                                                        class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                                                    />
                                                ) : (
                                                    <div class="w-full h-full flex items-center justify-center text-slate-600">
                                                        <svg
                                                            class="h-16 w-16"
                                                            fill="none"
                                                            viewBox="0 0 24 24"
                                                            stroke="currentColor"
                                                        >
                                                            <path
                                                                stroke-linecap="round"
                                                                stroke-linejoin="round"
                                                                stroke-width="1"
                                                                d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14"
                                                            />
                                                        </svg>
                                                    </div>
                                                )}
                                            </div>
                                            <div class="p-4">
                                                <p class="text-xs text-slate-400 uppercase tracking-wider mb-1">
                                                    {category.name}
                                                </p>
                                                <h3 class="font-display text-lg text-white group-hover:text-accent transition-colors">
                                                    {product.name}
                                                </h3>
                                                <div class="mt-2">
                                                    {product.discountedPrice ? (
                                                        <>
                                                            <p class="text-slate-400 line-through text-sm">
                                                                {formatPrice(
                                                                    product.price,
                                                                )}
                                                            </p>
                                                            <p class="text-accent font-bold text-lg">
                                                                {formatPrice(
                                                                    product.discountedPrice,
                                                                )}
                                                            </p>
                                                            <span class="inline-block mt-1 px-2 py-0.5 bg-accent/20 text-accent text-xs font-medium rounded">
                                                                {
                                                                    product.promotionTitle
                                                                }
                                                            </span>
                                                        </>
                                                    ) : (
                                                        <p class="text-white font-bold text-lg">
                                                            {formatPrice(
                                                                product.price,
                                                            )}
                                                        </p>
                                                    )}
                                                </div>
                                                {product.stock === 0 && (
                                                    <p class="mt-1 text-sm text-red-500">
                                                        Agotado
                                                    </p>
                                                )}
                                            </div>
                                        </a>
                                    ),
                                )}
                            </div>
                        ) : (
                            <div class="text-center py-16 bg-slate-900 border border-slate-800">
                                <svg
                                    class="mx-auto h-16 w-16 text-slate-600 mb-4"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="1"
                                        d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"
                                    />
                                </svg>
                                <h3 class="font-display text-xl text-white mb-2">
                                    No hay productos
                                </h3>
                                <p class="text-slate-400 mb-6">
                                    No hay productos en esta categoria todavia
                                </p>
                                <a
                                    href={ROUTES.PRODUCTS}
                                    class="px-6 py-2 bg-accent text-white font-medium hover:bg-red-700 transition-colors inline-block"
                                >
                                    Ver todos los productos
                                </a>
                            </div>
                        )
                    }
                </div>
            </div>
        </div>
    </div>
</StoreLayout>
