---
/**
 * Ofertas (Sale) Page
 * Shows products with active promotions (discounts >= 15%)
 */
import StoreLayout from "../modules/store/layouts/StoreLayout.astro";
import { getAllProductsForSale } from "../modules/store/services/catalog.service";
import { formatPrice } from "../shared/utils";
import { enrichProductsWithDiscounts } from "../shared/utils/promotions";
import { ROUTES } from "../config";
import type { ProductWithDiscount } from "../shared/utils/promotions";

// Get all products and enrich with discounts
const { data: rawProducts } = await getAllProductsForSale();
const enrichedProducts = await enrichProductsWithDiscounts(rawProducts || []);

// Filter products that have discounts >= 15%
const saleProducts = enrichedProducts.filter((product) => {
    if (!product.discountedPrice) return false;
    const discountPercentage =
        ((product.price - product.discountedPrice) / product.price) * 100;
    return discountPercentage >= 15;
});

const SIZES = ["XS", "S", "M", "L", "XL", "XXL"];
---

<StoreLayout
    title="Ofertas | FashionMarket"
    description="Las mejores ofertas en moda masculina"
>
    <!-- Hero -->
    <section
        class="bg-gradient-to-br from-accent via-accent-600 to-black text-white py-16 lg:py-24"
    >
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <!-- Breadcrumb -->
            <nav class="flex items-center gap-2 text-sm mb-8">
                <a
                    href={ROUTES.HOME}
                    class="text-white/70 hover:text-white transition-colors"
                    >Inicio</a
                >
                <span class="text-white/50">/</span>
                <span class="text-white font-medium">Ofertas</span>
            </nav>

            <div class="flex items-center gap-4 mb-4">
                <svg
                    class="w-12 h-12"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                    ></path>
                </svg>
                <h1
                    class="font-display text-display-lg lg:text-display-xl uppercase"
                >
                    OFERTAS
                </h1>
            </div>
            <p class="mt-4 text-white/90 max-w-2xl text-lg">
                Descuentos exclusivos en una selección de productos. Aprovecha
                antes de que se acaben.
            </p>
        </div>
    </section>

    <!-- Catalog -->
    <div class="bg-slate-50 min-h-screen">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-12">
            <!-- Header -->
            <div
                class="flex items-center justify-between mb-6 pb-4 border-b border-slate-200"
            >
                <h2
                    class="font-bold text-xl text-black uppercase tracking-wide"
                >
                    Productos en Oferta
                </h2>
                <span class="text-slate-500 text-sm">
                    {saleProducts?.length || 0} productos
                </span>
            </div>

            {
                saleProducts && saleProducts.length > 0 ? (
                    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-6">
                        {saleProducts.map((product: ProductWithDiscount) => {
                            const discountPercentage = Math.round(
                                ((product.price -
                                    (product.discountedPrice ||
                                        product.price)) /
                                    product.price) *
                                    100,
                            );

                            return (
                                <a
                                    href={ROUTES.PRODUCT_DETAIL(product.slug)}
                                    class="group bg-white border border-slate-100 hover:border-accent transition-all duration-300"
                                >
                                    <div class="relative aspect-[3/4] bg-slate-100 overflow-hidden">
                                        {product.images?.[0] ? (
                                            <img
                                                src={product.images[0]}
                                                alt={product.name}
                                                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                                                loading="lazy"
                                            />
                                        ) : (
                                            <div class="w-full h-full flex items-center justify-center text-slate-300">
                                                <svg
                                                    class="h-16 w-16"
                                                    fill="none"
                                                    viewBox="0 0 24 24"
                                                    stroke="currentColor"
                                                >
                                                    <path
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                        stroke-width="1"
                                                        d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                                                    />
                                                </svg>
                                            </div>
                                        )}

                                        {/* Sale Badge */}
                                        <span class="absolute top-3 left-3 px-3 py-1.5 bg-accent text-white text-sm font-bold uppercase shadow-lg">
                                            -{discountPercentage}%
                                        </span>

                                        {/* Quick View Overlay */}
                                        <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors duration-300 flex items-center justify-center">
                                            <span class="px-4 py-2 bg-white text-black font-bold text-xs uppercase tracking-wider opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-4 group-hover:translate-y-0">
                                                Ver Producto
                                            </span>
                                        </div>
                                    </div>
                                    <div class="p-4">
                                        {product.promotionTitle && (
                                            <span class="text-xs text-accent uppercase tracking-wider font-semibold block mb-1">
                                                {product.promotionTitle}
                                            </span>
                                        )}
                                        <h3 class="font-semibold text-black group-hover:text-accent transition-colors line-clamp-1">
                                            {product.name}
                                        </h3>
                                        <div class="mt-2 flex items-center gap-2">
                                            <span class="font-bold text-accent text-lg">
                                                {formatPrice(
                                                    product.discountedPrice ||
                                                        product.price,
                                                )}
                                            </span>
                                            <span class="text-sm text-slate-400 line-through">
                                                {formatPrice(product.price)}
                                            </span>
                                        </div>
                                    </div>
                                </a>
                            );
                        })}
                    </div>
                ) : (
                    <div class="text-center py-20 bg-white border border-slate-200">
                        <svg
                            class="mx-auto h-20 w-20 text-slate-300"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="1"
                                d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                            />
                        </svg>
                        <h3 class="mt-6 font-display text-2xl text-black">
                            No hay ofertas activas
                        </h3>
                        <p class="mt-2 text-slate-500">
                            No hay productos en oferta en este momento. Vuelve
                            pronto.
                        </p>
                        <a
                            href={ROUTES.PRODUCTS}
                            class="inline-block mt-6 px-8 py-3 bg-black hover:bg-accent text-white font-bold uppercase tracking-wider transition-colors"
                        >
                            Ver Todos los Productos
                        </a>
                    </div>
                )
            }
        </div>
    </div>
</StoreLayout>
