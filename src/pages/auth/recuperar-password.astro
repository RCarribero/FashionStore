---
/**
 * Recuperar contraseña
 */
import AuthLayout from "../../layouts/AuthLayout.astro";
---

<AuthLayout title="Recuperar Contraseña">
    <div class="w-full max-w-md">
        <div class="text-center mb-10">
            <h1 class="font-display text-4xl text-white mb-2">Recuperar Acceso</h1>
            <p class="text-slate-400">Te enviaremos un enlace para restablecer tu contraseña.</p>
        </div>

        <form id="recovery-form" class="space-y-6">
            <div>
                <label for="email" class="block text-sm font-medium text-slate-300 mb-2">
                    Correo Electrónico
                </label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <svg class="h-5 w-5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v9a2 2 0 002 2z" />
                        </svg>
                    </div>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        class="block w-full pl-10 bg-slate-800 border-slate-700 rounded-lg text-white placeholder-slate-500 focus:ring-accent focus:border-accent sm:text-sm"
                        placeholder="tu@email.com"
                        required
                    />
                </div>
            </div>

            <div id="error-message" class="hidden bg-red-500/10 border border-red-500/50 rounded-lg p-4">
                <p class="text-sm text-red-400 text-center"></p>
            </div>

            <div id="success-message" class="hidden bg-green-500/10 border border-green-500/50 rounded-lg p-4">
                <p class="text-sm text-green-400 text-center">
                    ¡Correo enviado! Revisa tu bandeja de entrada para continuar.
                </p>
            </div>

            <button
                type="submit"
                class="w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-accent hover:bg-red-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-accent transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
            >
                Enviar Enlace
            </button>
        </form>

        <p class="mt-8 text-center text-sm text-slate-400">
            ¿Ya tienes cuenta?
            <a href="/auth/login" class="font-medium text-accent hover:text-red-400 transition-colors">
                Inicia sesión aquí
            </a>
        </p>
    </div>
</AuthLayout>

<script>
    import { supabase } from "../../lib/supabase";

    const form = document.getElementById("recovery-form") as HTMLFormElement;
    const errorMessage = document.getElementById("error-message");
    const successMessage = document.getElementById("success-message");
    const submitBtn = form?.querySelector("button");

    let cooldownInterval: any;
    let cooldownSeconds = 0;

    const startCooldown = () => {
        if (!submitBtn) return;
        cooldownSeconds = 60;
        submitBtn.disabled = true;
        
        cooldownInterval = setInterval(() => {
            cooldownSeconds--;
            submitBtn.textContent = `Reenviar en ${cooldownSeconds}s`;
            
            if (cooldownSeconds <= 0) {
                clearInterval(cooldownInterval);
                submitBtn.disabled = false;
                submitBtn.textContent = "Enviar Enlace";
            }
        }, 1000);
    };

    form?.addEventListener("submit", async (e) => {
        e.preventDefault();
        
        if (!submitBtn) return;
        
        // Reset states
        errorMessage?.classList.add("hidden");
        successMessage?.classList.add("hidden");
        submitBtn.disabled = true;
        submitBtn.textContent = "Enviando...";

        const formData = new FormData(form);
        const email = formData.get("email") as string;

        try {
            const { error } = await supabase.auth.resetPasswordForEmail(email, {
                redirectTo: `${window.location.origin}/auth/cambiar-password`,
            });

            if (error) {
                // Handle Rate Limit specifically if 429
                if (error.status === 429) {
                    throw new Error("Demasiados intentos. Por favor espera un momento.");
                }
                throw error;
            }

            successMessage?.classList.remove("hidden");
            form.reset();
            startCooldown();
        } catch (error: any) {
            if (errorMessage) {
                errorMessage.classList.remove("hidden");
                errorMessage.querySelector("p")!.textContent = error.message || "Error al enviar el correo";
            }
            // If error, re-enable button immediately unless it was rate limit which we might want to respect too, 
            // but for UX let's let them retry or see the error
            if (error.message.includes("Demasiados intentos")) {
               startCooldown(); // Enforce client side wait too
            } else {
               submitBtn.disabled = false;
               submitBtn.textContent = "Enviar Enlace";
            }
        }
    });
</script>
