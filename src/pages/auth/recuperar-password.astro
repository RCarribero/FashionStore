---
/**
 * Recuperar contrasena
 */
import StoreLayout from "../../modules/store/layouts/StoreLayout.astro";
import { ROUTES } from "../../config";
---

<StoreLayout title="Recuperar Contrasena">
    <div
        class="min-h-screen bg-slate-950 flex items-center justify-center px-4 py-12"
    >
        <div class="max-w-md w-full">
            <!-- Header -->
            <div class="text-center mb-8">
                <h1 class="font-display text-4xl text-white mb-2">
                    Recuperar Acceso
                </h1>
                <p class="text-slate-400">
                    Te enviaremos un enlace para restablecer tu contrasena.
                </p>
            </div>

            <!-- Recovery Form -->
            <div class="bg-slate-900 border border-slate-800 p-8">
                <form id="recovery-form" class="space-y-6">
                    <!-- Email -->
                    <div>
                        <label
                            for="email"
                            class="block text-sm font-medium text-slate-300 mb-2"
                        >
                            Correo Electronico
                        </label>
                        <div class="relative">
                            <div
                                class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none"
                            >
                                <svg
                                    class="h-5 w-5 text-slate-500"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v9a2 2 0 002 2z"
                                    ></path>
                                </svg>
                            </div>
                            <input
                                type="email"
                                id="email"
                                name="email"
                                class="w-full pl-10 px-4 py-3 bg-slate-800 border border-slate-700 text-white placeholder:text-slate-500 focus:outline-none focus:border-accent transition-colors"
                                placeholder="tu@email.com"
                                required
                            />
                        </div>
                    </div>

                    <!-- Error Message -->
                    <div
                        id="error-message"
                        class="hidden p-4 bg-red-500/10 border border-red-500/50 text-red-400 text-sm"
                    >
                    </div>

                    <!-- Success Message -->
                    <div
                        id="success-message"
                        class="hidden p-4 bg-green-500/10 border border-green-500/50 text-green-400 text-sm text-center"
                    >
                        Correo enviado! Revisa tu bandeja de entrada para
                        continuar.
                    </div>

                    <!-- Submit Button -->
                    <button
                        type="submit"
                        id="submit-btn"
                        class="w-full px-6 py-4 bg-accent hover:bg-red-700 text-white font-bold uppercase tracking-wider transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                    >
                        Enviar Enlace
                    </button>
                </form>

                <!-- Login Link -->
                <div class="mt-6 text-center">
                    <p class="text-slate-400">
                        Ya tienes cuenta?
                        <a
                            href="/auth/login"
                            class="text-accent hover:text-red-400 font-semibold"
                        >
                            Inicia sesion aqui
                        </a>
                    </p>
                </div>
            </div>

            <!-- Back to Home -->
            <div class="mt-6 text-center">
                <a
                    href={ROUTES.HOME}
                    class="text-slate-400 hover:text-white transition-colors"
                >
                    Volver a la tienda
                </a>
            </div>
        </div>
    </div>
</StoreLayout>

<script>
    import { supabase } from "../../lib/supabase";

    const form = document.getElementById("recovery-form") as HTMLFormElement;
    const errorMessage = document.getElementById(
        "error-message",
    ) as HTMLDivElement;
    const successMessage = document.getElementById(
        "success-message",
    ) as HTMLDivElement;
    const submitBtn = document.getElementById(
        "submit-btn",
    ) as HTMLButtonElement;

    let cooldownInterval: any;
    let cooldownSeconds = 0;

    const startCooldown = () => {
        if (!submitBtn) return;
        cooldownSeconds = 60;
        submitBtn.disabled = true;

        cooldownInterval = setInterval(() => {
            cooldownSeconds--;
            submitBtn.textContent = `Reenviar en ${cooldownSeconds}s`;

            if (cooldownSeconds <= 0) {
                clearInterval(cooldownInterval);
                submitBtn.disabled = false;
                submitBtn.textContent = "Enviar Enlace";
            }
        }, 1000);
    };

    form?.addEventListener("submit", async (e) => {
        e.preventDefault();

        if (!submitBtn) return;

        // Reset states
        errorMessage?.classList.add("hidden");
        successMessage?.classList.add("hidden");
        submitBtn.disabled = true;
        submitBtn.textContent = "Enviando...";

        const formData = new FormData(form);
        const email = formData.get("email") as string;

        try {
            console.log("Sending recovery email to:", email);
            console.log(
                "Redirect URL:",
                `${window.location.origin}/auth/cambiar-password`,
            );

            const { error } = await supabase.auth.resetPasswordForEmail(email, {
                redirectTo: `${window.location.origin}/auth/cambiar-password`,
            });

            if (error) {
                console.error("Supabase error:", error);
                if (error.status === 429) {
                    throw new Error(
                        "Demasiados intentos. Por favor espera un momento.",
                    );
                }
                throw new Error(error.message || "Error de autenticacion");
            }

            successMessage?.classList.remove("hidden");
            form.reset();
            startCooldown();
        } catch (error: any) {
            console.error("Recovery error:", error);
            errorMessage.textContent =
                error.message || "Error al enviar el correo";
            errorMessage.classList.remove("hidden");

            if (error.message?.includes("Demasiados intentos")) {
                startCooldown();
            } else {
                submitBtn.disabled = false;
                submitBtn.textContent = "Enviar Enlace";
            }
        }
    });
</script>
