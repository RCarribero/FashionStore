---
/**
 * Cambiar contraseña (Reset flow)
 */
import StoreLayout from "../../modules/store/layouts/StoreLayout.astro";
---

<StoreLayout title="Nueva Contraseña">
    <div class="w-full max-w-md">
        <div class="text-center mb-10">
            <h1 class="font-display text-4xl text-white mb-2">Nueva Contraseña</h1>
            <p class="text-slate-400">Introduce tu nueva contraseña para acceder.</p>
        </div>

        <form id="reset-form" class="space-y-6">
            <div>
                <label for="password" class="block text-sm font-medium text-slate-300 mb-2">
                    Nueva Contraseña
                </label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <svg class="h-5 w-5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                        </svg>
                    </div>
                    <input
                        type="password"
                        id="password"
                        name="password"
                        class="block w-full pl-10 bg-slate-800 border-slate-700 rounded-lg text-white placeholder-slate-500 focus:ring-accent focus:border-accent sm:text-sm"
                        placeholder="••••••••"
                        required
                        minlength="6"
                    />
                </div>
            </div>

            <div>
                <label for="confirm_password" class="block text-sm font-medium text-slate-300 mb-2">
                    Confirmar Contraseña
                </label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <svg class="h-5 w-5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                        </svg>
                    </div>
                    <input
                        type="password"
                        id="confirm_password"
                        name="confirm_password"
                        class="block w-full pl-10 bg-slate-800 border-slate-700 rounded-lg text-white placeholder-slate-500 focus:ring-accent focus:border-accent sm:text-sm"
                        placeholder="••••••••"
                        required
                        minlength="6"
                    />
                </div>
            </div>

            <div id="error-message" class="hidden bg-red-500/10 border border-red-500/50 rounded-lg p-4">
                <p class="text-sm text-red-400 text-center"></p>
            </div>

            <button
                type="submit"
                class="w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-accent hover:bg-red-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-accent transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
            >
                Actualizar Contraseña
            </button>
        </form>
    </div>
</StoreLayout>

<script>
    import { supabase } from "../../lib/supabase";

    const form = document.getElementById("reset-form") as HTMLFormElement;
    const errorMessage = document.getElementById("error-message");
    const submitBtn = form?.querySelector("button");

    // Strong password regex: Min 8 chars, at least 1 number, at least 1 special char
    const passwordRegex = /^(?=.*[0-9])(?=.*[!@#$%^&*])[a-zA-Z0-9!@#$%^&*]{8,}$/;

    form?.addEventListener("submit", async (e) => {
        e.preventDefault();
        
        if (!submitBtn) return;

        const formData = new FormData(form);
        const password = formData.get("password") as string;
        const confirmPassword = formData.get("confirm_password") as string;

        if (password !== confirmPassword) {
            if (errorMessage) {
                errorMessage.classList.remove("hidden");
                errorMessage.querySelector("p")!.textContent = "Las contraseñas no coinciden";
            }
            return;
        }

        if (!passwordRegex.test(password)) {
             if (errorMessage) {
                errorMessage.classList.remove("hidden");
                errorMessage.querySelector("p")!.textContent = "La contraseña debe tener al menos 8 caracteres, un número y un carácter especial (!@#$%^&*).";
            }
            return;
        }

        // Reset states
        errorMessage?.classList.add("hidden");
        submitBtn.disabled = true;
        submitBtn.textContent = "Actualizando...";

        try {
            const { error } = await supabase.auth.updateUser({ password });

            if (error) throw error;

            // Redirect to home or login logic (since updating user logs them in usually)
            window.location.href = "/";
        } catch (error: any) {
            if (errorMessage) {
                errorMessage.classList.remove("hidden");
                errorMessage.querySelector("p")!.textContent = error.message || "Error al actualizar la contraseña";
            }
            submitBtn.disabled = false;
            submitBtn.textContent = "Actualizar Contraseña";
        }
    });
</script>
