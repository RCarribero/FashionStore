---
/**
 * Login Page
 */
export const prerender = false;

import StoreLayout from "../../modules/store/layouts/StoreLayout.astro";
import { ROUTES } from "../../config";
---

<StoreLayout title="Iniciar Sesión">
    <div
        class="min-h-screen bg-slate-950 flex items-center justify-center px-4 py-12"
    >
        <div class="max-w-md w-full">
            <!-- Header -->
            <div class="text-center mb-8">
                <h1 class="font-display text-4xl text-white mb-2">
                    Iniciar Sesión
                </h1>
                <p class="text-slate-400">Accede a tu cuenta para continuar</p>
            </div>

            <!-- Demo Quick Access Panel -->
            <div class="mb-6 p-5 bg-slate-900/90 border border-accent/40 rounded-lg">
                <div class="flex items-center gap-2 mb-3">
                    <span class="w-2.5 h-2.5 bg-accent rounded-full animate-pulse"></span>
                    <span class="text-xs uppercase font-bold tracking-widest text-accent">Modo Demo Portafolio</span>
                </div>
                <p class="text-xs text-slate-400 mb-4">
                    Selecciona un perfil de prueba para acceder al instante con permisos preconfigurados:
                </p>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <button
                        type="button"
                        id="demoAdminBtn"
                        class="px-4 py-3 bg-accent text-white font-bold text-xs uppercase tracking-wider rounded hover:bg-red-700 transition-colors flex flex-col items-center text-center shadow cursor-pointer"
                    >
                        <span>👑 Administrador</span>
                        <span class="text-[10px] font-normal text-white/80">admin@fashionstore.com</span>
                    </button>
                    <button
                        type="button"
                        id="demoClientBtn"
                        class="px-4 py-3 bg-slate-800 border border-slate-700 text-white font-bold text-xs uppercase tracking-wider rounded hover:bg-slate-700 hover:border-slate-500 transition-colors flex flex-col items-center text-center shadow cursor-pointer"
                    >
                        <span>🛍️ Cliente Normal</span>
                        <span class="text-[10px] font-normal text-slate-400">cliente@fashionstore.com</span>
                    </button>
                </div>
            </div>

            <!-- Login Form -->
            <div class="bg-slate-900 border border-slate-800 p-8">
                <form id="loginForm" class="space-y-6">
                    <!-- Email -->
                    <div>
                        <label
                            for="email"
                            class="block text-sm font-medium text-slate-300 mb-2"
                        >
                            Email
                        </label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            required
                            class="w-full px-4 py-3 bg-slate-800 border border-slate-700 text-white placeholder:text-slate-500 focus:outline-none focus:border-accent transition-colors"
                            placeholder="tu@email.com"
                        />
                    </div>

                    <!-- Password -->
                    <div>
                        <label
                            for="password"
                            class="block text-sm font-medium text-slate-300 mb-2"
                        >
                            Contraseña
                        </label>
                        <input
                            type="password"
                            id="password"
                            name="password"
                            required
                            class="w-full px-4 py-3 bg-slate-800 border border-slate-700 text-white placeholder:text-slate-500 focus:outline-none focus:border-accent transition-colors"
                            placeholder="••••••••"
                        />
                        <div class="flex justify-end mt-1">
                            <a href="/auth/recuperar-password" class="text-xs text-slate-400 hover:text-accent transition-colors">
                                ¿Has olvidado tu contraseña?
                            </a>
                        </div>
                    </div>

                    <!-- Error Message -->
                    <div
                        id="errorMessage"
                        class="hidden p-4 bg-red-500/10 border border-red-500/50 text-red-400 text-sm"
                    >
                    </div>

                    <!-- Submit Button -->
                    <button
                        type="submit"
                        id="submitButton"
                        class="w-full px-6 py-4 bg-accent hover:bg-red-700 text-white font-bold uppercase tracking-wider transition-colors disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
                    >
                        Iniciar Sesión
                    </button>
                </form>

                <!-- Register Link -->
                <div class="mt-6 text-center">
                    <p class="text-slate-400">
                        ¿No tienes cuenta?
                        <a
                            href={ROUTES.REGISTER}
                            class="text-accent hover:text-red-400 font-semibold"
                        >
                            Regístrate aquí
                        </a>
                    </p>
                </div>
            </div>

            <!-- Back to Home -->
            <div class="mt-6 text-center">
                <a
                    href={ROUTES.HOME}
                    class="text-slate-400 hover:text-white transition-colors"
                >
                    ← Volver a la tienda
                </a>
            </div>
        </div>
    </div>
</StoreLayout>

<script>
    import { login } from "../../modules/auth/services/auth-client.service";
    import { ROUTES } from "../../config";

    const form = document.getElementById("loginForm") as HTMLFormElement;
    const submitButton = document.getElementById("submitButton") as HTMLButtonElement;
    const errorMessage = document.getElementById("errorMessage") as HTMLDivElement;
    const demoAdminBtn = document.getElementById("demoAdminBtn") as HTMLButtonElement;
    const demoClientBtn = document.getElementById("demoClientBtn") as HTMLButtonElement;
    const emailInput = document.getElementById("email") as HTMLInputElement;
    const passwordInput = document.getElementById("password") as HTMLInputElement;

    demoAdminBtn?.addEventListener("click", async () => {
        if (emailInput && passwordInput) {
            emailInput.value = "admin@fashionstore.com";
            passwordInput.value = "admin123";
        }
        submitButton.disabled = true;
        submitButton.textContent = "Iniciando como Admin...";
        try {
            await login({ email: "admin@fashionstore.com", password: "admin123" });
            window.location.href = "/gestion-fm";
        } catch (e: any) {
            window.location.href = "/gestion-fm";
        }
    });

    demoClientBtn?.addEventListener("click", async () => {
        if (emailInput && passwordInput) {
            emailInput.value = "cliente@fashionstore.com";
            passwordInput.value = "cliente123";
        }
        submitButton.disabled = true;
        submitButton.textContent = "Iniciando como Cliente...";
        try {
            await login({ email: "cliente@fashionstore.com", password: "cliente123" });
            window.location.href = ROUTES.HOME;
        } catch (e: any) {
            window.location.href = ROUTES.HOME;
        }
    });

    form?.addEventListener("submit", async (e) => {
        e.preventDefault();

        const formData = new FormData(form);
        const email = (formData.get("email") as string) || "admin@fashionstore.com";
        const password = (formData.get("password") as string) || "demo";

        errorMessage.classList.add("hidden");
        submitButton.disabled = true;
        submitButton.textContent = "Iniciando sesión...";

        try {
            await login({ email, password });
            if (email.toLowerCase().includes("admin")) {
                window.location.href = "/gestion-fm";
            } else {
                window.location.href = ROUTES.HOME;
            }
        } catch (error: any) {
            errorMessage.textContent = error.message || "Error al iniciar sesión";
            errorMessage.classList.remove("hidden");
            submitButton.disabled = false;
            submitButton.textContent = "Iniciar Sesión";
        }
    });
</script>
