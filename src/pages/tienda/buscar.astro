---
/**
 * Search Results Page
 */
export const prerender = false;

import StoreLayout from "../../modules/store/layouts/StoreLayout.astro";
import { createClient } from "@supabase/supabase-js";
import { formatPrice } from "../../shared/utils";
import { ROUTES } from "../../config";

const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.SUPABASE_SERVICE_ROLE_KEY,
);

const query = Astro.url.searchParams.get("q") || "";

let products = [];
if (query.trim() !== "") {
    const searchPattern = `%${query}%`;
    const { data } = await supabase
        .from("products")
        .select("*, category:categories(*)")
        .or(`name.ilike.${searchPattern},description.ilike.${searchPattern}`)
        .order("name");
    products = data || [];
}
---

<StoreLayout title={`Buscar: ${query}`}>
    <div class="min-h-screen bg-slate-950">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
            <!-- Search Header -->
            <div class="mb-8">
                <h1 class="text-3xl font-display text-white mb-2">
                    Resultados de búsqueda
                </h1>
                <p class="text-slate-400">
                    {query && `Buscando: "${query}"`}
                </p>
                <p class="text-sm text-slate-500 mt-1">
                    {products.length}
                    {
                        products.length === 1
                            ? "producto encontrado"
                            : "productos encontrados"
                    }
                </p>
            </div>

            {
                products.length > 0 ? (
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                        {products.map((product: any) => (
                            <a
                                href={ROUTES.PRODUCT_DETAIL(product.slug)}
                                class="group bg-slate-900 border border-slate-800 hover:border-accent transition-all duration-300 overflow-hidden"
                            >
                                <div class="aspect-[3/4] bg-slate-800 overflow-hidden relative">
                                    {product.images?.[0] ? (
                                        <img
                                            src={product.images[0]}
                                            alt={product.name}
                                            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                                        />
                                    ) : (
                                        <div class="w-full h-full flex items-center justify-center text-slate-600">
                                            <svg
                                                class="h-16 w-16"
                                                fill="none"
                                                viewBox="0 0 24 24"
                                                stroke="currentColor"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="1"
                                                    d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                                                />
                                            </svg>
                                        </div>
                                    )}
                                </div>
                                <div class="p-4">
                                    {product.category && (
                                        <p class="text-xs text-slate-400 uppercase tracking-wider mb-1">
                                            {product.category.name}
                                        </p>
                                    )}
                                    <h3 class="font-display text-lg text-white group-hover:text-accent transition-colors line-clamp-2">
                                        {product.name}
                                    </h3>
                                    <p class="mt-2 text-white font-bold text-lg">
                                        {formatPrice(product.price)}
                                    </p>
                                </div>
                            </a>
                        ))}
                    </div>
                ) : (
                    <div class="text-center py-16 bg-slate-900 border border-slate-800 rounded-lg">
                        <svg
                            class="mx-auto h-16 w-16 text-slate-600 mb-4"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="1"
                                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                            />
                        </svg>
                        <h3 class="font-display text-xl text-white mb-2">
                            No se encontraron productos
                        </h3>
                        <p class="text-slate-400 mb-6">
                            {query
                                ? `No hay resultados para "${query}"`
                                : "Introduce un término de búsqueda"}
                        </p>
                        <a
                            href={ROUTES.PRODUCTS}
                            class="px-6 py-2 bg-accent text-white font-medium hover:bg-red-700 transition-colors inline-block"
                        >
                            Ver todos los productos
                        </a>
                    </div>
                )
            }
        </div>
    </div>
</StoreLayout>
