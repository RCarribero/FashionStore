---
/**
 * Outlet Page
 * Shows products with heavy discounts (>= 30%)
 */
import StoreLayout from "../../modules/store/layouts/StoreLayout.astro";
import { getAllProductsForSale } from "../../modules/store/services/catalog.service";
import { formatPrice } from "../../shared/utils";
import { enrichProductsWithDiscounts } from "../../shared/utils/promotions";
import { ROUTES } from "../../config";
import type { ProductWithDiscount } from "../../shared/utils/promotions";

// Get all products and enrich with discounts
const { data: rawProducts } = await getAllProductsForSale();
const enrichedProducts = await enrichProductsWithDiscounts(rawProducts || []);

// Filter products that have discounts >= 30%
const outletProducts = enrichedProducts.filter((product) => {
    if (!product.discountedPrice) return false;
    const discountPercentage =
        ((product.price - product.discountedPrice) / product.price) * 100;
    return discountPercentage >= 30;
});
---

<StoreLayout
    title="Outlet | FashionMarket"
    description="Descuentos increíbles en productos seleccionados"
>
    <!-- Hero -->
    <section
        class="bg-black text-white py-16 lg:py-24 relative overflow-hidden"
    >
        <!-- Animated background stripes -->
        <div class="absolute inset-0 opacity-10">
            <div
                class="absolute inset-0"
                style="background: repeating-linear-gradient(45deg, #ff0000 0px, #ff0000 20px, transparent 20px, transparent 40px);"
            >
            </div>
        </div>

        <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <!-- Breadcrumb -->
            <nav class="flex items-center gap-2 text-sm mb-8">
                <a
                    href={ROUTES.HOME}
                    class="text-slate-400 hover:text-white transition-colors"
                    >Inicio</a
                >
                <span class="text-slate-600">/</span>
                <span class="text-accent font-medium">Outlet</span>
            </nav>

            <div class="flex items-center gap-4 mb-4">
                <div
                    class="px-6 py-2 bg-accent text-white font-black text-3xl uppercase transform -rotate-2 shadow-xl"
                >
                    OUTLET
                </div>
            </div>
            <h1
                class="font-display text-display-lg lg:text-display-xl uppercase mb-4"
            >
                SUPER <span class="text-accent">DESCUENTOS</span>
            </h1>
            <p class="mt-4 text-slate-300 max-w-2xl text-lg">
                Hasta 70% de descuento en productos seleccionados. Stock
                limitado.
            </p>
        </div>
    </section>

    <!-- Catalog -->
    <div class="bg-slate-50 min-h-screen">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-12">
            <!-- Header -->
            <div
                class="flex items-center justify-between mb-6 pb-4 border-b border-slate-200"
            >
                <h2
                    class="font-bold text-xl text-black uppercase tracking-wide"
                >
                    Productos Outlet
                </h2>
                <span class="text-slate-500 text-sm">
                    {outletProducts?.length || 0} productos
                </span>
            </div>

            {
                outletProducts && outletProducts.length > 0 ? (
                    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-6">
                        {outletProducts.map((product: ProductWithDiscount) => {
                            const discountPercentage = Math.round(
                                ((product.price -
                                    (product.discountedPrice ||
                                        product.price)) /
                                    product.price) *
                                    100,
                            );

                            return (
                                <a
                                    href={ROUTES.PRODUCT_DETAIL(product.slug)}
                                    class="group bg-white border-2 border-accent hover:border-black transition-all duration-300 shadow-lg hover:shadow-xl"
                                >
                                    <div class="relative aspect-[3/4] bg-slate-100 overflow-hidden">
                                        {product.images?.[0] ? (
                                            <img
                                                src={product.images[0]}
                                                alt={product.name}
                                                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                                                loading="lazy"
                                            />
                                        ) : (
                                            <div class="w-full h-full flex items-center justify-center text-slate-300">
                                                <svg
                                                    class="h-16 w-16"
                                                    fill="none"
                                                    viewBox="0 0 24 24"
                                                    stroke="currentColor"
                                                >
                                                    <path
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                        stroke-width="1"
                                                        d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                                                    />
                                                </svg>
                                            </div>
                                        )}

                                        {/* Outlet Badge */}
                                        <div class="absolute top-3 right-3 bg-black text-white px-3 py-1 font-black text-xs uppercase shadow-lg">
                                            OUTLET
                                        </div>
                                        <div class="absolute top-3 left-3 bg-accent text-white px-3 py-2 font-black text-lg shadow-lg">
                                            -{discountPercentage}%
                                        </div>

                                        {/* Quick View Overlay */}
                                        <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors duration-300 flex items-center justify-center">
                                            <span class="px-4 py-2 bg-white text-black font-bold text-xs uppercase tracking-wider opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-4 group-hover:translate-y-0">
                                                Ver Producto
                                            </span>
                                        </div>
                                    </div>
                                    <div class="p-4 bg-gradient-to-br from-white to-slate-50">
                                        {product.promotionTitle && (
                                            <span class="inline-block px-2 py-0.5 bg-accent/10 text-accent text-xs font-bold uppercase tracking-wider mb-2">
                                                {product.promotionTitle}
                                            </span>
                                        )}
                                        <h3 class="font-semibold text-black group-hover:text-accent transition-colors line-clamp-1">
                                            {product.name}
                                        </h3>
                                        <div class="mt-2 flex items-baseline gap-2">
                                            <span class="font-black text-accent text-xl">
                                                {formatPrice(
                                                    product.discountedPrice ||
                                                        product.price,
                                                )}
                                            </span>
                                            <span class="text-sm text-slate-500 line-through font-medium">
                                                {formatPrice(product.price)}
                                            </span>
                                        </div>
                                    </div>
                                </a>
                            );
                        })}
                    </div>
                ) : (
                    <div class="text-center py-20 bg-white border border-slate-200">
                        <svg
                            class="mx-auto h-20 w-20 text-slate-300"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="1"
                                d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"
                            />
                        </svg>
                        <h3 class="mt-6 font-display text-2xl text-black">
                            No hay productos en Outlet
                        </h3>
                        <p class="mt-2 text-slate-500">
                            No hay productos en outlet en este momento. Revisa
                            nuestras ofertas regulares.
                        </p>
                        <a
                            href={ROUTES.SALE}
                            class="inline-block mt-6 px-8 py-3 bg-accent hover:bg-accent-600 text-white font-bold uppercase tracking-wider transition-colors"
                        >
                            Ver Ofertas
                        </a>
                    </div>
                )
            }
        </div>
    </div>
</StoreLayout>
