---
/**
 * Admin Categories List
 */
export const prerender = false;

import AdminLayout from "../../../modules/admin/layouts/AdminLayout.astro";
import { supabase } from "../../../lib/supabase";
import CategoryImageUploader from "../../../modules/admin/components/CategoryImageUploader";

const { data: categories } = await supabase
    .from("categories")
    .select("*, products(count)")
    .order("name");
---

<AdminLayout title="Categorias">
    <!-- Inline Notification Container -->
    <div
        id="notification-area"
        class="fixed top-4 right-4 z-50 transition-all duration-300 transform translate-x-full opacity-0"
    >
        <div
            id="notification-content"
            class="px-4 py-3 rounded shadow-lg text-white font-medium text-sm flex items-center gap-2"
        >
            <!-- Content injected via JS -->
        </div>
    </div>
    <div class="flex justify-between items-center mb-6">
        <p class="text-slate-400">{categories?.length || 0} categorias</p>
        <button
            id="addCategory"
            class="px-4 py-2 bg-accent hover:bg-red-700 text-white font-medium transition-colors"
        >
            + Nueva Categoria
        </button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {
            categories?.map((category) => (
                <div class="bg-slate-900 border border-slate-800 p-6 relative group">
                    {category.image && (
                        <img
                            src={category.image}
                            alt=""
                            class="w-full h-32 object-cover mb-4 rounded"
                        />
                    )}
                    <h3 class="text-lg font-bold text-white">
                        {category.name}
                    </h3>
                    <p class="text-slate-400 text-sm mt-1">{category.slug}</p>
                    <p class="text-slate-500 text-xs mt-2">
                        {category.products?.[0]?.count || 0} productos
                    </p>

                    <div class="absolute top-4 right-4 opacity-0 group-hover:opacity-100 transition-opacity flex gap-2">
                        <button
                            data-edit={JSON.stringify(category)}
                            class="p-2 bg-slate-800 hover:bg-slate-700 text-white rounded"
                        >
                            <svg
                                class="w-4 h-4"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"
                                />
                            </svg>
                        </button>
                        <button
                            data-delete={category.id}
                            class="p-2 bg-red-500/20 hover:bg-red-500/40 text-red-400 rounded"
                        >
                            <svg
                                class="w-4 h-4"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                                />
                            </svg>
                        </button>
                    </div>
                </div>
            ))
        }
    </div>

    <!-- Custom Delete Modal -->
    <div
        id="deleteModal"
        class="fixed inset-0 bg-black/70 hidden items-center justify-center z-50"
    >
        <div
            class="bg-slate-900 border border-slate-800 p-6 w-full max-w-md mx-4 rounded-lg"
        >
            <div class="text-center">
                <div
                    class="w-16 h-16 mx-auto mb-4 bg-red-500/20 rounded-full flex items-center justify-center"
                >
                    <svg
                        class="w-8 h-8 text-red-500"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                        ></path>
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-white mb-2">
                    Eliminar Categoría
                </h3>
                <p class="text-slate-400 mb-1">
                    ¿Seguro que quieres eliminar esta categoría?
                </p>
                <p id="deleteItemName" class="text-white font-medium mb-6"></p>
            </div>
            <div class="flex gap-3">
                <button
                    id="confirmDelete"
                    class="flex-1 bg-red-600 hover:bg-red-700 text-white py-3 font-medium rounded transition-colors"
                >
                    Si, eliminar
                </button>
                <button
                    id="cancelDelete"
                    class="flex-1 bg-slate-800 hover:bg-slate-700 text-white py-3 font-medium rounded transition-colors"
                >
                    Cancelar
                </button>
            </div>
        </div>
    </div>

    <!-- Modal -->
    <div
        id="categoryModal"
        class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50"
    >
        <div
            class="bg-slate-900 border border-slate-800 p-6 w-full max-w-md mx-4"
        >
            <h3 id="modalTitle" class="text-lg font-bold text-white mb-4">
                Nueva Categoria
            </h3>
            <form id="categoryForm" class="space-y-4">
                <input type="hidden" id="categoryId" />
                <div>
                    <label class="block text-sm text-slate-400 mb-1"
                        >Nombre</label
                    >
                    <input
                        type="text"
                        id="categoryName"
                        required
                        class="w-full bg-slate-800 border border-slate-700 text-white px-4 py-2"
                    />
                </div>
                <div>
                    <label class="block text-sm text-slate-400 mb-1">Slug</label
                    >
                    <input
                        type="text"
                        id="categorySlug"
                        required
                        class="w-full bg-slate-800 border border-slate-700 text-white px-4 py-2"
                    />
                </div>
                <div>
                    <label class="block text-sm text-slate-400 mb-2"
                        >Imagen</label
                    >
                    <div id="imageUploaderContainer">
                        <CategoryImageUploader
                            client:load
                            inputId="categoryImage"
                        />
                    </div>
                    <input type="hidden" id="categoryImage" />
                </div>
                <div class="flex gap-3">
                    <button
                        type="submit"
                        class="flex-1 bg-accent hover:bg-red-700 text-white py-2 font-medium"
                        >Guardar</button
                    >
                    <button
                        type="button"
                        id="closeModal"
                        class="px-4 py-2 border border-slate-700 text-white hover:bg-slate-800"
                        >Cancelar</button
                    >
                </div>
            </form>
        </div>
    </div>
</AdminLayout>

<script>
    const modal = document.getElementById("categoryModal");
    const form = document.getElementById("categoryForm");

    // Notification helper
    /**
     * @param {string} message
     * @param {string} [type='success']
     */
    function showNotification(message, type = "success") {
        const area = document.getElementById("notification-area");
        const content = document.getElementById("notification-content");

        if (!area || !content) return;

        // Colors base on type
        if (type === "error") {
            content.className =
                "px-4 py-3 rounded shadow-lg text-white font-medium text-sm flex items-center gap-2 bg-red-600";
        } else {
            content.className =
                "px-4 py-3 rounded shadow-lg text-white font-medium text-sm flex items-center gap-2 bg-green-600";
        }

        content.textContent = message;

        // Show
        area.classList.remove("translate-x-full", "opacity-0");

        // Hide after 3s
        setTimeout(() => {
            area.classList.add("translate-x-full", "opacity-0");
        }, 3000);
    }

    function openModal(category) {
        const title = document.getElementById("modalTitle");
        const idInput = document.getElementById("categoryId");
        const nameInput = document.getElementById("categoryName");
        const slugInput = document.getElementById("categorySlug");
        const imageInput = document.getElementById("categoryImage");

        if (category) {
            title.textContent = "Editar Categoria";
            idInput.value = category.id;
            nameInput.value = category.name;
            slugInput.value = category.slug;
            imageInput.value = category.image || "";
        } else {
            title.textContent = "Nueva Categoria";
            form.reset();
            idInput.value = "";
        }

        modal?.classList.remove("hidden");
        modal?.classList.add("flex");
    }

    document
        .getElementById("addCategory")
        ?.addEventListener("click", () => openModal());
    document.getElementById("closeModal")?.addEventListener("click", () => {
        modal?.classList.add("hidden");
        modal?.classList.remove("flex");
    });

    document.querySelectorAll("[data-edit]").forEach((btn) => {
        btn.addEventListener("click", () => {
            const category = JSON.parse(btn.getAttribute("data-edit") || "{}");
            openModal(category);
        });
    });

    // Delete Modal Logic
    const deleteModal = document.getElementById("deleteModal");
    const itemNameEl = document.getElementById("deleteItemName");
    const confirmDeleteBtn = document.getElementById("confirmDelete");
    const cancelDeleteBtn = document.getElementById("cancelDelete");
    let deleteId = null;

    function showDeleteModal(id, name) {
        deleteId = id;
        itemNameEl.textContent = name;
        deleteModal?.classList.remove("hidden");
        deleteModal?.classList.add("flex");
    }

    function hideDeleteModal() {
        deleteModal?.classList.add("hidden");
        deleteModal?.classList.remove("flex");
        deleteId = null;
    }

    cancelDeleteBtn?.addEventListener("click", hideDeleteModal);
    deleteModal?.addEventListener("click", (e) => {
        if (e.target === deleteModal) hideDeleteModal();
    });

    confirmDeleteBtn?.addEventListener("click", async () => {
        if (!deleteId) return;

        confirmDeleteBtn.textContent = "Eliminando...";
        confirmDeleteBtn.disabled = true;

        const res = await fetch(`/api/admin/categories/${deleteId}`, {
            method: "DELETE",
        });

        if (res.ok) {
            window.location.reload();
        } else {
            hideDeleteModal();
            showNotification("Error al eliminar", "error");
            confirmDeleteBtn.textContent = "Si, eliminar";
            confirmDeleteBtn.disabled = false;
        }
    });

    document.querySelectorAll("[data-delete]").forEach((btn) => {
        btn.addEventListener("click", async () => {
            const id = btn.getAttribute("data-delete");
            // Find name in card
            const card = btn.closest(".group");
            const name =
                card?.querySelector("h3")?.textContent?.trim() ||
                "esta categoría";

            showDeleteModal(id, name);
        });
    });

    form?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const id = document.getElementById("categoryId").value;
        const data = {
            name: document.getElementById("categoryName").value,
            slug: document.getElementById("categorySlug").value,
            image: document.getElementById("categoryImage").value || null,
        };

        const res = await fetch(
            "/api/admin/categories" + (id ? `/${id}` : ""),
            {
                method: id ? "PUT" : "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(data),
            },
        );

        if (res.ok) window.location.reload();
        else {
            const errorData = await res.json();
            showNotification(
                "Error: " + (errorData.error || "Error al guardar"),
                "error",
            );
        }
    });

    // Auto-generate slug from name
    document.getElementById("categoryName")?.addEventListener("input", (e) => {
        const slugInput = document.getElementById("categorySlug");
        if (!slugInput.value || slugInput.dataset.auto !== "false") {
            slugInput.value = e.target.value
                .toLowerCase()
                .normalize("NFD")
                .replace(/[\u0300-\u036f]/g, "")
                .replace(/[^a-z0-9]+/g, "-")
                .replace(/^-|-$/g, "");
            slugInput.dataset.auto = "true";
        }
    });
    document
        .getElementById("categorySlug")
        ?.addEventListener("input", function () {
            this.dataset.auto = "false";
        });
</script>
