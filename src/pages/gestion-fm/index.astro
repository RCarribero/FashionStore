---
/**
 * Admin Dashboard - Overview of store stats
 */
export const prerender = false;

import AdminLayout from "../../modules/admin/layouts/AdminLayout.astro";
import DashboardCharts from "../../components/admin/DashboardCharts";
import CohortChart from "../../components/admin/CohortChart";
import { createClient } from "@supabase/supabase-js";
import { getStatusColor } from "../../config/constants/order-status";

const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.SUPABASE_SERVICE_ROLE_KEY,
);

const STATUS_COLOR_MAP: Record<string, string> = {
    "bg-yellow-500": "#eab308",
    "bg-indigo-500": "#6366f1",
    "bg-blue-500": "#3b82f6",
    "bg-purple-500": "#a855f7",
    "bg-purple-600": "#9333ea",
    "bg-orange-500": "#f97316",
    "bg-green-500": "#22c55e",
    "bg-red-500": "#ef4444",
    "bg-gray-500": "#6b7280"
};

// Get stats
const { count: productCount } = await supabase
    .from("products")
    .select("*", { count: "exact", head: true });
// Total Orders
const { count: orderCount } = await supabase
    .from("orders")
    .select("*", { count: "exact", head: true });
// Pending Orders
const { count: pendingOrdersCount } = await supabase
    .from("orders")
    .select("*", { count: "exact", head: true })
    .in("status", ["pending", "processing", "paid"]);

const { count: userCount } = await supabase
    .from("user_profiles")
    .select("*", { count: "exact", head: true });

// Get total revenue
const { data: revenueData } = await supabase
    .from("orders")
    .select("total_amount, created_at, status, shipping_status");

const totalRevenue =
    revenueData?.reduce((sum, o) => sum + (o.total_amount || 0), 0) || 0;

const range = Astro.url.searchParams.get("range") || "7d";
const daysToFetch = range === "30d" ? 30 : 7;

// Calculate Sales Last X Days
const dateLabels = new Array(daysToFetch)
    .fill(0)
    .map((_, i) => {
        const d = new Date();
        d.setDate(d.getDate() - i);
        return d.toISOString().split("T")[0];
    })
    .reverse();

const salesData = dateLabels.map((date) => {
    const dayTotal =
        revenueData
            ?.filter(
                (o) =>
                    o.created_at.startsWith(date) &&
                    [
                        "paid",
                        "processing",
                        "shipped",
                        "delivered",
                        "completed",
                    ].includes(o.status),
            )
            .reduce((sum, o) => sum + (o.total_amount || 0), 0) || 0;
    return dayTotal / 100; // Convert to EUR
});

const chartSalesData = {
    labels: dateLabels.map((d) =>
        new Date(d).toLocaleDateString("es-ES", {
            weekday: "short",
            day: "numeric",
        }),
    ),
    datasets: [
        {
            label: `Ventas (€) - Últimos ${daysToFetch} días`,
            data: salesData,
            borderColor: "#e11d48",
            backgroundColor: "rgba(225, 29, 72, 0.5)",
        },
    ],
};

import { ORDER_STATUSES } from "../../config/constants/order-status";

// Calculate Order Status Distribution
const allStatuses = Object.keys(ORDER_STATUSES) as (keyof typeof ORDER_STATUSES)[];
const statusCounts = allStatuses.map(
    (s) =>
        revenueData?.filter((o: any) => (o.shipping_status || o.status) === s)
            .length || 0,
);

const chartStatusData = {
    labels: allStatuses.map(s => ORDER_STATUSES[s].label),
    datasets: [
        {
            data: statusCounts,
            backgroundColor: allStatuses.map(s => {
                // Map tailwind classes to hex codes for Chart.js
                return STATUS_COLOR_MAP[ORDER_STATUSES[s].color] || "#cbd5e1";
            }),
        },
    ],
};

// Calculate Best Selling Product
// Fetch last 100 orders to analyze items
const { data: ordersWithItems } = await supabase
    .from("orders")
    .select("items")
    .order("created_at", { ascending: false })
    .limit(100);

const productSales: Record<
    string,
    { name: string; qty: number; total: number }
> = {};
ordersWithItems?.forEach((order) => {
    const items = order.items as any[];
    if (Array.isArray(items)) {
        items.forEach((item) => {
            if (!productSales[item.name]) {
                productSales[item.name] = { name: item.name, qty: 0, total: 0 };
            }
            productSales[item.name].qty += item.quantity || 1;
            productSales[item.name].total +=
                (item.price || 0) * (item.quantity || 1);
        });
    }
});

const bestSellingProduct = Object.values(productSales).sort(
    (a, b) => b.qty - a.qty,
)[0] || { name: "N/A", qty: 0 };

// Get recent orders for table
const { data: recentOrders } = await supabase
    .from("orders")
    .select("id, created_at, total_amount, shipping_status, tracking_number")
    .order("created_at", { ascending: false })
    .limit(5);

const formatPrice = (cents: number) => (cents / 100).toFixed(2) + " EUR";
const formatDate = (dateStr: string) =>
    new Date(dateStr).toLocaleDateString("es-ES", {
        day: "numeric",
        month: "short",
        hour: "2-digit",
        minute: "2-digit",
    });

// Use our constants for table colors
const getStatusColor = (status: string) => {
    const s = status as keyof typeof ORDER_STATUSES;
    return ORDER_STATUSES[s]?.bgWithOpacity || "bg-slate-700 text-slate-300";
};
---

<AdminLayout title="Dashboard">
    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
        <div class="bg-slate-900 border border-slate-800 p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-slate-400 text-sm">Ventas Totales (Mes)</p>
                    <p class="text-3xl font-bold text-white mt-1">
                        {formatPrice(totalRevenue)}
                    </p>
                </div>
                <div
                    class="w-12 h-12 bg-accent/20 rounded-lg flex items-center justify-center"
                >
                    <svg
                        class="w-6 h-6 text-accent"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                        ></path>
                    </svg>
                </div>
            </div>
        </div>

        <div class="bg-slate-900 border border-slate-800 p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-slate-400 text-sm">Pedidos Pendientes</p>
                    <p class="text-3xl font-bold text-white mt-1">
                        {pendingOrdersCount}
                    </p>
                </div>
                <div
                    class="w-12 h-12 bg-yellow-500/20 rounded-lg flex items-center justify-center"
                >
                    <svg
                        class="w-6 h-6 text-yellow-400"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                        ></path>
                    </svg>
                </div>
            </div>
        </div>

        <div class="bg-slate-900 border border-slate-800 p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-slate-400 text-sm">Producto Top</p>
                    <p
                        class="text-xl font-bold text-white mt-1 truncate max-w-[150px]"
                        title={bestSellingProduct.name}
                    >
                        {bestSellingProduct.name}
                    </p>
                    <p class="text-xs text-slate-500">
                        {bestSellingProduct.qty} unidades
                    </p>
                </div>
                <div
                    class="w-12 h-12 bg-purple-500/20 rounded-lg flex items-center justify-center"
                >
                    <svg
                        class="w-6 h-6 text-purple-400"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"
                        ></path>
                    </svg>
                </div>
            </div>
        </div>

        <div class="bg-slate-900 border border-slate-800 p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-slate-400 text-sm">Usuarios Totales</p>
                    <p class="text-3xl font-bold text-white mt-1">
                        {userCount}
                    </p>
                </div>
                <div
                    class="w-12 h-12 bg-green-500/20 rounded-lg flex items-center justify-center"
                >
                    <svg
                        class="w-6 h-6 text-green-400"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"
                        ></path>
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <!-- Period Filter -->
    <div class="flex justify-end mb-4 gap-2">
        <a 
            href="?range=7d" 
            class={`px-3 py-1 rounded text-sm font-medium transition-colors ${range !== '30d' ? 'bg-accent text-white' : 'bg-slate-800 text-slate-400 hover:text-white'}`}
        >
            7 Días
        </a>
        <a 
            href="?range=30d" 
            class={`px-3 py-1 rounded text-sm font-medium transition-colors ${range === '30d' ? 'bg-accent text-white' : 'bg-slate-800 text-slate-400 hover:text-white'}`}
        >
            30 Días
        </a>
    </div>

    <!-- Charts -->
    <DashboardCharts
        client:load
        salesData={chartSalesData}
        orderStatusData={chartStatusData}
        title={`Ventas de los Últimos ${daysToFetch} Días`}
    />

    <!-- Cohort Analysis & Margins Section -->
    <div className="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
        <div className="lg:col-span-2">
            <CohortChart 
                client:visible 
                data={{
                    labels: ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun'],
                    datasets: [
                        {
                            label: 'Retención Mes 1 (%)',
                            data: [45, 42, 48, 40, 46, 50],
                            backgroundColor: 'rgba(234, 179, 8, 0.7)', // Yellow-500
                        },
                         {
                            label: 'Retención Mes 3 (%)',
                            data: [20, 18, 22, 19, 0, 0], // Trailing zeros for future
                            backgroundColor: 'rgba(234, 179, 8, 0.3)', 
                        }
                    ]
                }} 
            />
        </div>
        <div className="bg-slate-900 border border-slate-800 p-6 rounded-lg">
            <h3 className="text-slate-400 text-sm font-medium mb-4">Métricas de Rentabilidad (Est.)</h3>
            
            <div className="space-y-6">
                <div>
                    <p className="text-2xl font-bold text-white">{(totalRevenue * 0.4 / 100).toFixed(2)} €</p>
                    <p className="text-green-400 text-sm">Beneficio Bruto (~40%)</p>
                </div>
                
                <div className="h-px bg-slate-800"></div>

                <div>
                    <p className="text-2xl font-bold text-white">{(totalRevenue / (revenueData?.length || 1) / 100).toFixed(2)} €</p>
                    <p className="text-blue-400 text-sm">Ticket Medio</p>
                </div>

                <div className="h-px bg-slate-800"></div>

                <div>
                    <p className="text-2xl font-bold text-white">2.4</p>
                    <p className="text-purple-400 text-sm">Ítems por Pedido</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Cohort Analysis & Margins Section -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
        <div class="lg:col-span-2">
            <CohortChart 
                client:visible 
                data={{
                    labels: ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun'],
                    datasets: [
                        {
                            label: 'Retención Mes 1 (%)',
                            data: [45, 42, 48, 40, 46, 50],
                            backgroundColor: 'rgba(234, 179, 8, 0.7)', // Yellow-500
                        },
                         {
                            label: 'Retención Mes 3 (%)',
                            data: [20, 18, 22, 19, 0, 0], // Trailing zeros for future
                            backgroundColor: 'rgba(234, 179, 8, 0.3)', 
                        }
                    ]
                }} 
            />
        </div>
        <div class="bg-slate-900 border border-slate-800 p-6 rounded-lg">
            <h3 class="text-slate-400 text-sm font-medium mb-4">Métricas de Rentabilidad (Est.)</h3>
            
            <div class="space-y-6">
                <div>
                    <p class="text-2xl font-bold text-white">{(totalRevenue * 0.4 / 100).toFixed(2)} €</p>
                    <p class="text-green-400 text-sm">Beneficio Bruto (~40%)</p>
                </div>
                
                <div class="h-px bg-slate-800"></div>

                <div>
                    <p class="text-2xl font-bold text-white">{(totalRevenue / (revenueData?.length || 1) / 100).toFixed(2)} €</p>
                    <p className="text-blue-400 text-sm">Ticket Medio</p>
                </div>

                <div className="h-px bg-slate-800"></div>

                <div>
                    <p className="text-2xl font-bold text-white">2.4</p>
                    <p className="text-purple-400 text-sm">Ítems por Pedido</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Orders -->
    <div class="bg-slate-900 border border-slate-800">
        <div
            class="p-6 border-b border-slate-800 flex justify-between items-center"
        >
            <h2 class="text-lg font-bold text-white">Pedidos Recientes</h2>
            <a
                href="/gestion-fm/pedidos"
                class="text-accent hover:underline text-sm">Ver todos</a
            >
        </div>
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-slate-800">
                    <tr>
                        <th
                            class="text-left px-6 py-3 text-xs font-medium text-slate-400 uppercase"
                            >Tracking</th
                        >
                        <th
                            class="text-left px-6 py-3 text-xs font-medium text-slate-400 uppercase"
                            >Fecha</th
                        >
                        <th
                            class="text-left px-6 py-3 text-xs font-medium text-slate-400 uppercase"
                            >Estado</th
                        >
                        <th
                            class="text-right px-6 py-3 text-xs font-medium text-slate-400 uppercase"
                            >Total</th
                        >
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-800">
                    {
                        recentOrders?.map((order) => (
                            <tr class="hover:bg-slate-800/50">
                                <td class="px-6 py-4">
                                    <a
                                        href={`/gestion-fm/pedidos/${order.id}`}
                                        class="font-mono text-white hover:text-accent"
                                    >
                                        {order.tracking_number ||
                                            order.id.slice(0, 8)}
                                    </a>
                                </td>
                                <td class="px-6 py-4 text-slate-400 text-sm">
                                    {formatDate(order.created_at)}
                                </td>
                                <td class="px-6 py-4">
                                    <span
                                        class={`px-2 py-1 text-xs font-medium rounded ${getStatusColor(order.shipping_status)}`}
                                    >
                                        {order.shipping_status}
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-right text-white font-medium">
                                    {formatPrice(order.total_amount)}
                                </td>
                            </tr>
                        ))
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-4">
        <a
            href="/gestion-fm/productos/nuevo"
            class="bg-slate-900 border border-slate-800 p-6 hover:border-accent transition-colors flex items-center gap-4"
        >
            <div
                class="w-10 h-10 bg-accent/20 rounded flex items-center justify-center"
            >
                <svg
                    class="w-5 h-5 text-accent"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 4v16m8-8H4"></path>
                </svg>
            </div>
            <div>
                <p class="text-white font-medium">Añadir Producto</p>
                <p class="text-slate-500 text-sm">Crear nuevo producto</p>
            </div>
        </a>
        <a
            href="/gestion-fm/categorias/nueva"
            class="bg-slate-900 border border-slate-800 p-6 hover:border-accent transition-colors flex items-center gap-4"
        >
            <div
                class="w-10 h-10 bg-accent/20 rounded flex items-center justify-center"
            >
                <svg
                    class="w-5 h-5 text-accent"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 4v16m8-8H4"></path>
                </svg>
            </div>
            <div>
                <p class="text-white font-medium">Añadir Categoria</p>
                <p class="text-slate-500 text-sm">Crear nueva categoria</p>
            </div>
        </a>
        <a
            href="/gestion-fm/pedidos"
            class="bg-slate-900 border border-slate-800 p-6 hover:border-accent transition-colors flex items-center gap-4"
        >
            <div
                class="w-10 h-10 bg-accent/20 rounded flex items-center justify-center"
            >
                <svg
                    class="w-5 h-5 text-accent"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
                    ></path>
                </svg>
            </div>
            <div>
                <p class="text-white font-medium">Gestionar Pedidos</p>
                <p class="text-slate-500 text-sm">Ver y actualizar pedidos</p>
            </div>
        </a>
        <a
            href="/gestion-fm/promociones"
            class="bg-slate-900 border border-slate-800 p-6 hover:border-accent transition-colors flex items-center gap-4"
        >
            <div
                class="w-10 h-10 bg-accent/20 rounded flex items-center justify-center"
            >
                <svg
                    class="w-5 h-5 text-accent"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"
                    ></path>
                </svg>
            </div>
            <div>
                <p class="text-white font-medium">Crear Promocion</p>
                <p class="text-slate-500 text-sm">
                    Añadir descuento automatico
                </p>
            </div>
        </a>
    </div>
</AdminLayout>
