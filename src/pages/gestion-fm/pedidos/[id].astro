---
/**
 * Admin Order Detail Page
 */
export const prerender = false;

import AdminLayout from "../../../modules/admin/layouts/AdminLayout.astro";
import { createClient } from "@supabase/supabase-js";

const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.SUPABASE_SERVICE_ROLE_KEY,
);

const { id } = Astro.params;

const { data: order } = await supabase
    .from("orders")
    .select("*, shipment_events(*)")
    .eq("id", id)
    .single();

if (!order) {
    return Astro.redirect("/gestion-fm/pedidos");
}

const { data: existingReturn } = await supabase
    .from("returns")
    .select("id, status, created_at")
    .eq("order_id", id)
    .order("created_at", { ascending: false })
    .limit(1)
    .maybeSingle();

const { data: userProfile } = await supabase
    .from("user_profiles")
    .select("first_name, last_name")
    .eq("id", order.user_id)
    .single();

const formatPrice = (cents: number) => (cents / 100).toFixed(2) + " EUR";
const formatDate = (dateStr: string) =>
    new Date(dateStr).toLocaleDateString("es-ES", {
        day: "numeric",
        month: "short",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit",
    });

const statusLabels: Record<string, string> = {
    processing: "En Preparacion",
    shipped: "Enviado",
    in_transit: "En Transito",
    out_for_delivery: "En Reparto",
    delivered: "Entregado",
};

const statusColors: Record<string, string> = {
    processing: "bg-yellow-500/20 text-yellow-400 border-yellow-500",
    shipped: "bg-blue-500/20 text-blue-400 border-blue-500",
    in_transit: "bg-purple-500/20 text-purple-400 border-purple-500",
    out_for_delivery: "bg-orange-500/20 text-orange-400 border-orange-500",
    delivered: "bg-green-500/20 text-green-400 border-green-500",
};
---

<AdminLayout title={`Pedido #${order.order_number || ""}`}>
    <!-- Inline Notification Container -->
    <div
        id="notification-area"
        class="fixed top-4 right-4 z-50 transition-all duration-300 transform translate-x-full opacity-0"
    >
        <div
            id="notification-content"
            class="px-4 py-3 rounded shadow-lg text-white font-medium text-sm flex items-center gap-2"
        >
            <!-- Content injected via JS -->
        </div>
    </div>
    <div class="mb-6">
        <a
            href="/gestion-fm/pedidos"
            class="text-slate-400 hover:text-white text-sm flex items-center gap-2"
        >
            <svg
                class="w-4 h-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 19l-7-7 7-7"></path>
            </svg>
            Volver a pedidos
        </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Order Info -->
        <div class="lg:col-span-2 space-y-6">
            <!-- Header -->
            <div class="bg-slate-900 border border-slate-800 p-6">
                <div class="flex justify-between items-start mb-4">
                    <div>
                        <p class="text-slate-400 text-sm">Tracking</p>
                        <p class="font-mono text-xl text-white font-bold">
                            #{order.order_number}
                            <span class="text-sm font-normal text-slate-400"
                                >({
                                    order.tracking_number ||
                                        order.id.slice(0, 8)
                                })</span
                            >
                        </p>
                    </div>
                    <span
                        class={`px-3 py-1 text-sm rounded border ${statusColors[order.shipping_status] || "bg-slate-700 text-slate-300"}`}
                    >
                        {
                            statusLabels[order.shipping_status] ||
                                order.shipping_status
                        }
                    </span>
                </div>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
                    <div>
                        <p class="text-slate-500">Fecha</p>
                        <p class="text-white">{formatDate(order.created_at)}</p>
                    </div>
                    <div>
                        <p class="text-slate-500">Total</p>
                        <p class="text-white font-bold">
                            {formatPrice(order.total_amount)}
                        </p>
                    </div>
                    <div>
                        <p class="text-slate-500">Cliente</p>
                        <p class="text-white">
                            {userProfile?.first_name || "N/A"}
                            {userProfile?.last_name || ""}
                        </p>
                    </div>
                    <div>
                        <p class="text-slate-500">User ID</p>
                        <p class="text-white font-mono text-xs">
                            {order.user_id?.slice(0, 8)}...
                        </p>
                    </div>
                </div>
                <div class="mt-4 flex gap-4">
                    <a
                        href={`/api/orders/${order.id}/invoice`}
                        target="_blank"
                        class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-white text-sm font-medium rounded transition-colors flex items-center gap-2"
                    >
                        <svg
                            class="w-4 h-4"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                            ></path>
                        </svg>
                        Descargar Factura
                    </a>
                </div>
            </div>

            <!-- Products -->
            <div class="bg-slate-900 border border-slate-800 p-6">
                <h3 class="font-bold text-white mb-4">
                    Productos ({order.items?.length || 0})
                </h3>
                <div class="space-y-3">
                    {
                        order.items?.map((item: any) => (
                            <div class="flex items-center gap-4 p-3 bg-slate-800/50 rounded">
                                {item.image && (
                                    <img
                                        src={item.image}
                                        alt=""
                                        class="w-12 h-12 object-cover rounded"
                                    />
                                )}
                                <div class="flex-1">
                                    <p class="text-white font-medium">
                                        {item.name}
                                    </p>
                                    <p class="text-slate-500 text-sm">
                                        Talla: {item.size} x {item.quantity}
                                    </p>
                                </div>
                                <p class="text-white font-medium">
                                    {formatPrice(item.price * item.quantity)}
                                </p>
                            </div>
                        ))
                    }
                </div>
                <div
                    class="mt-4 pt-4 border-t border-slate-800 flex justify-between"
                >
                    <span class="text-slate-400">Total</span>
                    <span class="text-white font-bold text-lg"
                        >{formatPrice(order.total_amount)}</span
                    >
                </div>
            </div>

            <!-- Shipping Info -->
            {
                order.shipping_address && (
                    <div class="bg-slate-900 border border-slate-800 p-6">
                        <h3 class="font-bold text-white mb-4">
                            Direccion de Envio
                        </h3>
                        <div class="text-slate-300 space-y-1">
                            <p>{order.shipping_address.name}</p>
                            <p>{order.shipping_address.line1}</p>
                            {order.shipping_address.line2 && (
                                <p>{order.shipping_address.line2}</p>
                            )}
                            <p>
                                {order.shipping_address.postal_code}{" "}
                                {order.shipping_address.city}
                            </p>
                            <p>{order.shipping_address.country}</p>
                        </div>
                    </div>
                )
            }
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
            <!-- Change Status -->
            <div class="bg-slate-900 border border-slate-800 p-6">
                <h3 class="font-bold text-white mb-4">Cambiar Estado</h3>
                <select
                    id="statusSelect"
                    class="w-full bg-slate-800 border border-slate-700 text-white px-4 py-3 mb-3"
                >
                    {
                        Object.entries(statusLabels).map(([value, label]) => (
                            <option
                                value={value}
                                selected={order.shipping_status === value}
                            >
                                {label}
                            </option>
                        ))
                    }
                </select>
                <button
                    id="updateStatus"
                    class="w-full bg-accent hover:bg-red-700 text-white py-2 font-medium transition-colors"
                >
                    Actualizar Estado
                </button>
            </div>

            <!-- Refunds / Actions -->
            <div class="bg-slate-900 border border-slate-800 p-6">
                <h3 class="font-bold text-white mb-4">Acciones</h3>
                {
                    existingReturn ? (
                        <a
                            href={`/gestion-fm/devoluciones/${existingReturn.id}`}
                            class="block w-full text-center bg-slate-800 hover:bg-slate-700 text-white py-2 font-medium transition-colors mb-2"
                        >
                            Revisar Devolución
                        </a>
                    ) : (
                        <button
                            id="markReturnPending"
                            class="w-full bg-red-600 hover:bg-red-700 text-white py-2 font-medium transition-colors mb-2"
                        >
                            Marcar Pendiente de Devolución
                        </button>
                    )
                }
            </div>

            <!-- Timeline -->
            <div class="bg-slate-900 border border-slate-800 p-6">
                <h3 class="font-bold text-white mb-4">Historial</h3>
                <div class="space-y-4">
                    {
                        order.shipment_events
                            ?.sort(
                                (a: any, b: any) =>
                                    new Date(b.created_at).getTime() -
                                    new Date(a.created_at).getTime(),
                            )
                            .map((event: any) => (
                                <div class="flex gap-3">
                                    <div class="w-2 h-2 mt-2 rounded-full bg-accent flex-shrink-0" />
                                    <div>
                                        <p class="text-white text-sm">
                                            {event.description}
                                        </p>
                                        <p class="text-slate-500 text-xs">
                                            {formatDate(event.created_at)}
                                        </p>
                                        {event.location && (
                                            <p class="text-slate-600 text-xs">
                                                {event.location}
                                            </p>
                                        )}
                                    </div>
                                </div>
                            ))
                    }
                    {
                        (!order.shipment_events ||
                            order.shipment_events.length === 0) && (
                            <p class="text-slate-500 text-sm">
                                Sin eventos registrados
                            </p>
                        )
                    }
                </div>
            </div>
        </div>
    </div>
</AdminLayout>

<script define:vars={{ orderId: id }}>
    // Notification helper
    /**
     * @param {string} message
     * @param {string} [type='success']
     */
    function showNotification(message, type = "success") {
        const area = document.getElementById("notification-area");
        const content = document.getElementById("notification-content");

        if (!area || !content) return;

        // Colors base on type
        if (type === "error") {
            content.className =
                "px-4 py-3 rounded shadow-lg text-white font-medium text-sm flex items-center gap-2 bg-red-600";
        } else {
            content.className =
                "px-4 py-3 rounded shadow-lg text-white font-medium text-sm flex items-center gap-2 bg-green-600";
        }

        content.textContent = message;

        // Show
        area.classList.remove("translate-x-full", "opacity-0");

        // Hide after 3s
        setTimeout(() => {
            area.classList.add("translate-x-full", "opacity-0");
        }, 3000);
    }

    document
        .getElementById("updateStatus")
        ?.addEventListener("click", async () => {
            const status = document.getElementById("statusSelect").value;

            const res = await fetch("/api/admin/orders/update-status", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ orderId, status }),
            });

            if (res.ok) {
                window.location.reload();
            } else {
                showNotification("Error al actualizar estado", "error");
            }
        });

    document
        .getElementById("markReturnPending")
        ?.addEventListener("click", async () => {
            if (
                !confirm(
                    "¿Marcar este pedido como pendiente de devolución? Se creará una solicitud para revisar en el panel de devoluciones.",
                )
            )
                return;

            const res = await fetch("/api/admin/orders/refund", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ orderId: orderId }),
            });

            if (res.ok) {
                const data = await res.json();
                if (data?.returnId) {
                    window.location.href = `/gestion-fm/devoluciones/${data.returnId}`;
                    return;
                }
                window.location.reload();
            } else {
                const data = await res.json().catch(() => ({}));
                showNotification(
                    data?.error || "Error al crear solicitud de devolución",
                    "error",
                );
            }
        });
</script>
