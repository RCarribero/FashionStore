---
/**
 * Admin Orders List
 */
export const prerender = false;

import AdminLayout from "../../../modules/admin/layouts/AdminLayout.astro";
import { createClient } from "@supabase/supabase-js";

const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.SUPABASE_SERVICE_ROLE_KEY,
);

const { data: orders } = await supabase
    .from("orders")
    .select("*")
    .order("created_at", { ascending: false });

const formatPrice = (cents: number) => (cents / 100).toFixed(2) + " EUR";
const formatDate = (dateStr: string) =>
    new Date(dateStr).toLocaleDateString("es-ES", {
        day: "numeric",
        month: "short",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit",
    });

const statusLabels: Record<string, string> = {
    processing: "En Preparación",
    shipped: "Enviado",
    in_transit: "En Tránsito",
    out_for_delivery: "En Reparto",
    delivered: "Entregado",
};

const statusColors: Record<string, string> = {
    processing: "bg-yellow-500/20 text-yellow-400",
    shipped: "bg-blue-500/20 text-blue-400",
    in_transit: "bg-purple-500/20 text-purple-400",
    out_for_delivery: "bg-orange-500/20 text-orange-400",
    delivered: "bg-green-500/20 text-green-400",
};
---

<AdminLayout title="Pedidos">
    <div class="flex justify-between items-center mb-6">
        <p class="text-slate-400">{orders?.length || 0} pedidos</p>
        <div class="flex gap-2">
            <select
                id="statusFilter"
                class="bg-slate-800 border border-slate-700 text-white px-3 py-2 text-sm"
            >
                <option value="">Todos los estados</option>
                <option value="processing">En Preparación</option>
                <option value="shipped">Enviado</option>
                <option value="in_transit">En Tránsito</option>
                <option value="out_for_delivery">En Reparto</option>
                <option value="delivered">Entregado</option>
            </select>
        </div>
    </div>

    <div class="bg-slate-900 border border-slate-800 overflow-hidden">
        <table class="w-full">
            <thead class="bg-slate-800">
                <tr>
                    <th
                        class="text-left px-6 py-3 text-xs font-medium text-slate-400 uppercase"
                        >Tracking</th
                    >
                    <th
                        class="text-left px-6 py-3 text-xs font-medium text-slate-400 uppercase"
                        >Fecha</th
                    >
                    <th
                        class="text-left px-6 py-3 text-xs font-medium text-slate-400 uppercase"
                        >Productos</th
                    >
                    <th
                        class="text-left px-6 py-3 text-xs font-medium text-slate-400 uppercase"
                        >Estado</th
                    >
                    <th
                        class="text-right px-6 py-3 text-xs font-medium text-slate-400 uppercase"
                        >Total</th
                    >
                    <th
                        class="text-right px-6 py-3 text-xs font-medium text-slate-400 uppercase"
                        >Acciones</th
                    >
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-800" id="ordersTable">
                {
                    orders?.map((order) => (
                        <tr
                            class="hover:bg-slate-800/50 order-row"
                            data-status={order.shipping_status}
                        >
                            <td class="px-6 py-4">
                                <span class="font-mono text-white">
                                    {order.tracking_number ||
                                        order.id.slice(0, 8)}
                                </span>
                            </td>
                            <td class="px-6 py-4 text-slate-400 text-sm">
                                {formatDate(order.created_at)}
                            </td>
                            <td class="px-6 py-4 text-slate-300 text-sm">
                                {order.items?.length || 0} artículos
                            </td>
                            <td class="px-6 py-4">
                                <select
                                    class="status-select bg-transparent border border-slate-700 text-sm px-2 py-1 rounded"
                                    data-order-id={order.id}
                                >
                                    {Object.entries(statusLabels).map(
                                        ([value, label]) => (
                                            <option
                                                value={value}
                                                selected={
                                                    order.shipping_status ===
                                                    value
                                                }
                                                class="bg-slate-800"
                                            >
                                                {label}
                                            </option>
                                        ),
                                    )}
                                </select>
                            </td>
                            <td class="px-6 py-4 text-right text-white font-medium">
                                {formatPrice(order.total_amount)}
                            </td>
                            <td class="px-6 py-4 text-right">
                                <a
                                    href={`/gestion-fm/pedidos/${order.id}`}
                                    class="text-accent hover:underline text-sm"
                                >
                                    Ver
                                </a>
                            </td>
                        </tr>
                    ))
                }
            </tbody>
        </table>
    </div>
</AdminLayout>

<script>
    // Filter by status
    document.getElementById("statusFilter")?.addEventListener("change", (e) => {
        const status = (e.target as HTMLSelectElement).value;
        document.querySelectorAll(".order-row").forEach((row) => {
            if (!status || row.getAttribute("data-status") === status) {
                (row as HTMLElement).style.display = "";
            } else {
                (row as HTMLElement).style.display = "none";
            }
        });
    });

    // Update status
    document.querySelectorAll(".status-select").forEach((select) => {
        select.addEventListener("change", async (e) => {
            const orderId = (e.target as HTMLSelectElement).getAttribute(
                "data-order-id",
            );
            const newStatus = (e.target as HTMLSelectElement).value;

            const res = await fetch("/api/admin/orders/update-status", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ orderId, status: newStatus }),
            });

            if (res.ok) {
                (e.target as HTMLElement)
                    .closest("tr")
                    ?.setAttribute("data-status", newStatus);
            } else {
                alert("Error al actualizar estado");
            }
        });
    });
</script>




