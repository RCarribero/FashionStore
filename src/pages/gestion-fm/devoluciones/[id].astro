---
/**
 * Admin Return Detail Page
 * Detailed view of a return request with images and actions
 */
export const prerender = false;

import AdminLayout from "../../../modules/admin/layouts/AdminLayout.astro";
import { getReturnById } from "../../../modules/admin/services/returns.service";
import { ROUTES } from "../../../config";

const { id } = Astro.params;

if (!id) {
    return Astro.redirect(ROUTES.ADMIN.RETURNS);
}

const { data: returnReq, error } = await getReturnById(id);

if (error || !returnReq) {
    return Astro.redirect(ROUTES.ADMIN.RETURNS);
}

const formatPrice = (cents: number) => (cents / 100).toFixed(2) + " EUR";
const formatDate = (dateStr: string) =>
    new Date(dateStr).toLocaleDateString("es-ES", {
        day: "numeric",
        month: "short",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit",
    });

const statusLabels: Record<string, string> = {
    pending: "Pendiente",
    approved: "Aprobada",
    rejected: "Rechazada",
    completed: "Completada",
};

const statusColors: Record<string, string> = {
    pending: "bg-yellow-500/20 text-yellow-400 border-yellow-500",
    approved: "bg-green-500/20 text-green-400 border-green-500",
    rejected: "bg-red-500/20 text-red-400 border-red-500",
    completed: "bg-blue-500/20 text-blue-400 border-blue-500",
};

const reasonLabels: Record<string, string> = {
    wrong_size: "Talla incorrecta",
    damaged: "Producto dañado",
    not_as_described: "No coincide con descripción",
    changed_mind: "Cambio de opinión",
    cancelled_by_user: "Cancelado por usuario",
    admin_initiated: "Creada por administrador",
    other: "Otro motivo",
};
---

<AdminLayout title={`Devolución - Pedido #${returnReq.orders.order_number}`}>
    <!-- Notification Container -->
    <div
        id="notification-area"
        class="fixed top-4 right-4 z-50 transition-all duration-300 transform translate-x-full opacity-0"
    >
        <div
            id="notification-content"
            class="px-4 py-3 rounded shadow-lg text-white font-medium text-sm flex items-center gap-2"
        >
        </div>
    </div>

    <!-- Back button -->
    <div class="mb-6">
        <a
            href={ROUTES.ADMIN.RETURNS}
            class="text-slate-400 hover:text-white text-sm flex items-center gap-2"
        >
            <svg
                class="w-4 h-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 19l-7-7 7-7"></path>
            </svg>
            Volver a devoluciones
        </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Main Content -->
        <div class="lg:col-span-2 space-y-6">
            <!-- Header Card -->
            <div class="bg-slate-900 border border-slate-800 p-6 rounded">
                <div class="flex justify-between items-start mb-4">
                    <div>
                        <p class="text-slate-400 text-sm">
                            Solicitud de Devolución
                        </p>
                        <p class="font-mono text-xl text-white font-bold">
                            #{returnReq.orders.order_number}
                        </p>
                        <p class="text-slate-500 text-xs mt-1">
                            ID: {returnReq.id.slice(0, 8)}...
                        </p>
                    </div>
                    <span
                        class:list={[
                            "px-3 py-1 text-sm rounded border font-medium",
                            statusColors[returnReq.status],
                        ]}
                    >
                        {statusLabels[returnReq.status]}
                    </span>
                </div>

                <div class="grid grid-cols-2 md:grid-cols-3 gap-4 text-sm">
                    <div>
                        <p class="text-slate-500">Fecha Solicitud</p>
                        <p class="text-white">
                            {formatDate(returnReq.created_at)}
                        </p>
                    </div>
                    <div>
                        <p class="text-slate-500">Motivo</p>
                        <p class="text-white">
                            {reasonLabels[returnReq.reason] || returnReq.reason}
                        </p>
                    </div>
                    <div>
                        <p class="text-slate-500">Total Pedido</p>
                        <p class="text-white font-bold">
                            {formatPrice(returnReq.orders.total_amount)}
                        </p>
                    </div>
                </div>
            </div>

            <!-- Return Details -->
            <div class="bg-slate-900 border border-slate-800 p-6 rounded">
                <h3 class="font-bold text-white mb-4">
                    Detalles de la Solicitud
                </h3>

                <div class="space-y-4">
                    <div>
                        <p class="text-slate-400 text-sm mb-1">
                            Motivo de Devolución
                        </p>
                        <p class="text-white">
                            {reasonLabels[returnReq.reason] || returnReq.reason}
                        </p>
                    </div>

                    {
                        returnReq.details && (
                            <div>
                                <p class="text-slate-400 text-sm mb-1">
                                    Información Adicional
                                </p>
                                <p class="text-white bg-slate-800/50 p-3 rounded">
                                    {returnReq.details}
                                </p>
                            </div>
                        )
                    }
                </div>
            </div>

            <!-- Evidence Images -->
            {
                returnReq.images && returnReq.images.length > 0 && (
                    <div class="bg-slate-900 border border-slate-800 p-6 rounded">
                        <h3 class="font-bold text-white mb-4">
                            Evidencia ({returnReq.images.length} imágenes)
                        </h3>
                        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                            {returnReq.images.map((image: string) => (
                                <a
                                    href={image}
                                    target="_blank"
                                    class="group relative aspect-square overflow-hidden rounded border border-slate-700 hover:border-accent transition-colors"
                                >
                                    <img
                                        src={image}
                                        alt="Evidencia"
                                        class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-300"
                                    />
                                    <div class="absolute inset-0 bg-black/0 group-hover:bg-black/40 transition-colors flex items-center justify-center">
                                        <svg
                                            class="w-8 h-8 text-white opacity-0 group-hover:opacity-100 transition-opacity"
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            stroke="currentColor"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"
                                            />
                                        </svg>
                                    </div>
                                </a>
                            ))}
                        </div>
                    </div>
                )
            }

            <!-- Related Order Info -->
            <div class="bg-slate-900 border border-slate-800 p-6 rounded">
                <h3 class="font-bold text-white mb-4">
                    Información del Pedido
                </h3>
                <div class="space-y-3">
                    <div class="flex justify-between">
                        <span class="text-slate-400">Número de Pedido</span>
                        <a
                            href={`/gestion-fm/pedidos/${returnReq.order_id}`}
                            class="text-accent hover:underline font-semibold"
                        >
                            #{returnReq.orders.order_number}
                        </a>
                    </div>
                    {
                        returnReq.orders.tracking_number && (
                            <div class="flex justify-between">
                                <span class="text-slate-400">Tracking</span>
                                <span class="text-white font-mono text-sm">
                                    {returnReq.orders.tracking_number}
                                </span>
                            </div>
                        )
                    }
                    <div class="flex justify-between">
                        <span class="text-slate-400">Estado del Pedido</span>
                        <span class="text-white capitalize">
                            {returnReq.orders.status}
                        </span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-slate-400">Total</span>
                        <span class="text-white font-bold">
                            {formatPrice(returnReq.orders.total_amount)}
                        </span>
                    </div>
                </div>
            </div>

            <!-- Customer Info -->
            <div class="bg-slate-900 border border-slate-800 p-6 rounded">
                <h3 class="font-bold text-white mb-4">
                    Información del Cliente
                </h3>
                <div class="space-y-2">
                    <div>
                        <p class="text-slate-400 text-sm">Nombre</p>
                        <p class="text-white">
                            {returnReq.user_profiles.first_name || "N/A"}
                            {returnReq.user_profiles.last_name || ""}
                        </p>
                    </div>
                    <div>
                        <p class="text-slate-400 text-sm">Email</p>
                        <p class="text-white">
                            {returnReq.user_profiles.email}
                        </p>
                    </div>
                    {
                        returnReq.user_profiles.phone && (
                            <div>
                                <p class="text-slate-400 text-sm">Teléfono</p>
                                <p class="text-white">
                                    {returnReq.user_profiles.phone}
                                </p>
                            </div>
                        )
                    }
                </div>
            </div>
        </div>

        <!-- Sidebar Actions -->
        <div class="space-y-6">
            <!-- Quick Actions -->
            {
                returnReq.status === "pending" && (
                    <div class="bg-slate-900 border border-slate-800 p-6 rounded">
                        <h3 class="font-bold text-white mb-4">Acciones</h3>
                        <div class="space-y-3">
                            <button
                                id="approveReturn"
                                class="w-full bg-green-600 hover:bg-green-700 text-white py-3 font-medium rounded transition-colors flex items-center justify-center gap-2"
                            >
                                <svg
                                    class="w-5 h-5"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M5 13l4 4L19 7"
                                    />
                                </svg>
                                Aprobar Devolución
                            </button>
                            <button
                                id="rejectReturn"
                                class="w-full bg-red-600 hover:bg-red-700 text-white py-3 font-medium rounded transition-colors flex items-center justify-center gap-2"
                            >
                                <svg
                                    class="w-5 h-5"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M6 18L18 6M6 6l12 12"
                                    />
                                </svg>
                                Rechazar Devolución
                            </button>
                        </div>
                    </div>
                )
            }

            {
                returnReq.status === "approved" && (
                    <div class="bg-slate-900 border border-slate-800 p-6 rounded">
                        <h3 class="font-bold text-white mb-4">
                            Estado: Aprobada
                        </h3>
                        <p class="text-slate-400 text-sm mb-4">
                            La devolución ha sido aprobada. El cliente ha sido
                            notificado.
                        </p>
                        <button
                            id="markCompleted"
                            class="w-full bg-blue-600 hover:bg-blue-700 text-white py-2 font-medium rounded transition-colors"
                        >
                            Marcar como Completada
                        </button>
                    </div>
                )
            }

            {
                (returnReq.status === "rejected" ||
                    returnReq.status === "completed") && (
                    <div class="bg-slate-900 border border-slate-800 p-6 rounded">
                        <h3 class="font-bold text-white mb-4">
                            Estado: {statusLabels[returnReq.status]}
                        </h3>
                        <p class="text-slate-400 text-sm">
                            {returnReq.status === "rejected"
                                ? "Esta solicitud ha sido rechazada."
                                : "Esta devolución ha sido completada."}
                        </p>
                    </div>
                )
            }

            <!-- Timeline -->
            <div class="bg-slate-900 border border-slate-800 p-6 rounded">
                <h3 class="font-bold text-white mb-4">Historial</h3>
                <div class="space-y-4">
                    <div class="flex gap-3">
                        <div
                            class="w-2 h-2 mt-2 rounded-full bg-accent flex-shrink-0"
                        >
                        </div>
                        <div>
                            <p class="text-white text-sm">Solicitud creada</p>
                            <p class="text-slate-500 text-xs">
                                {formatDate(returnReq.created_at)}
                            </p>
                        </div>
                    </div>

                    {
                        returnReq.status !== "pending" && (
                            <div class="flex gap-3">
                                <div class="w-2 h-2 mt-2 rounded-full bg-accent flex-shrink-0" />
                                <div>
                                    <p class="text-white text-sm">
                                        Estado actualizado a:{" "}
                                        {statusLabels[returnReq.status]}
                                    </p>
                                    <p class="text-slate-500 text-xs">
                                        {/* Would need updated_at field in DB */}
                                        Actualizado recientemente
                                    </p>
                                </div>
                            </div>
                        )
                    }
                </div>
            </div>
        </div>
    </div>
</AdminLayout>

<div id="return-data" data-return-id={id} class="hidden"></div>

<script>
    import { getSession } from "../../../modules/auth/services/auth-client.service";

    const returnId = document.getElementById("return-data")?.dataset.returnId;

    // Notification helper
    function showNotification(message: string, type = "success") {
        const area = document.getElementById("notification-area");
        const content = document.getElementById("notification-content");

        if (!area || !content) return;

        if (type === "error") {
            content.className =
                "px-4 py-3 rounded shadow-lg text-white font-medium text-sm flex items-center gap-2 bg-red-600";
        } else {
            content.className =
                "px-4 py-3 rounded shadow-lg text-white font-medium text-sm flex items-center gap-2 bg-green-600";
        }

        content.textContent = message;

        // Show
        area.classList.remove("translate-x-full", "opacity-0");

        // Hide after 3s
        setTimeout(() => {
            area.classList.add("translate-x-full", "opacity-0");
        }, 3000);
    }

    async function buildAuthHeaders(): Promise<Record<string, string>> {
        const headers: Record<string, string> = {
            "Content-Type": "application/json",
        };

        try {
            const session = await getSession();
            const accessToken = session?.access_token;
            if (accessToken) {
                headers["Authorization"] = `Bearer ${accessToken}`;
            }
        } catch {
            // Fallback to cookies if present
        }

        return headers;
    }

    // Approve return
    document
        .getElementById("approveReturn")
        ?.addEventListener("click", async () => {
            if (
                !confirm(
                    "¿Estás seguro de aprobar esta devolución? Se generará una factura de abono y se notificará al cliente.",
                )
            )
                return;

            const res = await fetch("/api/admin/returns/approve", {
                method: "POST",
                headers: await buildAuthHeaders(),
                body: JSON.stringify({ returnId }),
            });

            if (res.ok) {
                showNotification("Devolución aprobada correctamente");
                setTimeout(() => window.location.reload(), 1500);
            } else {
                const data = await res.json();
                showNotification(
                    data.error || "Error al aprobar devolución",
                    "error",
                );
            }
        });

    // Reject return
    document
        .getElementById("rejectReturn")
        ?.addEventListener("click", async () => {
            const reason = prompt(
                "Motivo del rechazo (opcional, será enviado al cliente):",
            );
            if (reason === null) return; // User cancelled

            const res = await fetch("/api/admin/returns/reject", {
                method: "POST",
                headers: await buildAuthHeaders(),
                body: JSON.stringify({ returnId, rejectionReason: reason }),
            });

            if (res.ok) {
                showNotification("Devolución rechazada");
                setTimeout(() => window.location.reload(), 1500);
            } else {
                const data = await res.json();
                showNotification(
                    data.error || "Error al rechazar devolución",
                    "error",
                );
            }
        });

    // Mark as completed
    document
        .getElementById("markCompleted")
        ?.addEventListener("click", async () => {
            if (
                !confirm(
                    "¿Marcar esta devolución como completada? Esto indica que el producto ha sido recibido y el reembolso procesado.",
                )
            )
                return;

            const res = await fetch("/api/admin/returns/update-status", {
                method: "POST",
                headers: await buildAuthHeaders(),
                body: JSON.stringify({ returnId, status: "completed" }),
            });

            if (res.ok) {
                showNotification("Devolución marcada como completada");
                setTimeout(() => window.location.reload(), 1500);
            } else {
                const data = await res.json();
                showNotification(
                    data.error || "Error al actualizar estado",
                    "error",
                );
            }
        });
</script>
