---
/**
 * Admin Returns List
 * Lists all return requests with filtering and quick actions
 */
export const prerender = false;

import AdminLayout from "../../../modules/admin/layouts/AdminLayout.astro";
import { getReturns } from "../../../modules/admin/services/returns.service";
import { ROUTES } from "../../../config";

const { data: returns } = await getReturns();

const formatDate = (dateStr: string) =>
    new Date(dateStr).toLocaleDateString("es-ES", {
        day: "numeric",
        month: "short",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit",
    });

const statusLabels: Record<string, string> = {
    pending: "Pendiente",
    approved: "Aprobada",
    rejected: "Rechazada",
    completed: "Completada",
};

const statusColors: Record<string, string> = {
    pending: "bg-yellow-500/20 text-yellow-400 border-yellow-500/30",
    approved: "bg-green-500/20 text-green-400 border-green-500/30",
    rejected: "bg-red-500/20 text-red-400 border-red-500/30",
    completed: "bg-blue-500/20 text-blue-400 border-blue-500/30",
};

const reasonLabels: Record<string, string> = {
    wrong_size: "Talla incorrecta",
    damaged: "Producto dañado",
    not_as_described: "No coincide con descripción",
    changed_mind: "Cambio de opinión",
    cancelled_by_user: "Cancelado por usuario",
    other: "Otro motivo",
};
---

<AdminLayout title="Devoluciones">
    <!-- Notification Container -->
    <div
        id="notification-area"
        class="fixed top-4 right-4 z-50 transition-all duration-300 transform translate-x-full opacity-0"
    >
        <div
            id="notification-content"
            class="px-4 py-3 rounded shadow-lg text-white font-medium text-sm flex items-center gap-2"
        >
        </div>
    </div>

    <!-- Header with filters -->
    <div class="flex justify-between items-center mb-6">
        <div>
            <p class="text-slate-400">
                {returns?.length || 0} solicitudes de devolución
            </p>
            <p class="text-slate-500 text-sm mt-1">
                {
                    returns?.filter((r) => r.status === "pending").length || 0
                } pendientes de revisión
            </p>
        </div>
        <div class="flex gap-2">
            <input
                type="text"
                id="searchReturn"
                placeholder="Buscar (pedido, email...)"
                class="bg-slate-800 border border-slate-700 text-white px-3 py-2 text-sm w-64 focus:border-accent focus:outline-none rounded"
            />
            <select
                id="statusFilter"
                class="bg-slate-800 border border-slate-700 text-white px-3 py-2 text-sm rounded cursor-pointer"
            >
                <option value="">Todos los estados</option>
                <option value="pending">Pendiente</option>
                <option value="approved">Aprobada</option>
                <option value="rejected">Rechazada</option>
                <option value="completed">Completada</option>
            </select>
        </div>
    </div>

    <!-- Returns Table -->
    <div class="bg-slate-900 border border-slate-800 overflow-hidden rounded">
        <table class="w-full">
            <thead class="bg-slate-800">
                <tr>
                    <th
                        class="text-left px-6 py-3 text-xs font-medium text-slate-400 uppercase"
                        >ID</th
                    >
                    <th
                        class="text-left px-6 py-3 text-xs font-medium text-slate-400 uppercase"
                        >Fecha</th
                    >
                    <th
                        class="text-left px-6 py-3 text-xs font-medium text-slate-400 uppercase"
                        >Cliente</th
                    >
                    <th
                        class="text-left px-6 py-3 text-xs font-medium text-slate-400 uppercase"
                        >Pedido</th
                    >
                    <th
                        class="text-left px-6 py-3 text-xs font-medium text-slate-400 uppercase"
                        >Motivo</th
                    >
                    <th
                        class="text-left px-6 py-3 text-xs font-medium text-slate-400 uppercase"
                        >Estado</th
                    >
                    <th
                        class="text-right px-6 py-3 text-xs font-medium text-slate-400 uppercase"
                        >Acciones</th
                    >
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-800" id="returnsTable">
                {
                    returns?.map((returnReq) => (
                        <tr
                            class="hover:bg-slate-800/50 return-row cursor-pointer"
                            data-status={returnReq.status}
                            data-search={`${returnReq.id} ${returnReq.orders.order_number} ${returnReq.user_profiles.email} ${returnReq.user_profiles.first_name || ""} ${returnReq.user_profiles.last_name || ""}`.toLowerCase()}
                            onclick={`window.location.href='${ROUTES.ADMIN.RETURN_DETAIL(returnReq.id)}'`}
                        >
                            <td class="px-6 py-4">
                                <span class="font-mono text-slate-400 text-xs">
                                    {returnReq.id.slice(0, 8)}...
                                </span>
                            </td>
                            <td class="px-6 py-4 text-slate-400 text-sm">
                                {formatDate(returnReq.created_at)}
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex flex-col">
                                    <span class="text-white text-sm font-medium">
                                        {returnReq.user_profiles.first_name ||
                                            "Usuario"}{" "}
                                        {returnReq.user_profiles.last_name || ""}
                                    </span>
                                    <span class="text-slate-400 text-xs">
                                        {returnReq.user_profiles.email}
                                    </span>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <span class="text-accent font-semibold text-sm">
                                    #{returnReq.orders.order_number}
                                </span>
                            </td>
                            <td class="px-6 py-4 text-slate-300 text-sm">
                                {reasonLabels[returnReq.reason] ||
                                    returnReq.reason}
                            </td>
                            <td class="px-6 py-4">
                                <span
                                    class:list={[
                                        "px-3 py-1 rounded-full text-xs font-medium border",
                                        statusColors[returnReq.status],
                                    ]}
                                >
                                    {statusLabels[returnReq.status]}
                                </span>
                            </td>
                            <td class="px-6 py-4 text-right">
                                <a
                                    href={ROUTES.ADMIN.RETURN_DETAIL(
                                        returnReq.id,
                                    )}
                                    class="text-accent hover:underline text-sm"
                                    onclick="event.stopPropagation()"
                                >
                                    Ver detalle
                                </a>
                            </td>
                        </tr>
                    ))
                }
            </tbody>
        </table>

        {
            !returns || returns.length === 0 ? (
                <div class="text-center py-12 text-slate-400">
                    <svg
                        class="mx-auto h-12 w-12 text-slate-600 mb-4"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="1"
                            d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"
                        />
                    </svg>
                    <p>No hay solicitudes de devolución</p>
                </div>
            ) : null
        }
    </div>
</AdminLayout>

<script>
    // Notification helper
    function showNotification(message: string, type: "success" | "error" = "success") {
        const area = document.getElementById("notification-area");
        const content = document.getElementById("notification-content");

        if (!area || !content) return;

        if (type === "error") {
            content.className =
                "px-4 py-3 rounded shadow-lg text-white font-medium text-sm flex items-center gap-2 bg-red-600";
        } else {
            content.className =
                "px-4 py-3 rounded shadow-lg text-white font-medium text-sm flex items-center gap-2 bg-green-600";
        }

        content.textContent = message;

        // Show
        area.classList.remove("translate-x-full", "opacity-0");

        // Hide after 3s
        setTimeout(() => {
            area.classList.add("translate-x-full", "opacity-0");
        }, 3000);
    }

    // Filter Logic
    const statusSelect = document.getElementById("statusFilter") as HTMLSelectElement;
    const searchInput = document.getElementById("searchReturn") as HTMLInputElement;

    function filterReturns() {
        const statusVal = statusSelect?.value || "";
        const searchVal = searchInput?.value.toLowerCase() || "";

        document.querySelectorAll(".return-row").forEach((row) => {
            const rowStatus = row.getAttribute("data-status");
            const rowSearch = row.getAttribute("data-search");

            const matchStatus = !statusVal || rowStatus === statusVal;
            const matchSearch = !searchVal || rowSearch?.includes(searchVal);

            if (matchStatus && matchSearch) {
                (row as HTMLElement).style.display = "";
            } else {
                (row as HTMLElement).style.display = "none";
            }
        });
    }

    statusSelect?.addEventListener("change", filterReturns);
    searchInput?.addEventListener("input", filterReturns);

    // Auto-filter if URL has ?filter=pending
    const urlParams = new URLSearchParams(window.location.search);
    const filterParam = urlParams.get("filter");
    if (filterParam && statusSelect) {
        statusSelect.value = filterParam;
        filterReturns();
    }
</script>
