---
/**
 * Edit Product Form
 */
export const prerender = false;

import AdminLayout from "../../../modules/admin/layouts/AdminLayout.astro";
import { createClient } from "@supabase/supabase-js";

const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.SUPABASE_SERVICE_ROLE_KEY,
);

const { id } = Astro.params;

const { data: product } = await supabase
    .from("products")
    .select("*, variants:product_variants(*)")
    .eq("id", id)
    .single();

if (!product) {
    return Astro.redirect("/gestion-fm/productos");
}

const { data: categories } = await supabase
    .from("categories")
    .select("id, name")
    .order("name");

const formatPrice = (cents: number) => (cents / 100).toFixed(2);
---

<AdminLayout title={`Editar: ${product.name}`}>
    <div class="max-w-2xl">
        <form id="productForm" class="space-y-6">
            <div class="bg-slate-900 border border-slate-800 p-6 space-y-4">
                <h2 class="text-lg font-bold text-white mb-4">
                    Informacion Basica
                </h2>

                <div>
                    <label class="block text-sm text-slate-400 mb-1"
                        >Nombre *</label
                    >
                    <input
                        type="text"
                        id="name"
                        required
                        value={product.name}
                        class="w-full bg-slate-800 border border-slate-700 text-white px-4 py-3"
                    />
                </div>

                <div>
                    <label class="block text-sm text-slate-400 mb-1"
                        >Slug *</label
                    >
                    <input
                        type="text"
                        id="slug"
                        required
                        value={product.slug}
                        class="w-full bg-slate-800 border border-slate-700 text-white px-4 py-3"
                    />
                </div>

                <div>
                    <label class="block text-sm text-slate-400 mb-1"
                        >Descripcion</label
                    >
                    <textarea
                        id="description"
                        rows="3"
                        class="w-full bg-slate-800 border border-slate-700 text-white px-4 py-3 resize-none"
                        >{product.description}</textarea
                    >
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm text-slate-400 mb-1"
                            >Precio (EUR) *</label
                        >
                        <input
                            type="number"
                            id="price"
                            step="0.01"
                            min="0"
                            required
                            value={formatPrice(product.price)}
                            class="w-full bg-slate-800 border border-slate-700 text-white px-4 py-3"
                        />
                    </div>
                    <div>
                        <label class="block text-sm text-slate-400 mb-1"
                            >Categoria *</label
                        >
                        <select
                            id="category"
                            required
                            class="w-full bg-slate-800 border border-slate-700 text-white px-4 py-3"
                        >
                            {
                                categories?.map((cat) => (
                                    <option
                                        value={cat.id}
                                        selected={
                                            cat.id === product.category_id
                                        }
                                    >
                                        {cat.name}
                                    </option>
                                ))
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="bg-slate-900 border border-slate-800 p-6 space-y-4">
                <h2 class="text-lg font-bold text-white mb-4">Imagenes</h2>

                <div>
                    <label class="block text-sm text-slate-400 mb-1"
                        >URLs de imagenes (una por linea)</label
                    >
                    <textarea
                        id="images"
                        rows="4"
                        class="w-full bg-slate-800 border border-slate-700 text-white px-4 py-3 resize-none font-mono text-sm"
                        >{product.images?.join("\n")}</textarea
                    >
                </div>
            </div>

            <div class="bg-slate-900 border border-slate-800 p-6 space-y-4">
                <h2 class="text-lg font-bold text-white mb-4">
                    Stock por Talla
                </h2>

                <div class="grid grid-cols-3 md:grid-cols-6 gap-3">
                    {
                        ["XS", "S", "M", "L", "XL", "XXL"].map((size) => {
                            const variant = product.variants?.find(
                                (v: any) => v.size === size,
                            );
                            return (
                                <div>
                                    <label class="block text-sm text-slate-400 mb-1 text-center">
                                        {size}
                                    </label>
                                    <input
                                        type="number"
                                        data-size={size}
                                        min="0"
                                        value={variant?.stock || 0}
                                        class="w-full bg-slate-800 border border-slate-700 text-white px-2 py-2 text-center"
                                    />
                                </div>
                            );
                        })
                    }
                </div>
            </div>

            <div class="flex gap-4">
                <button
                    type="submit"
                    class="flex-1 bg-accent hover:bg-red-700 text-white py-3 font-bold transition-colors"
                >
                    Guardar Cambios
                </button>
                <a
                    href="/gestion-fm/productos"
                    class="px-6 py-3 border border-slate-700 text-white hover:bg-slate-800 transition-colors text-center"
                >
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</AdminLayout>

<script define:vars={{ productId: id }}>
    const form = document.getElementById("productForm");

    form?.addEventListener("submit", async (e) => {
        e.preventDefault();

        const name = document.getElementById("name").value;
        const slug = document.getElementById("slug").value;
        const description = document.getElementById("description").value;
        const price = parseFloat(document.getElementById("price").value) * 100;
        const category_id = document.getElementById("category").value;
        const imagesText = document.getElementById("images").value;
        const images = imagesText
            .split("\n")
            .map((url) => url.trim())
            .filter(Boolean);

        const variants = [];
        document.querySelectorAll("[data-size]").forEach((input) => {
            variants.push({
                size: input.getAttribute("data-size"),
                stock: parseInt(input.value) || 0,
            });
        });

        const totalStock = variants.reduce((sum, v) => sum + v.stock, 0);

        const res = await fetch(`/api/admin/products/${productId}`, {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                name,
                slug,
                description,
                price,
                category_id,
                images,
                stock: totalStock,
                variants,
            }),
        });

        if (res.ok) {
            window.location.href = "/gestion-fm/productos";
        } else {
            const data = await res.json();
            alert("Error: " + (data.error || "Error al guardar"));
        }
    });
</script>
