---
/**
 * Admin Products List
 */
export const prerender = false;

import AdminLayout from "../../../modules/admin/layouts/AdminLayout.astro";
import { supabase } from "../../../lib/supabase";

const { data: products } = await supabase
    .from("products")
    .select("*, category:categories(name)")
    .order("created_at", { ascending: false });

const formatPrice = (cents: number) => (cents / 100).toFixed(2) + " EUR";
---

<AdminLayout title="Productos">
    <div class="flex justify-between items-center mb-6">
        <p class="text-slate-400">{products?.length || 0} productos</p>
        <a
            href="/gestion-fm/productos/nuevo"
            class="px-4 py-2 bg-accent hover:bg-red-700 text-white font-medium transition-colors"
        >
            + Nuevo Producto
        </a>
    </div>

    <div class="bg-slate-900 border border-slate-800 overflow-hidden">
        <table class="w-full">
            <thead class="bg-slate-800">
                <tr>
                    <th
                        class="text-left px-6 py-3 text-xs font-medium text-slate-400 uppercase"
                        >Producto</th
                    >
                    <th
                        class="text-left px-6 py-3 text-xs font-medium text-slate-400 uppercase"
                        >Categoria</th
                    >
                    <th
                        class="text-left px-6 py-3 text-xs font-medium text-slate-400 uppercase"
                        >Precio</th
                    >
                    <th
                        class="text-left px-6 py-3 text-xs font-medium text-slate-400 uppercase"
                        >Stock</th
                    >
                    <th
                        class="text-right px-6 py-3 text-xs font-medium text-slate-400 uppercase"
                        >Acciones</th
                    >
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-800">
                {
                    products?.map((product) => (
                        <tr class="hover:bg-slate-800/50">
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-3">
                                    {product.images?.[0] && (
                                        <img
                                            src={product.images[0]}
                                            alt=""
                                            class="w-10 h-10 object-cover rounded"
                                        />
                                    )}
                                    <div>
                                        <p class="text-white font-medium">
                                            {product.name}
                                        </p>
                                        <p class="text-slate-500 text-xs">
                                            {product.slug}
                                        </p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 text-slate-400">
                                {product.category?.name || "-"}
                            </td>
                            <td class="px-6 py-4 text-white">
                                {formatPrice(product.price)}
                            </td>
                            <td class="px-6 py-4">
                                <span
                                    class={`px-2 py-1 text-xs rounded ${product.stock > 10 ? "bg-green-500/20 text-green-400" : product.stock > 0 ? "bg-yellow-500/20 text-yellow-400" : "bg-red-500/20 text-red-400"}`}
                                >
                                    {product.stock}
                                </span>
                            </td>
                            <td class="px-6 py-4 text-right">
                                <a
                                    href={`/gestion-fm/productos/${product.id}`}
                                    class="text-accent hover:underline text-sm mr-4"
                                >
                                    Editar
                                </a>
                                <button
                                    data-delete={product.id}
                                    class="text-red-400 hover:underline text-sm"
                                >
                                    Eliminar
                                </button>
                            </td>
                        </tr>
                    ))
                }
            </tbody>
        </table>
    </div>

    <!-- Custom Delete Modal -->
    <div
        id="deleteModal"
        class="fixed inset-0 bg-black/70 hidden items-center justify-center z-50"
    >
        <div
            class="bg-slate-900 border border-slate-800 p-6 w-full max-w-md mx-4 rounded-lg"
        >
            <div class="text-center">
                <div
                    class="w-16 h-16 mx-auto mb-4 bg-red-500/20 rounded-full flex items-center justify-center"
                >
                    <svg
                        class="w-8 h-8 text-red-500"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                        ></path>
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-white mb-2">
                    Eliminar Producto
                </h3>
                <p class="text-slate-400 mb-1">
                    ¿Seguro que quieres eliminar este producto?
                </p>
                <p id="deleteProductName" class="text-white font-medium mb-6">
                </p>
            </div>
            <div class="flex gap-3">
                <button
                    id="confirmDelete"
                    class="flex-1 bg-red-600 hover:bg-red-700 text-white py-3 font-medium rounded transition-colors"
                >
                    Si, eliminar
                </button>
                <button
                    id="cancelDelete"
                    class="flex-1 bg-slate-800 hover:bg-slate-700 text-white py-3 font-medium rounded transition-colors"
                >
                    Cancelar
                </button>
            </div>
        </div>
    </div>

    <!-- Toast Notification -->
    <div
        id="toast"
        class="fixed bottom-4 right-4 bg-green-600 text-white px-6 py-3 rounded-lg shadow-lg transform translate-y-20 opacity-0 transition-all duration-300 z-50"
    >
        <span id="toastMessage"></span>
    </div>
</AdminLayout>

<script>
    const modal = document.getElementById("deleteModal");
    const productNameEl = document.getElementById("deleteProductName");
    /** @type {HTMLButtonElement} */
    const confirmBtn = document.getElementById("confirmDelete");
    const cancelBtn = document.getElementById("cancelDelete");
    const toast = document.getElementById("toast");
    const toastMessage = document.getElementById("toastMessage");
    /** @type {string | null} */
    let deleteId = null;

    /**
     * @param {string} id
     * @param {string} name
     */
    function showModal(id, name) {
        deleteId = id;
        productNameEl.textContent = name;
        modal?.classList.remove("hidden");
        modal?.classList.add("flex");
    }

    function hideModal() {
        modal?.classList.add("hidden");
        modal?.classList.remove("flex");
        deleteId = null;
    }

    /**
     * @param {string} message
     * @param {boolean} [isError=false]
     */
    function showToast(message, isError = false) {
        toastMessage.textContent = message;
        toast.className = toast.className.replace(
            "bg-green-600",
            isError ? "bg-red-600" : "bg-green-600",
        );
        toast.classList.remove("translate-y-20", "opacity-0");
        setTimeout(() => {
            toast.classList.add("translate-y-20", "opacity-0");
        }, 3000);
    }

    document.querySelectorAll("[data-delete]").forEach((btn) => {
        btn.addEventListener("click", () => {
            const id = btn.getAttribute("data-delete");
            const row = btn.closest("tr");
            const name =
                row?.querySelector(".text-white.font-medium")?.textContent ||
                "este producto";
            showModal(id, name);
        });
    });

    cancelBtn?.addEventListener("click", hideModal);
    modal?.addEventListener("click", (e) => {
        if (e.target === modal) hideModal();
    });

    confirmBtn?.addEventListener("click", async () => {
        if (!deleteId) return;

        confirmBtn.textContent = "Eliminando...";
        confirmBtn.disabled = true;

        const res = await fetch(`/api/admin/products/${deleteId}`, {
            method: "DELETE",
        });

        if (res.ok) {
            hideModal();
            showToast("Producto eliminado correctamente");
            setTimeout(() => window.location.reload(), 1000);
        } else {
            hideModal();
            showToast("Error al eliminar el producto", true);
            confirmBtn.textContent = "Si, eliminar";
            confirmBtn.disabled = false;
        }
    });
</script>
