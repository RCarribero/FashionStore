---
/**
 * Product Detail Page - Nike/JD/Adidas Inspired Design
 * Shows individual product with add to cart functionality
 */
import StoreLayout from "../layouts/StoreLayout.astro";
import AddToCartButton from "../components/AddToCartButton";
import { supabase } from "../../auth";
import { formatPrice } from "../../../shared/utils";
import { ROUTES } from "../../../config";
import { STORE_CONFIG } from "../config";
import type { Product } from "../../../shared/types";
import {
    buildCloudinaryUrl,
    buildResponsiveSet,
    extractPublicId,
    isCloudinaryUrl,
} from "../../../lib/services/cloudinary-url";

// Get product slug from URL
const { slug } = Astro.params;

// Fetch product with variants
const { data: product } = await supabase
    .from("products")
    .select("*, category:categories(*), variants:product_variants(*)")
    .eq("slug", slug)
    .single();

if (!product) {
    return Astro.redirect("/404");
}

// Enrich variants with available stock (real stock - active reservations from other sessions)
// We call the internal API directly via Supabase to avoid an HTTP round-trip
if (product.variants?.length) {
    try {
        // Build availability map: { size -> availableQty }
        for (const variant of product.variants) {
            const { data: reservations } = await supabase
                .from("stock_reservations")
                .select("quantity")
                .eq("variant_id", variant.id)
                .gt("expires_at", new Date().toISOString());

            const reservedByOthers =
                reservations?.reduce(
                    (sum: number, r: { quantity: number }) => sum + r.quantity,
                    0,
                ) || 0;
            // Replace variant stock with available quantity
            variant.stock = Math.max(0, variant.stock - reservedByOthers);
        }
    } catch (e) {
        // If enrichment fails, keep original stock values (safe fallback)
        console.error("Failed to enrich variant stock with reservations:", e);
    }
}

// Get related products
const { data: relatedProducts } = await supabase
    .from("products")
    .select("*")
    .eq("category_id", product.category_id)
    .neq("id", product.id)
    .limit(4);

const PRODUCT_IMAGE_WIDTH = 700;
const PRODUCT_IMAGE_HEIGHT = 800;
const THUMBNAIL_SIZE = 200;

const getOptimizedImage = (imageUrl?: string) => {
    if (!imageUrl) return null;

    const isAbsoluteUrl =
        imageUrl.startsWith("http://") || imageUrl.startsWith("https://");

    if (isAbsoluteUrl && !isCloudinaryUrl(imageUrl)) {
        return { src: imageUrl, srcset: undefined };
    }

    const publicId = isCloudinaryUrl(imageUrl)
        ? extractPublicId(imageUrl)
        : imageUrl;

    if (!publicId) {
        return { src: imageUrl, srcset: undefined };
    }

    return {
        src: buildCloudinaryUrl(publicId, "product", {
            width: PRODUCT_IMAGE_WIDTH,
            height: PRODUCT_IMAGE_HEIGHT,
        }),
        srcset: buildResponsiveSet(publicId, "product"),
    };
};

const getOptimizedThumbnail = (imageUrl?: string) => {
    if (!imageUrl) return null;

    const isAbsoluteUrl =
        imageUrl.startsWith("http://") || imageUrl.startsWith("https://");

    if (isAbsoluteUrl && !isCloudinaryUrl(imageUrl)) {
        return imageUrl;
    }

    const publicId = isCloudinaryUrl(imageUrl)
        ? extractPublicId(imageUrl)
        : imageUrl;

    if (!publicId) return imageUrl;

    return buildCloudinaryUrl(publicId, "product", {
        width: THUMBNAIL_SIZE,
        height: THUMBNAIL_SIZE,
        crop: "fill",
        gravity: "auto",
    });
};

const mainImage = product.images?.[0]
    ? { src: product.images[0], srcset: undefined }
    : null;
---

<StoreLayout title={product.name} description={product.description}>
    <!-- Product Section -->
    <div class="bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-12">
            <!-- Breadcrumb -->
            <nav class="flex items-center gap-2 text-sm mb-8">
                <a
                    href={ROUTES.HOME}
                    class="text-slate-500 hover:text-black transition-colors"
                    >Inicio</a
                >
                <span class="text-slate-300">/</span>
                <a
                    href={ROUTES.PRODUCTS}
                    class="text-slate-500 hover:text-black transition-colors"
                    >Productos</a
                >
                {
                    product.category && (
                        <>
                            <span class="text-slate-300">/</span>
                            <a
                                href={ROUTES.CATEGORY(product.category.slug)}
                                class="text-slate-500 hover:text-black transition-colors"
                            >
                                {product.category.name}
                            </a>
                        </>
                    )
                }
                <span class="text-slate-300">/</span>
                <span class="text-black font-medium truncate max-w-[200px]"
                    >{product.name}</span
                >
            </nav>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16">
                <!-- Product Images -->
                <div class="space-y-4">
                    <!-- Main Image -->
                    <div
                        class="relative aspect-[4/5] bg-slate-100 overflow-hidden group"
                    >
                        {
                            product.images?.[0] ? (
                                <img
                                    src={mainImage?.src}
                                    alt={product.name}
                                    width={PRODUCT_IMAGE_WIDTH}
                                    height={PRODUCT_IMAGE_HEIGHT}
                                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                                    id="main-image"
                                    loading="eager"
                                    decoding="async"
                                />
                            ) : (
                                <div class="w-full h-full flex items-center justify-center text-slate-300">
                                    <svg
                                        class="h-32 w-32"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="1"
                                            d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                                        />
                                    </svg>
                                </div>
                            )
                        }

                        <!-- Zoom Icon -->
                        <button
                            class="absolute bottom-4 right-4 p-3 bg-white/90 hover:bg-white text-black rounded-full shadow-lg opacity-0 group-hover:opacity-100 transition-all duration-300"
                        >
                            <svg
                                class="w-5 h-5"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                stroke-width="2"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607zM10.5 7.5v6m3-3h-6"
                                ></path>
                            </svg>
                        </button>

                        <!-- New Badge -->
                        <span
                            class="absolute top-4 left-4 px-3 py-1 bg-accent text-white text-xs font-bold uppercase tracking-wider"
                        >
                            Nuevo
                        </span>
                    </div>

                    <!-- Thumbnail Grid -->
                    {
                        product.images && product.images.length > 1 && (
                            <div class="grid grid-cols-4 gap-2">
                                {product.images.map(
                                    (img: string, idx: number) => {
                                        return (
                                            <button
                                                class={`aspect-square bg-slate-100 overflow-hidden border-2 transition-colors ${idx === 0 ? "border-black" : "border-transparent hover:border-slate-300"}`}
                                                data-image={img}
                                            >
                                                <img
                                                    src={img}
                                                    alt={`${product.name} ${idx + 1}`}
                                                    width={THUMBNAIL_SIZE}
                                                    height={THUMBNAIL_SIZE}
                                                    class="w-full h-full object-cover"
                                                    loading="lazy"
                                                    decoding="async"
                                                />
                                            </button>
                                        );
                                    },
                                )}
                            </div>
                        )
                    }
                </div>

                <!-- Product Info -->
                <div class="lg:sticky lg:top-24 lg:self-start">
                    <!-- Category -->
                    {
                        product.category && (
                            <a
                                href={ROUTES.CATEGORY(product.category.slug)}
                                class="inline-block text-sm text-accent font-semibold uppercase tracking-wider hover:underline mb-3"
                            >
                                {product.category.name}
                            </a>
                        )
                    }

                    <!-- Title -->
                    <h1
                        class="font-display text-3xl lg:text-4xl font-bold text-black uppercase tracking-tight"
                    >
                        {product.name}
                    </h1>

                    <!-- Price -->
                    <div class="flex items-center gap-4 mt-4">
                        <span class="text-3xl font-bold text-black">
                            {formatPrice(product.price)}
                        </span>
                        <span class="text-xl text-slate-400 line-through">
                            {formatPrice(product.price * 1.2)}
                        </span>
                        <span
                            class="px-3 py-1 bg-accent/10 text-accent text-sm font-bold"
                        >
                            -20%
                        </span>
                    </div>

                    <!-- Description -->
                    <p class="mt-6 text-slate-600 leading-relaxed">
                        {product.description}
                    </p>

                    <!-- Divider -->
                    <div class="border-t border-slate-200 my-8"></div>

                    <!-- Add to cart component -->
                    <AddToCartButton
                        client:load
                        product={{
                            id: product.id,
                            name: product.name,
                            price: product.price,
                            images: product.images || [],
                            stock: product.stock,
                            variants: product.variants || [],
                        }}
                    />

                    <!-- Divider -->
                    <div class="border-t border-slate-200 my-8"></div>

                    <!-- Features -->
                    <div class="space-y-4">
                        <div class="flex items-center gap-4 text-sm">
                            <div
                                class="flex items-center justify-center w-10 h-10 bg-slate-100 rounded-full"
                            >
                                <svg
                                    class="w-5 h-5 text-black"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"
                                    ></path>
                                </svg>
                            </div>
                            <div>
                                <span class="font-semibold text-black"
                                    >Envio Gratis</span
                                >
                                <span class="text-slate-500">
                                    en pedidos +100 EUR</span
                                >
                            </div>
                        </div>
                        <div class="flex items-center gap-4 text-sm">
                            <div
                                class="flex items-center justify-center w-10 h-10 bg-slate-100 rounded-full"
                            >
                                <svg
                                    class="w-5 h-5 text-black"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99"
                                    ></path>
                                </svg>
                            </div>
                            <div>
                                <span class="font-semibold text-black"
                                    >Devoluciones</span
                                >
                                <span class="text-slate-500">
                                    30 dias sin preguntas</span
                                >
                            </div>
                        </div>
                        <div class="flex items-center gap-4 text-sm">
                            <div
                                class="flex items-center justify-center w-10 h-10 bg-slate-100 rounded-full"
                            >
                                <svg
                                    class="w-5 h-5 text-black"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"
                                    ></path>
                                </svg>
                            </div>
                            <div>
                                <span class="font-semibold text-black"
                                    >Pago Seguro</span
                                >
                                <span class="text-slate-500"> con Stripe</span>
                            </div>
                        </div>
                    </div>

                    <!-- Product Details Accordion -->
                    <div class="mt-8 border-t border-slate-200">
                        <details class="group" open>
                            <summary
                                class="flex items-center justify-between py-4 cursor-pointer"
                            >
                                <span
                                    class="font-semibold text-black uppercase tracking-wider text-sm"
                                    >Detalles del Producto</span
                                >
                                <svg
                                    class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    stroke-width="2"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
                                </svg>
                            </summary>
                            <div class="pb-4 text-sm text-slate-600 space-y-2">
                                <p>
                                    <span class="text-black font-medium"
                                        >Categoria:</span
                                    >
                                    {product.category?.name || "Sin categoria"}
                                </p>
                                <p>
                                    <span class="text-black font-medium"
                                        >SKU:</span
                                    >
                                    {product.id.slice(0, 8).toUpperCase()}
                                </p>
                                <p>
                                    <span class="text-black font-medium"
                                        >Disponibilidad:</span
                                    >
                                    {
                                        product.stock > 0
                                            ? `${product.stock} en stock`
                                            : "Agotado"
                                    }
                                </p>
                            </div>
                        </details>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Related Products -->
    {
        relatedProducts && relatedProducts.length > 0 && (
            <section class="bg-slate-50 py-16 lg:py-24">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="flex items-center justify-between mb-8">
                        <h2 class="font-display text-2xl lg:text-3xl font-bold text-black uppercase tracking-tight">
                            Tambien te puede gustar
                        </h2>
                        <a
                            href={
                                product.category
                                    ? ROUTES.CATEGORY(product.category.slug)
                                    : ROUTES.PRODUCTS
                            }
                            class="text-sm font-semibold text-black hover:text-accent uppercase tracking-wider flex items-center gap-2 group"
                        >
                            Ver mas
                            <svg
                                class="w-4 h-4 group-hover:translate-x-1 transition-transform"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                stroke-width="2"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3"
                                />
                            </svg>
                        </a>
                    </div>

                    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-6">
                        {relatedProducts.map((relProduct: Product) => (
                            <a
                                href={ROUTES.PRODUCT_DETAIL(relProduct.slug)}
                                class="group bg-white border border-slate-100 hover:border-black transition-all duration-300"
                            >
                                <div class="relative aspect-[3/4] bg-slate-100 overflow-hidden">
                                    {relProduct.images?.[0] ? (
                                        <img
                                            src={relProduct.images[0]}
                                            alt={relProduct.name}
                                            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                                            loading="lazy"
                                        />
                                    ) : (
                                        <div class="w-full h-full flex items-center justify-center text-slate-300">
                                            <svg
                                                class="h-12 w-12"
                                                fill="none"
                                                viewBox="0 0 24 24"
                                                stroke="currentColor"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="1"
                                                    d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14"
                                                />
                                            </svg>
                                        </div>
                                    )}

                                    <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors duration-300 flex items-center justify-center">
                                        <span class="px-4 py-2 bg-white text-black font-bold text-xs uppercase tracking-wider opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-4 group-hover:translate-y-0">
                                            Ver Producto
                                        </span>
                                    </div>
                                </div>
                                <div class="p-4">
                                    <h3 class="font-semibold text-black group-hover:text-accent transition-colors line-clamp-1">
                                        {relProduct.name}
                                    </h3>
                                    <p class="mt-2 font-bold text-black">
                                        {formatPrice(relProduct.price)}
                                    </p>
                                </div>
                            </a>
                        ))}
                    </div>
                </div>
            </section>
        )
    }
    <!-- Scripts -->
    <script>
        // Thumbnail selection
        const mainImage = document.getElementById(
            "main-image",
        ) as HTMLImageElement;
        const thumbnails = document.querySelectorAll("[data-image]");

        thumbnails.forEach((thumb) => {
            thumb.addEventListener("click", () => {
                const newImageSrc = thumb.getAttribute("data-image");

                if (mainImage && newImageSrc) {
                    mainImage.src = newImageSrc;
                    mainImage.removeAttribute("srcset");

                    // Update active state
                    thumbnails.forEach((t) => {
                        t.classList.remove("border-black");
                        t.classList.add("border-transparent");
                    });
                    thumb.classList.remove("border-transparent");
                    thumb.classList.add("border-black");
                }
            });
        });
    </script>
</StoreLayout>
