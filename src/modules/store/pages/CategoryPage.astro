---
/**
 * Category Page - Nike/JD/Adidas Inspired Design
 * Shows products filtered by category
 */
import StoreLayout from "../layouts/StoreLayout.astro";
import { supabase } from "../../auth";
import { formatPrice } from "../../../shared/utils";
import { ROUTES } from "../../../config";
import type { Product, Category } from "../../../shared/types";
import {
    buildCloudinaryUrl,
    buildResponsiveSet,
    extractPublicId,
    isCloudinaryUrl
} from "../../../lib/services/cloudinary-url";

const { slug } = Astro.params;

if (!slug) {
    return Astro.redirect(ROUTES.PRODUCTS);
}

// Get category
const { data: category } = await supabase
    .from("categories")
    .select("*")
    .eq("slug", slug)
    .single();

if (!category) {
    return Astro.redirect(ROUTES.PRODUCTS);
}

// Get filter params
const minPrice = Astro.url.searchParams.get("minPrice");
const maxPrice = Astro.url.searchParams.get("maxPrice");
const selectedSizes = Astro.url.searchParams.getAll("size");

// Get products in this category
const { data: rawProducts } = await supabase
    .from("products")
    .select("*, variants:product_variants(*)")
    .eq("category_id", category.id)
    .order("created_at", { ascending: false });

// Filter products
let products = rawProducts || [];

if (minPrice) {
    products = products.filter((p) => p.price >= Number(minPrice) * 100);
}

if (maxPrice) {
    products = products.filter((p) => p.price <= Number(maxPrice) * 100);
}

if (selectedSizes.length > 0) {
    products = products.filter((p) =>
        p.variants?.some(
            (v: any) => selectedSizes.includes(v.size) && v.stock > 0,
        ),
    );
}

// Get all categories for filter
const { data: categories } = await supabase
    .from("categories")
    .select("*")
    .order("name");

const SIZES = ["XS", "S", "M", "L", "XL", "XXL"];
const hasFilters = minPrice || maxPrice || selectedSizes.length > 0;

const PRODUCT_IMAGE_WIDTH = 700;
const PRODUCT_IMAGE_HEIGHT = 800;

const getOptimizedImage = (imageUrl?: string) => {
    if (!imageUrl) return null;

    const isAbsoluteUrl = imageUrl.startsWith("http://") || imageUrl.startsWith("https://");
    if (isAbsoluteUrl && !isCloudinaryUrl(imageUrl)) {
        return { src: imageUrl, srcset: undefined };
    }

    const publicId = isCloudinaryUrl(imageUrl)
        ? extractPublicId(imageUrl)
        : imageUrl;

    if (!publicId) {
        return { src: imageUrl, srcset: undefined };
    }

    return {
        src: buildCloudinaryUrl(publicId, "product", {
            width: PRODUCT_IMAGE_WIDTH,
            height: PRODUCT_IMAGE_HEIGHT
        }),
        srcset: buildResponsiveSet(publicId, "product")
    };
};
---

<StoreLayout title={`${category.name} | FashionMarket`}>
    <!-- Hero -->
    <section class="bg-black text-white py-16 lg:py-24">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <!-- Breadcrumb -->
            <nav class="flex items-center gap-2 text-sm mb-8">
                <a href={ROUTES.HOME} class="text-slate-500 hover:text-white transition-colors">Inicio</a>
                <span class="text-slate-600">/</span>
                <a href={ROUTES.PRODUCTS} class="text-slate-500 hover:text-white transition-colors">Productos</a>
                <span class="text-slate-600">/</span>
                <span class="text-accent font-medium">{category.name}</span>
            </nav>
            
            <h1 class="font-display text-display-lg lg:text-display-xl uppercase">
                {category.name}
            </h1>
            <p class="mt-4 text-slate-400 max-w-2xl text-lg">
                {category.description || `Explora nuestra coleccion de ${category.name.toLowerCase()}`}
            </p>
        </div>
    </section>

    <!-- Catalog -->
    <div class="bg-slate-50 min-h-screen">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-12">
            <div class="flex flex-col lg:flex-row gap-8">
                <!-- Sidebar Filters -->
                <aside class="lg:w-72 flex-shrink-0">
                    <div class="lg:sticky lg:top-24 space-y-6">
                        <!-- Categories -->
                        <div class="bg-white p-6 border border-slate-200">
                            <h3 class="font-bold text-black uppercase tracking-wider text-sm mb-4">
                                Categorias
                            </h3>
                            <ul class="space-y-2">
                                <li>
                                    <a
                                        href={ROUTES.PRODUCTS}
                                        class="flex items-center gap-3 py-2 text-slate-600 hover:text-black transition-colors group"
                                    >
                                        <span class="w-1.5 h-1.5 bg-slate-300 group-hover:bg-accent rounded-full transition-colors"></span>
                                        Todas
                                    </a>
                                </li>
                                {
                                    categories?.map((cat: Category) => (
                                        <li>
                                            <a
                                                href={ROUTES.CATEGORY(cat.slug)}
                                                class={`flex items-center gap-3 py-2 transition-colors ${
                                                    cat.id === category.id 
                                                        ? "text-black font-medium" 
                                                        : "text-slate-600 hover:text-black"
                                                } group`}
                                            >
                                                <span class={`w-1.5 h-1.5 rounded-full transition-colors ${
                                                    cat.id === category.id 
                                                        ? "bg-accent" 
                                                        : "bg-slate-300 group-hover:bg-accent"
                                                }`}></span>
                                                {cat.name}
                                            </a>
                                        </li>
                                    ))
                                }
                            </ul>
                        </div>

                        <!-- Filters -->
                        <div class="bg-white p-6 border border-slate-200">
                            <h3 class="font-bold text-black uppercase tracking-wider text-sm mb-4">
                                Filtros
                            </h3>
                            <form action={Astro.url.pathname} method="GET">
                                <!-- Price -->
                                <div class="mb-6">
                                    <h4 class="text-sm font-semibold text-black mb-3">
                                        Precio (EUR)
                                    </h4>
                                    <div class="flex items-center gap-2">
                                        <input
                                            type="number"
                                            name="minPrice"
                                            placeholder="Min"
                                            value={minPrice}
                                            class="w-full px-3 py-2.5 bg-slate-50 border border-slate-200 text-sm focus:border-black focus:ring-1 focus:ring-black outline-none transition-all"
                                        />
                                        <span class="text-slate-400">-</span>
                                        <input
                                            type="number"
                                            name="maxPrice"
                                            placeholder="Max"
                                            value={maxPrice}
                                            class="w-full px-3 py-2.5 bg-slate-50 border border-slate-200 text-sm focus:border-black focus:ring-1 focus:ring-black outline-none transition-all"
                                        />
                                    </div>
                                </div>

                                <!-- Sizes -->
                                <div class="mb-6">
                                    <h4 class="text-sm font-semibold text-black mb-3">
                                        Talla
                                    </h4>
                                    <div class="grid grid-cols-3 gap-2">
                                        {
                                            SIZES.map((size) => (
                                                <label class="relative cursor-pointer">
                                                    <input
                                                        type="checkbox"
                                                        name="size"
                                                        value={size}
                                                        checked={selectedSizes.includes(size)}
                                                        class="peer sr-only"
                                                    />
                                                    <span class="flex items-center justify-center py-2 text-sm font-medium border border-slate-200 text-slate-600 peer-checked:border-black peer-checked:bg-black peer-checked:text-white transition-all hover:border-slate-400">
                                                        {size}
                                                    </span>
                                                </label>
                                            ))
                                        }
                                    </div>
                                </div>

                                <button
                                    type="submit"
                                    class="w-full py-3 bg-black hover:bg-accent text-white font-bold text-sm uppercase tracking-wider transition-colors"
                                >
                                    Aplicar Filtros
                                </button>
                                {
                                    hasFilters && (
                                        <a
                                            href={Astro.url.pathname}
                                            class="block text-center mt-3 text-sm text-slate-500 hover:text-black underline"
                                        >
                                            Limpiar filtros
                                        </a>
                                    )
                                }
                            </form>
                        </div>
                    </div>
                </aside>

                <!-- Products Grid -->
                <div class="flex-1">
                    <!-- Header -->
                    <div class="flex items-center justify-between mb-6 pb-4 border-b border-slate-200">
                        <h2 class="font-bold text-xl text-black uppercase tracking-wide">
                            {category.name}
                        </h2>
                        <span class="text-slate-500 text-sm">
                            {products?.length || 0} productos
                        </span>
                    </div>

                    {
                        products && products.length > 0 ? (
                            <div class="grid grid-cols-2 lg:grid-cols-3 gap-4 lg:gap-6">
                                {products.map((product: Product, index: number) => {
                                    const optimizedImage = getOptimizedImage(product.images?.[0]);

                                    return (
                                        <a
                                            href={ROUTES.PRODUCT_DETAIL(product.slug)}
                                            class="group bg-white border border-slate-100 hover:border-black transition-all duration-300"
                                        >
                                            <div class="relative aspect-[3/4] bg-slate-100 overflow-hidden">
                                                {product.images?.[0] ? (
                                                    <img
                                                        src={optimizedImage?.src}
                                                        srcset={optimizedImage?.srcset}
                                                        sizes="(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 25vw"
                                                        alt={product.name}
                                                        width={PRODUCT_IMAGE_WIDTH}
                                                        height={PRODUCT_IMAGE_HEIGHT}
                                                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                                                        loading="lazy"
                                                        decoding="async"
                                                    />
                                                ) : (
                                                    <div class="w-full h-full flex items-center justify-center text-slate-300">
                                                        <svg class="h-16 w-16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                                        </svg>
                                                    </div>
                                                )}
                                                
                                                <!-- Quick View Overlay -->
                                                <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors duration-300 flex items-center justify-center">
                                                    <span class="px-4 py-2 bg-white text-black font-bold text-xs uppercase tracking-wider opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-4 group-hover:translate-y-0">
                                                        Ver Producto
                                                    </span>
                                                </div>

                                                {/* Sale badge for some products */}
                                                {index % 3 === 0 && (
                                                    <span class="absolute top-3 left-3 px-2 py-1 bg-accent text-white text-xs font-bold uppercase">
                                                        -15%
                                                    </span>
                                                )}
                                                
                                                {/* Out of stock */}
                                                {product.stock === 0 && (
                                                    <div class="absolute inset-0 bg-white/80 flex items-center justify-center">
                                                        <span class="px-4 py-2 bg-black text-white text-xs font-bold uppercase">
                                                            Agotado
                                                        </span>
                                                    </div>
                                                )}
                                            </div>
                                            <div class="p-4">
                                                <span class="text-xs text-accent uppercase tracking-wider font-semibold">
                                                    {category.name}
                                                </span>
                                                <h3 class="font-semibold text-black group-hover:text-accent transition-colors line-clamp-1 mt-1">
                                                    {product.name}
                                                </h3>
                                                <div class="mt-2 flex items-center gap-2">
                                                    <span class="font-bold text-black">
                                                        {formatPrice(product.price)}
                                                    </span>
                                                    {index % 3 === 0 && (
                                                        <span class="text-sm text-slate-400 line-through">
                                                            {formatPrice(product.price * 1.18)}
                                                        </span>
                                                    )}
                                                </div>
                                            </div>
                                        </a>
                                    );
                                })}
                            </div>
                        ) : (
                            <div class="text-center py-20 bg-white border border-slate-200">
                                <svg class="mx-auto h-20 w-20 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                                </svg>
                                <h3 class="mt-6 font-display text-2xl text-black">
                                    No hay productos
                                </h3>
                                <p class="mt-2 text-slate-500">
                                    No hay productos en esta categoria todavia.
                                </p>
                                <a
                                    href={ROUTES.PRODUCTS}
                                    class="inline-block mt-6 px-8 py-3 bg-black hover:bg-accent text-white font-bold uppercase tracking-wider transition-colors"
                                >
                                    Ver Todo
                                </a>
                            </div>
                        )
                    }
                </div>
            </div>
        </div>
    </div>
</StoreLayout>
