---
/**
 * Product Catalog Page - Nike/JD/Adidas Inspired Design
 */
import StoreLayout from "../layouts/StoreLayout.astro";
import { supabase } from "../../auth";
import { formatPrice } from "../../../shared/utils";
import { enrichProductsWithDiscounts, type ProductWithDiscount } from "../../../shared/utils/promotions";
import { ROUTES } from "../../../config";
import type { Category } from "../../../shared/types";

// Get filter params
const minPrice = Astro.url.searchParams.get("minPrice");
const maxPrice = Astro.url.searchParams.get("maxPrice");
const selectedSizes = Astro.url.searchParams.getAll("size");

// Get all products
const { data: rawProducts } = await supabase
    .from("products")
    .select("*, variants:product_variants(*)")
    .order("created_at", { ascending: false });

// Filter products
let filteredProducts = rawProducts || [];

if (minPrice) {
    filteredProducts = filteredProducts.filter((p) => p.price >= Number(minPrice) * 100);
}

if (maxPrice) {
    filteredProducts = filteredProducts.filter((p) => p.price <= Number(maxPrice) * 100);
}

if (selectedSizes.length > 0) {
    filteredProducts = filteredProducts.filter((p) =>
        p.variants?.some(
            (v: any) => selectedSizes.includes(v.size) && v.stock > 0,
        ),
    );
}

// Enrich with discount info
const products = await enrichProductsWithDiscounts(filteredProducts);

// Get all categories for filter
const { data: categories } = await supabase
    .from("categories")
    .select("*")
    .order("name");

const SIZES = ["XS", "S", "M", "L", "XL", "XXL"];
const hasFilters = minPrice || maxPrice || selectedSizes.length > 0;
---

<StoreLayout
    title="Catalogo"
    description="Explora nuestra coleccion completa de moda masculina premium"
>
    <!-- Hero -->
    <section class="bg-black text-white py-16 lg:py-24">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <h1 class="font-display text-display-lg lg:text-display-xl uppercase">
                Nuestra <span class="text-accent">Coleccion</span>
            </h1>
            <p class="mt-4 text-slate-400 max-w-2xl mx-auto text-lg">
                Piezas premium para el hombre moderno. Encuentra tu estilo.
            </p>
        </div>
    </section>

    <!-- Catalog -->
    <div class="bg-slate-950 min-h-screen">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-12">
            <div class="flex flex-col lg:flex-row gap-8">
                <!-- Sidebar Filters -->
                <aside class="lg:w-72 flex-shrink-0">
                    <div class="lg:sticky lg:top-24 space-y-6">
                        <!-- Categories -->
                        <div class="bg-slate-900 p-6 border border-slate-800">
                            <h3 class="font-bold text-white uppercase tracking-wider text-sm mb-4">
                                Categorias
                            </h3>
                            <ul class="space-y-2">
                                <li>
                                    <a
                                        href={ROUTES.PRODUCTS}
                                        class="flex items-center gap-3 py-2 text-white font-medium hover:text-accent transition-colors"
                                    >
                                        <span class="w-1.5 h-1.5 bg-accent rounded-full"></span>
                                        Todas
                                    </a>
                                </li>
                                {
                                    categories?.map((cat: Category) => (
                                        <li>
                                            <a
                                                href={ROUTES.CATEGORY(cat.slug)}
                                                class="flex items-center gap-3 py-2 text-slate-400 hover:text-white transition-colors group"
                                            >
                                                <span class="w-1.5 h-1.5 bg-slate-600 group-hover:bg-accent rounded-full transition-colors"></span>
                                                {cat.name}
                                            </a>
                                        </li>
                                    ))
                                }
                            </ul>
                        </div>

                        <!-- Filters -->
                        <div class="bg-slate-900 p-6 border border-slate-800">
                            <h3 class="font-bold text-white uppercase tracking-wider text-sm mb-4">
                                Filtros
                            </h3>
                            <form action={ROUTES.PRODUCTS} method="GET">
                                <!-- Price -->
                                <div class="mb-6">
                                    <h4 class="text-sm font-semibold text-white mb-3">
                                        Precio (EUR)
                                    </h4>
                                    <div class="flex items-center gap-2">
                                        <input
                                            type="number"
                                            name="minPrice"
                                            placeholder="Min"
                                            value={minPrice}
                                            class="w-full px-3 py-2.5 bg-slate-800 border border-slate-700 text-white text-sm focus:border-accent focus:ring-1 focus:ring-accent outline-none transition-all"
                                        />
                                        <span class="text-slate-500">-</span>
                                        <input
                                            type="number"
                                            name="maxPrice"
                                            placeholder="Max"
                                            value={maxPrice}
                                            class="w-full px-3 py-2.5 bg-slate-800 border border-slate-700 text-white text-sm focus:border-accent focus:ring-1 focus:ring-accent outline-none transition-all"
                                        />
                                    </div>
                                </div>

                                <!-- Sizes -->
                                <div class="mb-6">
                                    <h4 class="text-sm font-semibold text-white mb-3">
                                        Talla
                                    </h4>
                                    <div class="grid grid-cols-3 gap-2">
                                        {
                                            SIZES.map((size) => (
                                                <label class="relative cursor-pointer">
                                                    <input
                                                        type="checkbox"
                                                        name="size"
                                                        value={size}
                                                        checked={selectedSizes.includes(size)}
                                                        class="peer sr-only"
                                                    />
                                                    <span class="flex items-center justify-center py-2 text-sm font-medium border border-slate-700 text-slate-400 peer-checked:border-accent peer-checked:bg-accent peer-checked:text-white transition-all hover:border-slate-500">
                                                        {size}
                                                    </span>
                                                </label>
                                            ))
                                        }
                                    </div>
                                </div>

                                <button
                                    type="submit"
                                    class="w-full py-3 bg-black hover:bg-accent text-white font-bold text-sm uppercase tracking-wider transition-colors"
                                >
                                    Aplicar Filtros
                                </button>
                                {
                                    hasFilters && (
                                        <a
                                            href={ROUTES.PRODUCTS}
                                            class="block text-center mt-3 text-sm text-slate-400 hover:text-white underline"
                                        >
                                            Limpiar filtros
                                        </a>
                                    )
                                }
                            </form>
                        </div>
                    </div>
                </aside>

                <!-- Products Grid -->
                <div class="flex-1">
                    <!-- Header -->
                    <div class="flex items-center justify-between mb-6 pb-4 border-b border-slate-800">
                        <h2 class="font-bold text-xl text-white uppercase tracking-wide">
                            Todos los Productos
                        </h2>
                        <span class="text-slate-400 text-sm">
                            {products?.length || 0} productos
                        </span>
                    </div>

                    {
                        products && products.length > 0 ? (
                            <div class="grid grid-cols-2 lg:grid-cols-3 gap-4 lg:gap-6">
                                {products.map((product: ProductWithDiscount) => (
                                    <a
                                        href={ROUTES.PRODUCT_DETAIL(product.slug)}
                                        class="group bg-slate-900 border border-slate-800 hover:border-accent transition-all duration-300"
                                    >
                                        <div class="relative aspect-[3/4] bg-slate-100 overflow-hidden">
                                            {product.images[0] ? (
                                                <img
                                                    src={product.images[0]}
                                                    alt={product.name}
                                                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                                                    loading="lazy"
                                                />
                                            ) : (
                                                <div class="w-full h-full flex items-center justify-center text-slate-300">
                                                    <svg class="h-16 w-16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                                    </svg>
                                                </div>
                                            )}
                                            
                                            <!-- Quick View Overlay -->
                                            <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors duration-300 flex items-center justify-center">
                                                <span class="px-4 py-2 bg-white text-black font-bold text-xs uppercase tracking-wider opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-4 group-hover:translate-y-0">
                                                    Ver Producto
                                                </span>
                                            </div>

                                            {/* Promotion badge */}
                                            {product.discountedPrice && (
                                                <span class="absolute top-3 left-3 px-2 py-1 bg-accent text-white text-xs font-bold uppercase">
                                                    {product.promotionTitle || 'Oferta'}
                                                </span>
                                            )}
                                            
                                            {/* Out of stock */}
                                            {product.stock === 0 && (
                                                <div class="absolute inset-0 bg-black/80 flex items-center justify-center">
                                                    <span class="px-4 py-2 bg-accent text-white text-xs font-bold uppercase">
                                                        Agotado
                                                    </span>
                                                </div>
                                            )}
                                        </div>
                                        <div class="p-4">
                                            <h3 class="font-semibold text-white group-hover:text-accent transition-colors line-clamp-1">
                                                {product.name}
                                            </h3>
                                            <div class="mt-2">
                                                {product.discountedPrice ? (
                                                    <>
                                                        <span class="text-sm text-slate-500 line-through mr-2">
                                                            {formatPrice(product.price)}
                                                        </span>
                                                        <span class="font-bold text-accent">
                                                            {formatPrice(product.discountedPrice)}
                                                        </span>
                                                    </>
                                                ) : (
                                                    <span class="font-bold text-white">
                                                        {formatPrice(product.price)}
                                                    </span>
                                                )}
                                            </div>
                                        </div>
                                    </a>
                                ))}
                            </div>
                        ) : (
                            <div class="text-center py-20">
                                <svg class="mx-auto h-20 w-20 text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                                </svg>
                                <h3 class="mt-6 font-display text-2xl text-white">
                                    No hay productos
                                </h3>
                                <p class="mt-2 text-slate-400">
                                    Intenta ajustar tus filtros o vuelve mas tarde.
                                </p>
                                <a
                                    href={ROUTES.PRODUCTS}
                                    class="inline-block mt-6 px-8 py-3 bg-accent hover:bg-red-700 text-white font-bold uppercase tracking-wider transition-colors"
                                >
                                    Ver Todo
                                </a>
                            </div>
                        )
                    }
                </div>
            </div>
        </div>
    </div>
</StoreLayout>
