---
/**
 * Store Homepage - Dynamic Layout
 */
import StoreLayout from "../layouts/StoreLayout.astro";
import HeroSection from "../components/home/HeroSection.astro";
import OfferBanner from "../components/home/OfferBanner.astro";
import CategoriesGrid from "../components/home/CategoriesGrid.astro";
import FeaturedProducts from "../components/home/FeaturedProducts.astro";
import ValueProps from "../components/home/ValueProps.astro";
import CustomTextSection from "../components/home/CustomTextSection.astro";

// Import supabase to fetch layout config
import { createClient } from "@supabase/supabase-js";

// Initialize Supabase Client (Same logic as API)
const supabaseUrl =
    import.meta.env.PUBLIC_SUPABASE_URL ||
    process.env.PUBLIC_SUPABASE_URL ||
    "";
const supabaseAnonKey =
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY ||
    process.env.PUBLIC_SUPABASE_ANON_KEY ||
    "";
const supabase = createClient(supabaseUrl, supabaseAnonKey);

// Component Mapping Definition
const componentMap = {
    hero: HeroSection,
    offer_banner: OfferBanner,
    categories: CategoriesGrid,
    featured: FeaturedProducts,
    values: ValueProps,
    custom_text: CustomTextSection,
};

// Default layout if DB is empty or fails
const defaultOrder = [
    { key: "hero", component: HeroSection, is_visible: true },
    { key: "offer_banner", component: OfferBanner, is_visible: true },
    { key: "categories", component: CategoriesGrid, is_visible: true },
    { key: "featured", component: FeaturedProducts, is_visible: true },
    { key: "values", component: ValueProps, is_visible: true },
];

let sections = [...defaultOrder];

try {
    const { data: layoutData } = await supabase
        .from("home_sections")
        .select("*")
        .order("order_index", { ascending: true });

    if (layoutData && layoutData.length > 0) {
        // Map DB data to component references
        sections = layoutData
            .filter((item) => item.is_visible)
            .map((item) => {
                const Component =
                    componentMap[item.key as keyof typeof componentMap];
                return Component ? { ...item, component: Component } : null;
            })
            .filter(Boolean) as any[];
    }
} catch (e) {
    console.error("Error loading home layout:", e);
}
---

<StoreLayout
    title="Moda Masculina Premium"
    description="Descubre nuestra coleccion de moda masculina premium"
>
    {
        sections.map((section) => {
            const Component = section.component;
            return <Component {...section} />;
        })
    }
</StoreLayout>
