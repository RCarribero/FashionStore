---
/**
 * Store Homepage Template
 */
import StoreLayout from "../layouts/StoreLayout.astro";
import {
    getHomepageFeatured,
    getCatalogCategories,
} from "../services/catalog.service";
import { formatPrice } from "../../../shared/utils";
import { ROUTES } from "../../../config";

// Fetch data
const { data: featuredProducts } = await getHomepageFeatured(6);
const { data: categories } = await getCatalogCategories();
---

<StoreLayout
    title="Moda Masculina Premium"
    description="Descubre nuestra coleccion de moda masculina premium"
>
    <!-- Hero -->
    <section class="relative bg-navy-950 text-cream-50 overflow-hidden">
        <div
            class="absolute inset-0 bg-gradient-to-br from-navy-900/90 to-navy-950"
        >
        </div>
        <div class="container-wide relative py-24 lg:py-32">
            <div class="max-w-2xl">
                <h1 class="font-display text-display-lg lg:text-display-xl">
                    Elegancia Atemporal
                </h1>
                <p class="mt-6 text-xl text-cream-200">
                    Piezas cuidadosamente seleccionadas para el hombre moderno
                    que valora la calidad y el estilo sofisticado.
                </p>
                <div class="mt-10 flex flex-wrap gap-4">
                    <a href={ROUTES.PRODUCTS} class="btn-primary">
                        Ver Coleccion
                    </a>
                    <a
                        href={ROUTES.CATEGORY("camisas")}
                        class="btn-ghost border-cream-300 text-cream-50 hover:bg-cream-50 hover:text-navy-900"
                    >
                        Explorar Camisas
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Categories -->
    <section class="py-16 lg:py-24 bg-cream-50">
        <div class="container-wide">
            <h2
                class="font-display text-display-md text-center text-navy-900 mb-12"
            >
                Categorias
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                {
                    categories?.map((category) => (
                        <a
                            href={ROUTES.CATEGORY(category.slug)}
                            class="group relative aspect-[4/5] bg-charcoal-100 overflow-hidden"
                        >
                            <div class="absolute inset-0 bg-gradient-to-t from-navy-950/80 to-transparent" />
                            <div class="absolute bottom-0 left-0 right-0 p-6">
                                <h3 class="font-display text-2xl text-cream-50 group-hover:text-leather-300 transition-colors">
                                    {category.name}
                                </h3>
                                <p class="text-cream-300 text-sm mt-2">
                                    Ver productos &rarr;
                                </p>
                            </div>
                        </a>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Featured Products -->
    {
        featuredProducts && featuredProducts.length > 0 && (
            <section class="py-16 lg:py-24">
                <div class="container-wide">
                    <h2 class="font-display text-display-md text-center text-navy-900 mb-12">
                        Productos Destacados
                    </h2>
                    <div class="product-grid">
                        {featuredProducts.map((product) => (
                            <a
                                href={ROUTES.PRODUCT_DETAIL(product.slug)}
                                class="group"
                            >
                                <div class="aspect-[3/4] bg-charcoal-100 overflow-hidden mb-4">
                                    {product.images[0] ? (
                                        <img
                                            src={product.images[0]}
                                            alt={product.name}
                                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                            loading="lazy"
                                        />
                                    ) : (
                                        <div class="w-full h-full flex items-center justify-center text-charcoal-300">
                                            <svg
                                                class="h-12 w-12"
                                                fill="none"
                                                viewBox="0 0 24 24"
                                                stroke="currentColor"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="1"
                                                    d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                                                />
                                            </svg>
                                        </div>
                                    )}
                                </div>
                                <h3 class="font-display text-lg text-navy-900 group-hover:text-leather-600 transition-colors">
                                    {product.name}
                                </h3>
                                <p class="mt-1 font-medium text-navy-900">
                                    {formatPrice(product.price)}
                                </p>
                            </a>
                        ))}
                    </div>
                    <div class="text-center mt-12">
                        <a href={ROUTES.PRODUCTS} class="btn-secondary">
                            Ver todos los productos
                        </a>
                    </div>
                </div>
            </section>
        )
    }

    <!-- Value Props -->
    <section class="py-16 bg-navy-950 text-cream-50">
        <div class="container-wide">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
                <div>
                    <div
                        class="mx-auto w-12 h-12 bg-leather-500/20 rounded-full flex items-center justify-center mb-4"
                    >
                        <svg
                            class="h-6 w-6 text-leather-400"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="1.5"
                                d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8"
                            ></path>
                        </svg>
                    </div>
                    <h3 class="font-display text-lg text-cream-50">
                        Envio Gratuito
                    </h3>
                    <p class="text-cream-400 text-sm mt-2">
                        En pedidos superiores a 100
                    </p>
                </div>
                <div>
                    <div
                        class="mx-auto w-12 h-12 bg-leather-500/20 rounded-full flex items-center justify-center mb-4"
                    >
                        <svg
                            class="h-6 w-6 text-leather-400"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="1.5"
                                d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                            ></path>
                        </svg>
                    </div>
                    <h3 class="font-display text-lg text-cream-50">
                        Devoluciones Faciles
                    </h3>
                    <p class="text-cream-400 text-sm mt-2">
                        30 dias para devoluciones
                    </p>
                </div>
                <div>
                    <div
                        class="mx-auto w-12 h-12 bg-leather-500/20 rounded-full flex items-center justify-center mb-4"
                    >
                        <svg
                            class="h-6 w-6 text-leather-400"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="1.5"
                                d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                            ></path>
                        </svg>
                    </div>
                    <h3 class="font-display text-lg text-cream-50">
                        Pago Seguro
                    </h3>
                    <p class="text-cream-400 text-sm mt-2">
                        Transacciones 100% seguras
                    </p>
                </div>
            </div>
        </div>
    </section>
</StoreLayout>
