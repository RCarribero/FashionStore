---
import { ROUTES } from "../../../../config";
import { getHomepageFeatured } from "../../services/catalog.service";
import { enrichProductsWithDiscounts } from "../../../../shared/utils/promotions";
import { formatPrice } from "../../../../shared/utils";
import {
    buildCloudinaryUrl,
    buildResponsiveSet,
    extractPublicId,
    isCloudinaryUrl
} from "../../../../lib/services/cloudinary-url";

const { data: rawFeaturedProducts } = await getHomepageFeatured(8);
const featuredProducts = await enrichProductsWithDiscounts(rawFeaturedProducts || []);

const PRODUCT_IMAGE_WIDTH = 700;
const PRODUCT_IMAGE_HEIGHT = 800;

const getOptimizedImage = (imageUrl?: string) => {
    if (!imageUrl) return null;

    const isAbsoluteUrl = imageUrl.startsWith("http://") || imageUrl.startsWith("https://");

    if (isAbsoluteUrl && !isCloudinaryUrl(imageUrl)) {
        return {
            src: imageUrl,
            srcset: undefined
        };
    }

    const publicId = isCloudinaryUrl(imageUrl)
        ? extractPublicId(imageUrl)
        : imageUrl;

    if (!publicId) {
        return {
            src: imageUrl,
            srcset: undefined
        };
    }

    return {
        src: buildCloudinaryUrl(publicId, "product", {
            width: PRODUCT_IMAGE_WIDTH,
            height: PRODUCT_IMAGE_HEIGHT
        }),
        srcset: buildResponsiveSet(publicId, "product")
    };
};
---
{
    featuredProducts && featuredProducts.length > 0 && (
        <section class="py-16 lg:py-24 bg-slate-50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <!-- Section Header -->
                <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between mb-12">
                    <div>
                        <h2 class="font-display text-display-md lg:text-display-lg text-black mb-4">
                            DESTACADOS
                        </h2>
                        <p class="text-slate-600 text-lg max-w-xl">
                            Los mas vendidos de la temporada
                        </p>
                    </div>
                    <a 
                        href={ROUTES.PRODUCTS} 
                        class="inline-flex items-center gap-2 mt-6 lg:mt-0 text-black font-semibold uppercase tracking-wider hover:text-accent transition-colors group"
                    >
                        Ver Todo
                        <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
                        </svg>
                    </a>
                </div>

                <!-- Products Grid -->
                <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-6">
                    {featuredProducts.map((product, index) => {
                        const optimizedImage = getOptimizedImage(product.images[0]);

                        return (
                        <a
                            href={ROUTES.PRODUCT_DETAIL(product.slug)}
                            class="group bg-white overflow-hidden"
                        >
                            <!-- Image -->
                            <div class="relative aspect-[3/4] bg-slate-100 overflow-hidden">
                                {product.images[0] ? (
                                    <img
                                        src={product.images[0]}
                                        alt={product.name}
                                        width={PRODUCT_IMAGE_WIDTH}
                                        height={PRODUCT_IMAGE_HEIGHT}
                                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                                        loading="lazy"
                                        decoding="async"
                                    />
                                ) : (
                                    <div class="w-full h-full flex items-center justify-center text-slate-300">
                                        <svg class="h-16 w-16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                        </svg>
                                    </div>
                                )}
                                
                                <!-- Quick View Overlay -->
                                <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors duration-300 flex items-center justify-center">
                                    <span class="px-6 py-3 bg-white text-black font-bold text-sm uppercase tracking-wider opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-4 group-hover:translate-y-0">
                                        Ver Producto
                                    </span>
                                </div>

                                <!-- New Badge -->
                                {index < 2 && (
                                    <span class="absolute top-3 left-3 px-3 py-1 bg-accent text-white text-xs font-bold uppercase tracking-wider">
                                        Nuevo
                                    </span>
                                )}
                            </div>

                            <!-- Info -->
                            <div class="p-4">
                                <h3 class="font-semibold text-black group-hover:text-accent transition-colors duration-200 line-clamp-1">
                                    {product.name}
                                </h3>
                                <div class="mt-2">
                                    {product.discountedPrice ? (
                                        <>
                                            <p class="text-slate-400 line-through text-sm">
                                                {formatPrice(product.price)}
                                            </p>
                                            <p class="font-bold text-lg text-accent">
                                                {formatPrice(product.discountedPrice)}
                                            </p>
                                        </>
                                    ) : (
                                        <p class="font-bold text-lg text-black">
                                            {formatPrice(product.price)}
                                        </p>
                                    )}
                                </div>
                            </div>
                        </a>
                    )})}
                </div>
            </div>
        </section>
    )
}
