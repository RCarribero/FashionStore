---
import { ROUTES } from "../../../../config";
import { getCatalogCategories } from "../../services/catalog.service";
import {
    buildCloudinaryUrl,
    buildResponsiveSet,
    extractPublicId,
    isCloudinaryUrl
} from "../../../../lib/services/cloudinary-url";

const { data: categories } = await getCatalogCategories();

// Fallback images for categories that don't have an image set in DB
const fallbackImages: Record<string, string> = {
    'zapatillas': 'fashionstore/categories/zapatillas',
    'sudaderas': 'fashionstore/categories/sudaderas',
    'pantalones': 'fashionstore/categories/pantalones',
    'camisetas': 'fashionstore/categories/camisetas',
    'chaquetas': 'fashionstore/categories/chaquetas'
};

// Image dimensions by category position
const imageDimensions = {
    large: { width: 1024, height: 800 }, // First category (md:row-span-2)
    small: { width: 1048, height: 800 } // Other categories
};
---
<section class="py-16 lg:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Section Header -->
        <div class="text-center mb-12 lg:mb-16">
            <h2 class="font-display text-display-md lg:text-display-lg text-black mb-4">
                CATEGORIAS
            </h2>
            <p class="text-slate-600 text-lg max-w-2xl mx-auto">
                Explora nuestra seleccion de ropa premium por categoria
            </p>
        </div>

        <!-- Categories Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 lg:gap-6">
            {
                categories?.map((category, index) => {
                    const rawCategoryImage = category.image || fallbackImages[category.slug];
                    const isAbsoluteUrl = rawCategoryImage?.startsWith("http://") || rawCategoryImage?.startsWith("https://");
                    const categoryPublicId = rawCategoryImage
                        ? (isCloudinaryUrl(rawCategoryImage)
                            ? extractPublicId(rawCategoryImage)
                            : (isAbsoluteUrl ? null : rawCategoryImage))
                        : null;
                    const dims = index === 0 ? imageDimensions.large : imageDimensions.small;
                    // Use optimized Cloudinary URL with transformations
                                        const categoryImage = categoryPublicId 
                                            ? buildCloudinaryUrl(categoryPublicId, 'category', { 
                                                width: dims.width, 
                                                height: dims.height 
                                              })
                                            : (isAbsoluteUrl ? rawCategoryImage : null);
                                        const categorySrcSet = categoryPublicId
                                            ? buildResponsiveSet(categoryPublicId, 'category')
                                            : undefined;
                    
                    return (
                        <a
                            href={ROUTES.CATEGORY(category.slug)}
                            class={`group relative overflow-hidden rounded ${index === 0 ? 'md:row-span-2' : ''}`}
                            style={`min-height: ${index === 0 ? '600px' : '290px'}`}
                        >
                            <!-- Background Image with explicit dimensions to prevent CLS -->
                            <div class="absolute inset-0 bg-slate-200">
                                {categoryImage ? (
                                    <img 
                                        src={categoryImage}
                                        srcset={categorySrcSet}
                                        sizes="(max-width: 768px) 100vw, (max-width: 1280px) 50vw, 33vw"
                                        alt={category.name}
                                        width={dims.width}
                                        height={dims.height}
                                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                                        loading="lazy"
                                        decoding="async"
                                    />
                                ) : (
                                    <div class="w-full h-full bg-gradient-to-br from-slate-300 to-slate-400"></div>
                                )}
                                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
                            </div>
                            
                            <!-- Content -->
                            <div class="absolute bottom-0 left-0 right-0 p-6 lg:p-8">
                                <h3 class="font-display text-2xl lg:text-3xl font-bold text-white group-hover:text-accent transition-colors duration-300">
                                    {category.name}
                                </h3>
                                <div class="flex items-center gap-2 mt-3 text-white/80 group-hover:text-white transition-colors">
                                    <span class="text-sm font-medium uppercase tracking-wider">Ver productos</span>
                                    <svg class="w-4 h-4 group-hover:translate-x-2 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
                                    </svg>
                                </div>
                            </div>
                        </a>
                    );
                })
            }
        </div>
    </div>
</section>
