---

---

<section class="py-16 lg:py-20 bg-black text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12">
            <!-- Prop 1 -->
            <div class="text-center group">
                <div
                    class="inline-flex items-center justify-center w-16 h-16 border-2 border-white/30 group-hover:border-accent group-hover:bg-accent/10 transition-all duration-300 mb-6"
                >
                    <svg
                        class="h-8 w-8 text-white group-hover:text-accent transition-colors"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="1.5"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"
                        ></path>
                    </svg>
                </div>
                <h3
                    class="font-display text-xl font-bold uppercase tracking-wider mb-3"
                >
                    Envio Gratis
                </h3>
                <p class="text-slate-400">En pedidos superiores a 100 EUR</p>
            </div>

            <!-- Prop 2 -->
            <div class="text-center group">
                <div
                    class="inline-flex items-center justify-center w-16 h-16 border-2 border-white/30 group-hover:border-accent group-hover:bg-accent/10 transition-all duration-300 mb-6"
                >
                    <svg
                        class="h-8 w-8 text-white group-hover:text-accent transition-colors"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="1.5"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99"
                        ></path>
                    </svg>
                </div>
                <h3
                    class="font-display text-xl font-bold uppercase tracking-wider mb-3"
                >
                    Devoluciones
                </h3>
                <p class="text-slate-400">
                    30 dias para cambios y devoluciones
                </p>
            </div>

            <!-- Prop 3 -->
            <div class="text-center group">
                <div
                    class="inline-flex items-center justify-center w-16 h-16 border-2 border-white/30 group-hover:border-accent group-hover:bg-accent/10 transition-all duration-300 mb-6"
                >
                    <svg
                        class="h-8 w-8 text-white group-hover:text-accent transition-colors"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="1.5"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"
                        ></path>
                    </svg>
                </div>
                <h3
                    class="font-display text-xl font-bold uppercase tracking-wider mb-3"
                >
                    Pago Seguro
                </h3>
                <p class="text-slate-400">
                    Transacciones 100% seguras con Stripe
                </p>
            </div>
        </div>
    </div>
</section>
