---
/**
 * Admin Layout
 * Protected layout for admin pages
 */
import BaseLayout from '../../../shared/layouts/BaseLayout.astro';
import { getSession } from '../../auth';
import { ROUTES, ADMIN_NAV } from '../../../config';

interface Props {
  title: string;
}

const { title } = Astro.props;
const session = await getSession(Astro.request);
const isAuthenticated = !!session;
const currentPath = Astro.url.pathname;
---

<BaseLayout title={`Admin - ${title}`}>
  {!isAuthenticated ? (
    <div class="min-h-screen flex items-center justify-center bg-cream-50">
      <div class="text-center">
        <h1 class="font-display text-2xl text-navy-900 mb-4">Acceso Restringido</h1>
        <p class="text-charcoal-600 mb-6">Debes iniciar sesion para acceder.</p>
        <a href={ROUTES.AUTH.LOGIN} class="btn-primary">Iniciar Sesion</a>
      </div>
    </div>
  ) : (
    <div class="min-h-screen flex bg-charcoal-50">
      
      <!-- Sidebar -->
      <aside class="w-64 bg-navy-950 text-cream-100 flex flex-col">
        <div class="p-6 border-b border-navy-800">
          <a href={ROUTES.ADMIN.DASHBOARD} class="font-display text-xl text-cream-50">
            Fashion<span class="text-leather-400">Market</span>
          </a>
          <p class="text-xs text-cream-400 mt-1">Panel de Administracion</p>
        </div>
        
        <nav class="flex-1 p-4">
          <ul class="space-y-1">
            {ADMIN_NAV.map((item) => {
              const isActive = currentPath === item.href || 
                (item.href !== ROUTES.ADMIN.DASHBOARD && currentPath.startsWith(item.href));
              
              return (
                <li>
                  <a 
                    href={item.href}
                    class:list={[
                      'flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium transition-colors',
                      isActive ? 'bg-navy-800 text-cream-50' : 'text-cream-300 hover:bg-navy-800/50'
                    ]}
                  >
                    {item.icon === 'home' && (
                      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                      </svg>
                    )}
                    {item.icon === 'box' && (
                      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                      </svg>
                    )}
                    {item.icon === 'folder' && (
                      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
                      </svg>
                    )}
                    {item.icon === 'shopping-bag' && (
                      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                      </svg>
                    )}
                    {item.name}
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>
        
        <div class="p-4 border-t border-navy-800">
          <div class="flex items-center gap-3 px-4 py-3">
            <div class="h-8 w-8 bg-leather-500 rounded-full flex items-center justify-center text-cream-50 text-sm font-medium">
              {session?.user?.email?.charAt(0).toUpperCase() || 'A'}
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm text-cream-50 truncate">{session?.user?.email}</p>
            </div>
          </div>
          <form action={ROUTES.API.AUTH.LOGOUT} method="POST" class="mt-2">
            <button type="submit" class="w-full px-4 py-2 text-sm text-cream-300 hover:text-cream-50 hover:bg-navy-800/50 rounded-lg transition-colors text-left">
              Cerrar sesion
            </button>
          </form>
        </div>
      </aside>
      
      <!-- Main -->
      <div class="flex-1 flex flex-col">
        <header class="h-16 bg-white border-b border-charcoal-100 flex items-center px-6">
          <h1 class="font-display text-xl text-navy-900">{title}</h1>
        </header>
        <main class="flex-1 p-6 overflow-auto">
          <slot />
        </main>
      </div>
    </div>
  )}
</BaseLayout>
